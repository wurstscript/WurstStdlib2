package AngleTests


@Test function testAngle()
	(180 .fromDeg().radians).assertEquals(180 .fromDeg().degrees().fromDeg().radians)

	(180 .fromDeg() + 90 .fromDeg()).degrees().assertEquals(270)

	(0 .fromDeg()).sin().assertEquals(0)
	(90 .fromDeg()).sin().assertEquals(1)


@Test function testFromRadIsRadians()
	let halfTurn = 3.141592654
	halfTurn.fromRad().degrees().assertEquals(180., 0.001)
	let three = 3
	three.fromRad().radians().assertEquals(3., 0.0001)


@Test function testAngleOperators()
	(90 .fromDeg() - 30 .fromDeg()).degrees().assertEquals(60., 0.001)
	(90 .fromDeg() * 2.).degrees().assertEquals(180., 0.001)
	(2. * 90 .fromDeg()).degrees().assertEquals(180., 0.001)
	(90 .fromDeg() / 3.).degrees().assertEquals(30., 0.001)
	(180 .asAngleDegrees()).radians().assertEquals(3.14159, 0.0001)
	(0 .fromDeg()).cos().assertEquals(1., 0.001)
	(45 .fromDeg()).tan().assertEquals(1., 0.001)
	(1.5).asAngleRadians().radians().assertEquals(1.5, 0.0001)
