		addTooltipProperty("Swarm Unit Type", lc)

	function presetUnitReleaseIntervalseconds(RealLevelClosure lc)
		def.setLevelsDataUnreal("Uls2", lvls, 2, lc)
		addTooltipProperty("Unit Release Interval (seconds)", lc)

	function presetMaxSwarmUnitsPerTarget(IntLevelClosure lc)
		def.setLevelsDataInt("Uls3", lvls, 3, lc)
		addTooltipProperty("Max Swarm Units Per Target", lc)

	function presetDamageReturnThreshold(RealLevelClosure lc)
		def.setLevelsDataUnreal("Uls5", lvls, 5, lc)
		addTooltipProperty("Damage Return Threshold", lc)


