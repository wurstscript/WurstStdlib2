	construct(int newAbilityId)
		super(newAbilityId, AbilityIds.itemGravelightSideSwarm)

	function setNumberofSwarmUnits(int level, int value)
		def.setLvlDataInt("Uls1", level, 1, value)

	function setDamageReturnFactor(int level, real value)
		def.setLvlDataUnreal("Uls4", level, 4, value)

	function setSwarmUnitType(int level, string value)
		def.setLvlDataString("Ulsu", level, 0, value)

	function setUnitReleaseIntervalseconds(int level, real value)
		def.setLvlDataUnreal("Uls2", level, 2, value)

	function setMaxSwarmUnitsPerTarget(int level, int value)
		def.setLvlDataInt("Uls3", level, 3, value)

	function setDamageReturnThreshold(int level, real value)
		def.setLvlDataUnreal("Uls5", level, 5, value)

	function presetNumberofSwarmUnits(IntLevelClosure lc)
		def.setLevelsDataInt("Uls1", lvls, 1, lc)
		addTooltipProperty("Number of Swarm Units", lc)

	function presetDamageReturnFactor(RealLevelClosure lc)
		def.setLevelsDataUnreal("Uls4", lvls, 4, lc)
		addTooltipProperty("Damage Return Factor", lc)

