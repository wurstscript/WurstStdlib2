		def.setLevelsDataBoolean("Idg2", lvls, 3, lc)
		addTooltipProperty("Affects Initial Target", lc)

	function presetHitPointsGained(IntLevelClosure lc)
		def.setLevelsDataInt("Ihpg", lvls, 1, lc)
		addTooltipProperty("Hit Points Gained", lc)

	function setTargetsAllowedforHeal(int level, string value)
		def.setLvlDataString("Idg3", level, 8, value)

	function setRequiresUndeadTarget(int level, bool value)
