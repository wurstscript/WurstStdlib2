package DummyRecycler
import NoWurst
import public Unit
import public Timer
import Basics
import ErrorHandling
import MapBounds
import AbilityObjEditing
import ObjectIds
import Colors
import Annotations
import UnitIds
import Icons
import ObjectIdGenerator
import LinkedList
import HashSet
import ClosureTimers
import Widget
import Execute

/** Id of the dummy unit */
public constant DUMMY_UNIT_ID = compiletime(UNIT_ID_GEN.next())

/** Id of the root ability
it makes unit:
1. not need to turn when spell or attack
2. can't move or turn by order like a building
3. but you can still set it's postion with code
4. the effect remains even if this ability is removed
*/
public constant ROOT_ENABLER = compiletime(ABIL_ID_GEN.next())

public constant DISABLE_AUTO_ACQUIRE_ATTACK_TARGETS_ABILITY_ID = compiletime(ABIL_ID_GEN.next())

/** Most dummies the pool keeps parked. A recycle beyond it removes the dummy, and a `get` from an empty pool
	creates one, so set it above the most dummies a map has out at once. */
@configurable public constant DUMMY_RECYCLER_CAPACITY = 128
/** Dummies created at init. The pool grows from there up to the capacity as dummies come back. */
@configurable public constant DUMMY_RECYCLER_PRELOAD = 48

/** Called only when a damaged pool entry is discarded. Consumers may add replay diagnostics here.
	`checkout` distinguishes an invalid queued entry from a dead unit returned by its borrower. */
@configurable public function onDummyRecyclerDiscard(unit _discarded, boolean checkout)
	Log.warn("DummyRecycler: discarded an invalid dummy during " + (checkout ? "checkout" : "recycle"))

function isUsableDummy(unit u) returns boolean
	return u != null and u.getTypeId() == DUMMY_UNIT_ID and u.isAliveTrick()

function discardInvalidDummy(unit u, boolean checkout)
	let reported = try() ->
		onDummyRecyclerDiscard(u, checkout)
	if not reported
		Log.warn("DummyRecycler: discard diagnostic failed; continuing recovery")
	// A foreign unit was never ours to remove. Removed handles and null entries need no cleanup.
	if u != null and u.getTypeId() == DUMMY_UNIT_ID
		u.remove()

/** One pool of parked dummies. `get` snaps the facing with BlzSetUnitFacingEx, so any parked dummy serves any
	angle: the pool used to keep one queue per eighth of a circle and hand out only from the queue nearest the
	requested angle, which left the others idle and made every caller asking for the same angle create units. */
public class DummyRecycler
	static LinkedList<unit> pool
	static HashSet<unit> parked

	static function get(vec2 pos, angle a) returns unit
		while not pool.isEmpty()
			let dummy = pool.dequeue()
			parked.remove(dummy)
			if isUsableDummy(dummy)
				dummy..setXY(pos)..unpause()
				dummy.setFacingEx(a.degrees())
				return dummy
			discardInvalidDummy(dummy, true)
		return createDummy(pos, a)

	/** Whether the unit is parked, that is whether it was recycled and not handed out since. */
	static function isRecycled(unit u) returns bool
		return parked.has(u)

	/** Dummies parked now. */
	static function parkedCount() returns int
		return pool.size()

	/** Returns a dummy to the pool, or removes it when the pool is full.
		A dummy which is recycled again before it was handed out is ignored: it would be handed out twice. */
	static function recycle(unit u)
		if u == null or u.getTypeId() == 0
			// Removed already, for example by a first recycle which found the pool full.
			return
		if not isUsableDummy(u)
			discardInvalidDummy(u, false)
			return
		if isRecycled(u)
			Log.warn("DummyRecycler: ignoring an attempt to recycle a dummy which is already recycled")
			return
		if pool.size() >= DUMMY_RECYCLER_CAPACITY
			u.remove()
		else
			park(u)

	static function recycle(unit u, real delay)
		doAfter(delay) ->
			DummyRecycler.recycle(u)

	private static function park(unit u)
		pool.enqueue(u)
		parked.add(u)
		u..setXY(boundMax - vec2(16, 16))
		..pause()
		..setFlyHeight(u.getDefaultFlyHeight(), 0)
		..setScale(1)
		..setVertexColor(COLOR_WHITE)
		..setOwner(DUMMY_PLAYER, true)

	/** Fresh, empty pool. Init calls it; the test runner, which skips init, calls it per test. */
	static function reset()
		pool = new LinkedList<unit>()
		parked = new HashSet<unit>()

function createDummy(vec2 pos, angle facing) returns unit
	let u = createUnit(DUMMY_PLAYER, DUMMY_UNIT_ID, pos, facing)
	u..addAbility(HEIGHT_ENABLER)..removeAbility(HEIGHT_ENABLER)
	..addAbility(ROOT_ENABLER)..removeAbility(ROOT_ENABLER)
	..setXY(pos)
	// createUnit already faced it; the snap in `get` is for parked dummies.
	return u


init
	realToIndex(1)
	DummyRecycler.reset()
	for i = 1 to (DUMMY_RECYCLER_PRELOAD < DUMMY_RECYCLER_CAPACITY ? DUMMY_RECYCLER_PRELOAD : DUMMY_RECYCLER_CAPACITY)
		let dummy = createDummy(boundMax - vec2(16, 16), angle(0))
		DummyRecycler.pool.enqueue(dummy)
		DummyRecycler.parked.add(dummy)

@compiletime function generateDummyUnit()
	new AbilityDefinitionRootAncients(ROOT_ENABLER)

	new AbilityDefinitionPermanentInvisibility(DISABLE_AUTO_ACQUIRE_ATTACK_TARGETS_ABILITY_ID)
	..presetAutoAcquireAttackTargets(_ -> false)
	..presetDurationNormal(_ -> -1)
	..presetDurationHero(_ -> -1)

	new UnitDefinition(DUMMY_UNIT_ID, UnitIds.wisp)
	..setName("Effect Dummy Unit")
	..setUpgradesUsed("")
	..setStructuresBuilt("")
	..setManaRegeneration(0.1)
	..setManaInitialAmount(1000)
	..setManaMaximum(1000)
	..setCollisionSize(0.0)
	..setRace(Race.Commoner)
	..setFoodCost(0)
	..setArmorType(ArmorType.Divine)
	..setIconGameInterface(Icons.bTNTemp)
	..setSpeedBase(522)
	..setModelFile("dummy.mdl")
	..setAnimationBlendTimeseconds(0.0)
	..setAnimationCastBackswing(0.0)
	..setMaximumPitchAngledegrees(0.0)
	..setMaximumRollAngledegrees(0.0)
	..setArtSpecial("")
	..setProjectileImpactZ(0.0)
	..setProjectileLaunchZ(0.0)
	..setNameEditorSuffix("(Basics)")
	..setSightRadiusDay(1)
	..setSightRadiusNight(1)
	..setUnitClassification("_")
	..setPropulsionWindowdegrees(1.0)
	..setTooltipBasic("")
	..setAttacksEnabled(AttacksEnabled.AttackOneOnly.toObjectInt())
	..setAttack1AnimationBackswingPoint(0)
	..setAttack1AnimationDamagePoint(0)
	..setAttack1CooldownTime(0)
	..setAttack1AttackType(AttackType.Unknown)
	..setAttack1DamageBase(-1)
	..setAttack1DamageNumberofDice(1)
	..setAttack1DamageSidesperDie(1)
	..setAttack1ProjectileSpeed(INT_MAX)
	..setAttack1Range(INT_MAX)
	..setAttack1TargetsAllowed(
		commaList(TargetsAllowed.air, TargetsAllowed.debris, TargetsAllowed.ground, TargetsAllowed.invulnerable,
			TargetsAllowed.item_t, TargetsAllowed.structure, TargetsAllowed.vulnerable, TargetsAllowed.ward))
	..setAttack1WeaponSound(WeaponSound.Nothing)
	..setAttack1WeaponType(WeaponType.Instant)
	..setAcquisitionRange(INT_MAX.toReal())
	..setNormalAbilities(
		commaList(AbilityIds.invulnerable, AbilityIds.locust, DISABLE_AUTO_ACQUIRE_ATTACK_TARGETS_ABILITY_ID))

