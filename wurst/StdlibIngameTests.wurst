package StdlibIngameTests
import DamageEvent
import ClosureTimers
import ClosureForGroups
import TimerUtils
import UnitIds
import Execute
import ErrorHandling
import UnitSpatialIndex
import SpatialIndexForUnits
import ArrayList
import UnitIndexer
import OnUnitEnterLeave
import ChannelAbilityPreset
import ClosureEvents
import HashMap
import RegisterEvents

/*	Manual, in-game checks for behaviour the compiletime interpreter cannot
	reach: real damage events, real timers and real unit enumeration.

	This package is deliberately NOT a
	@Test suite - `grill test` runs in the interpreter, where none of these
	events exist.

	HOW TO RUN
	==========
	Importing the package is enough:

	>	import StdlibIngameTests

	The suite starts one second into the game and prints its results. Type
	-stdlibtest to run it again, or call runStdlibIngameTests() yourself from a
	timer callback - not straight from init, since it creates units.

	Results print as PASS / FAIL / INFO lines, followed by a summary. The whole
	run takes about four seconds because the TimedLoop and event checks wait for ticks and casts.

	Each check runs inside try(), so one crashing check reports CRASH and the
	rest still run.

	WHAT QUESTION THIS ANSWERS
	==========================
	DamageEvent assumes that a DAMAGING which ends with amount <= 0 is never
	followed by a DAMAGED, and closes the damage instance out early on that
	basis.

	Check 1 *observes* whether DAMAGED fires and prints the answer as an INFO
	line - it cannot fail, because either answer is a legitimate engine
	behaviour.

	Check 10 is the one that decides whether the assumption is safe. Top level
	hits are harmless either way, since the early close leaves nothing behind
	for onDamage to consume. Only a nested zeroed hit can consume the enclosing
	instance, so check 10 is the one that must pass.
*/

// ============================================================================
// Reporting
// ============================================================================

/**	Whether importing this package starts the suite one second into the game.
	A harness which runs the suite itself, through runStdlibIngameTests with a
	completion callback, turns this off in a config package. */
@configurable public constant STDLIB_INGAME_TESTS_AUTORUN = true

/** Told once, when the summary is out. */
public interface StdlibIngameTestsDone
	function onDone(int checksRun, int checksFailed)

var checksRun = 0
var checksFailed = 0

/*	Runs never overlap. The suite shares its counters, its report and the
	fixed positions of its test units, and some checks land on a timer, so a
	second run started inside the first would mix both runs' results and units.
	A request made while a run is in flight is queued and starts as soon as
	that run has summarised. */
var runInFlight = false
var rerunQueued = false
/** Told the totals of the run in flight. */
let runCallbacks = new ArrayList<StdlibIngameTestsDone>()
/** Told the totals of the queued run. */
let queuedCallbacks = new ArrayList<StdlibIngameTestsDone>()

/** Every reported line, so the run can also be read back from disk (see writeReport). */
let reportLines = new ArrayList<string>()

/**	The lines of the last run, colour codes included: PASS/FAIL/INFO/CRASH
	prefixed check lines, section headers and the summary. Owned by this
	package; do not destroy. */
public function stdlibIngameReport() returns ArrayList<string>
	return reportLines

function report(string line)
	print(line)
	reportLines.add(line)

/**	Writes the report to CustomMapData/WurstStdlibIngameTests.txt on each
	client, one Preload line per reported line, so an automated run can read
	the outcome without a screen. Every client writes the same lines, so this
	is not a sync hazard; the file is never read back by the map. */
function writeReport()
	PreloadGenClear()
	PreloadGenStart()
	for i = 0 to reportLines.size() - 1
		Preload(reportLines.get(i))
	PreloadGenEnd("WurstStdlibIngameTests.txt")

function check(bool passed, string label)
	checksRun++
	if passed
		report("|cff44ff44PASS|r  " + label)
	else
		checksFailed++
		report("|cffff4444FAIL|r  " + label)

function note(string label)
	report("|cffffcc00INFO|r  " + label)

function section(string label)
	report("|cff8888ff" + label + "|r")

/**	Runs one test in an isolated thread. Without this a single crashing check
	kills the whole run, and everything after it silently never happens. */
function runGuarded(string label, ForForceCallback cb)
	if not try(cb)
		checksRun++
		checksFailed++
		report("|cffff4444CRASH|r " + label + " -> " + (lastError == "" ? "thread crashed" : lastError))

// ============================================================================
// Test units
// ============================================================================

constant TEST_POS = vec2(0, 0)
constant GROUP_TEST_POS = vec2(2000, 2000)

unit attacker = null
unit victim = null
/** Target for nested damage, so check 10 never re-enters the same widget. */
unit victim2 = null

function setupUnits()
	attacker = createUnit(players[0], UnitIds.footman, TEST_POS, angle(0))
	victim = createUnit(players[0], UnitIds.footman, TEST_POS.add(150., 0.), angle(0))
	victim..setMaxHP(1000000)..setHP(1000000.)
	victim2 = createUnit(players[0], UnitIds.footman, TEST_POS.add(300., 0.), angle(0))
	victim2..setMaxHP(1000000)..setHP(1000000.)

function teardownUnits()
	// null tolerant: setupUnits may itself have been the thing that crashed
	attacker?.remove()
	attacker = null
	victim?.remove()
	victim = null
	victim2?.remove()
	victim2 = null

/**	Heals the victim, then deals `amount` as CODE damage.
	Ordinary physical damage rather than the DAMAGE_TYPE_UNIVERSAL default of
	the short damageTarget overload, so armour applies and the reduced amount
	really does differ from the unreduced one. */
function dealDamage(real amount)
	victim.setHP(victim.getMaxHP())
	DamageEvent.setNextDamageFromCode()
	attacker.damageTarget(victim, amount, false, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL,
		WEAPON_TYPE_WHOKNOWS)

// ============================================================================
// 1. Does DAMAGED fire after a DAMAGING that ended at zero?
// ============================================================================

var unreducedFired = false
var reducedFired = false
var observedAmount = 0.

function testZeroedDamaging()
	section("--- 1. DAMAGED after a zeroed DAMAGING (the load bearing one) ---")
	unreducedFired = false
	reducedFired = false

	let ul = DamageEvent.addUnreducedListener() ->
		unreducedFired = true
		DamageEvent.setAmount(0.)

	let rl = DamageEvent.addListener() ->
		reducedFired = true

	dealDamage(50.)

	check(unreducedFired, "unreduced listener fired")
	// DamageEvent keeps a zeroed instance on its stack until the DAMAGED that follows reclaims it, so
	// this is the engine behaviour the package depends on, not only a report of it.
	check(reducedFired, "DAMAGED fires after a zeroed DAMAGING")

	destroy ul
	destroy rl

// ============================================================================
// 2. A zeroed hit must not poison later damage instances
// ============================================================================

function testZeroDoesNotPoisonNextInstance()
	section("--- 2. a zeroed hit must not poison later damage ---")

	let ul = DamageEvent.addUnreducedListener() ->
		DamageEvent.setAmount(0.)
	dealDamage(50.)
	destroy ul

	reducedFired = false
	observedAmount = 0.
	let rl = DamageEvent.addListener() ->
		reducedFired = true
		observedAmount = DamageEvent.getAmount()
	dealDamage(40.)

	check(reducedFired, "later damage still reaches reduced listeners")
	check(observedAmount > 0., "later damage is not nulled (amount " + observedAmount.toString(1) + ")")
	check(not DamageEvent.isFiring(), "no damage instance left on the stack")

	destroy rl

// ============================================================================
// 3. abortCurrent() in an unreduced listener must not poison later damage
// ============================================================================

function testAbortInUnreducedListener()
	section("--- 3. abortCurrent() in an unreduced listener ---")

	let ul = DamageEvent.addUnreducedListener() ->
		DamageEvent.abortCurrent()
	dealDamage(50.)
	destroy ul

	reducedFired = false
	observedAmount = 0.
	let rl = DamageEvent.addListener() ->
		reducedFired = true
		observedAmount = DamageEvent.getAmount()
	dealDamage(40.)

	check(reducedFired, "damage after an abort still fires listeners")
	check(observedAmount > 0., "damage after an abort is not nulled (amount " + observedAmount.toString(1) + ")")
	check(not DamageEvent.isFiring(), "no damage instance left on the stack")

	destroy rl

// ============================================================================
// 4. Same priority listeners fire in registration order (FIFO)
// ============================================================================

var order = ""

function testListenerOrder()
	section("--- 4. same priority listeners fire FIFO ---")
	order = ""

	let a = DamageEvent.addListener(3) ->
		order += "A"
	let b = DamageEvent.addListener(3) ->
		order += "B"
	let c = DamageEvent.addListener(3) ->
		order += "C"

	dealDamage(30.)

	check(order == "ABC", "registration order preserved (expected ABC, got " + order + ")")

	destroy a
	destroy b
	destroy c

// ============================================================================
// 5. A listener that destroys the NEXT listener mid-event
// ============================================================================

DamageListener victimListener = null
var firedFirst = false
var firedVictim = false
var firedThird = false

function testDestroyNextListener()
	section("--- 5. a listener destroying the NEXT listener mid-event ---")
	firedFirst = false
	firedVictim = false
	firedThird = false

	let first = DamageEvent.addListener(4) ->
		firedFirst = true
		if victimListener != null
			destroy victimListener
			victimListener = null

	victimListener = DamageEvent.addListener(4) ->
		firedVictim = true

	let third = DamageEvent.addListener(4) ->
		firedThird = true

	dealDamage(30.)

	check(firedFirst, "first listener fired")
	check(not firedVictim, "the destroyed listener did not fire")
	check(firedThird, "traversal continued past the destroyed listener")

	destroy first
	destroy third
	if victimListener != null
		destroy victimListener
		victimListener = null

// ============================================================================
// 6. A listener that destroys itself mid-event
// ============================================================================

DamageListener selfDestroyer = null
var firedSelf = false
var firedAfterSelf = false

function testSelfDestroyingListener()
	section("--- 6. a listener destroying itself mid-event ---")
	firedSelf = false
	firedAfterSelf = false

	selfDestroyer = DamageEvent.addListener(5) ->
		firedSelf = true
		if selfDestroyer != null
			destroy selfDestroyer
			selfDestroyer = null

	let after = DamageEvent.addListener(5) ->
		firedAfterSelf = true

	dealDamage(30.)

	check(firedSelf, "self destroying listener fired")
	check(firedAfterSelf, "traversal continued after it destroyed itself")

	destroy after
	if selfDestroyer != null
		destroy selfDestroyer
		selfDestroyer = null

// ============================================================================
// 10. A zeroed NESTED hit must not consume the enclosing damage instance
// ============================================================================

/*	The check that decides whether a zeroed hit may be closed out early.
	Checks 1-3 are all top level hits, where an early close leaves
	DamageInstance.current == null and onDamage bails out safely whichever way
	the engine behaves - so they cannot tell the two worlds apart.

	Nesting can:

	  early close is safe   - no DAMAGED for the zeroed inner hit.
	  early close corrupts  - DAMAGED fires for the inner hit, finds the
	                          *enclosing* instance as current, and consumes it
	                          with the inner event's damage of 0. The outer hit
	                          then reports 0 to its own reduced listeners.

	Measured in game: DAMAGED *does* fire for a zeroed hit, so there is no
	early close any more and the outer hit must keep its own amount.

	Listeners filter on the target unit rather than call order, so the result
	does not depend on which DAMAGED arrives first. */

var damageDepth = 0
var innerZeroed = false
var outerReducedFired = false
var outerAmount = 0.
var innerReducedFired = false
var reducedCalls = 0

function testNestedZeroedDamage()
	section("--- 10. a zeroed NESTED hit must not consume the outer instance ---")
	damageDepth = 0
	innerZeroed = false
	outerReducedFired = false
	outerAmount = 0.
	innerReducedFired = false
	reducedCalls = 0

	let ul = DamageEvent.addUnreducedListener() ->
		damageDepth++
		if damageDepth == 1
			// outer hit: deal a nested hit from inside this listener
			DamageEvent.setNextDamageFromCode()
			attacker.damageTarget(victim2, 20., false, false, ATTACK_TYPE_CHAOS, DAMAGE_TYPE_NORMAL,
				WEAPON_TYPE_WHOKNOWS)
		else
			// inner hit: zero it
			innerZeroed = true
			DamageEvent.setAmount(0.)
		damageDepth--

	let rl = DamageEvent.addListener() ->
		reducedCalls++
		if DamageEvent.getTarget() == victim
			outerReducedFired = true
			outerAmount = DamageEvent.getAmount()
		else if DamageEvent.getTarget() == victim2
			innerReducedFired = true

	dealDamage(60.)

	check(innerZeroed, "the nested hit reached the unreduced listeners")
	check(outerReducedFired, "the outer hit reached its own reduced listeners")
	check(outerAmount > 1., "the outer hit kept its own amount (" + outerAmount.toString(1) + ")")
	check(not DamageEvent.isFiring(), "no damage instance left on the stack")

	// The package header promises this: a zeroed hit still runs the reduced listeners, at zero.
	check(innerReducedFired and reducedCalls == 2, "the zeroed nested hit reached the reduced listeners too ("
		+ reducedCalls + " reduced calls)")

	destroy ul
	destroy rl

// ============================================================================
// 11. A late default listener must remain at the default priority
// ============================================================================

var lateDefaultReducedAmount = -1.

function testLateDefaultReducedListenerPriority()
	section("--- 11. late default reduced listener stays before priority 100 ---")
	lateDefaultReducedAmount = -1.

	// Register the observer first: production systems commonly initialize a
	// final observer before gameplay installs short-lived modifiers.
	let observer = DamageEvent.addListener(100) ->
		lateDefaultReducedAmount = DamageEvent.getAmount()
	let modifier = DamageEvent.addListener() ->
		// Expected: no-priority means priority 0, so this changes 100 to 40
		// before the already-registered priority-100 observer runs.
		DamageEvent.setAmount(40.)

	DamageEvent.setNextDamageFromCode()
	attacker.damageTarget(victim, 100.)

	check(lateDefaultReducedAmount == 40., "late default reduced listener: expected 40.0, actual "
		+ lateDefaultReducedAmount.toString(1))

	destroy observer
	destroy modifier

// ============================================================================
// 12. The same default-priority contract applies before native reduction
// ============================================================================

var lateDefaultUnreducedAmount = -1.

function testLateDefaultUnreducedListenerPriority()
	section("--- 12. late default unreduced listener stays before priority 100 ---")
	lateDefaultUnreducedAmount = -1.

	let observer = DamageEvent.addUnreducedListener(100) ->
		lateDefaultUnreducedAmount = DamageEvent.getAmount()
	let modifier = DamageEvent.addUnreducedListener() ->
		// Expected: the default-priority modifier runs first and the explicit
		// priority-100 observer reads its live value of 40 rather than 100.
		DamageEvent.setAmount(40.)

	DamageEvent.setNextDamageFromCode()
	attacker.damageTarget(victim, 100.)

	check(lateDefaultUnreducedAmount == 40., "late default unreduced listener: expected 40.0, actual "
		+ lateDefaultUnreducedAmount.toString(1))

	destroy observer
	destroy modifier

// ============================================================================
// 7. Nested group enumeration
// ============================================================================

var outerCount = 0
var innerCalls = 0

function testGroupNesting()
	section("--- 7. a group enumeration nested inside another ---")

	unit array probes
	for i = 0 to 3
		probes[i] = createUnit(players[0], UnitIds.footman, GROUP_TEST_POS.add(i * 64., 0.), angle(0))

	outerCount = 0
	innerCalls = 0

	// the collision filtering path and forNearestUnit both used to iterate the
	// engine wide ENUM_GROUP, so the inner call clobbered the outer one
	forUnitsInRange(GROUP_TEST_POS.add(96., 0.), 400., true) (unit u) ->
		outerCount++
		forNearestUnit(u.getPos(), 300., null) (unit nearest) ->
			if nearest != null
				innerCalls++

	check(outerCount >= 4, "outer enumeration visited every unit (" + outerCount + ")")
	check(innerCalls == outerCount, "nested enumeration ran exactly once per outer unit ("
		+ innerCalls + " vs " + outerCount + ")")

	for i = 0 to 3
		probes[i].remove()

// ============================================================================
// 13 + 14. UnitSpatialIndex
// ============================================================================

/*	These are differential tests: they never assert a hand-written expected set, they assert that the
	closure result equals what the engine enumeration returns for the same query. That is the only
	claim that matters for membership parity, and it means the awkward
	cases (hidden, locust, corpses, boundary distances) need no engine behaviour to be hardcoded.

	These checks are Lua-index checks only. On Jass or with the index disabled, the native-less API
	leaves the provided result empty by contract, so there is no meaningful parity assertion to run. */

constant SPATIAL_TEST_POS = vec2(-2000, 2000)
unit spatialInitProbe = null
var creatingSpatialInitProbe = false
var spatialInitProbeEnterEvents = 0
let spatialResultScratch = new ArrayList<unit>(64)
let spatialOuterScratch = new ArrayList<unit>(64)
let spatialMiddleScratch = new ArrayList<unit>(64)
let spatialInnerScratch = new ArrayList<unit>(64)
constant UnitSpatialFilter spatialPlayerZeroFilter = u -> u.getOwner() == players[0]

function countSpatialInitProbeEnter()
	if creatingSpatialInitProbe or getEnterLeaveUnit() == spatialInitProbe
		spatialInitProbeEnterEvents++

function collectViaSpatialIndex(vec2 pos, real radius, bool collisionFiltering, group into)
	unitsInRange(spatialResultScratch, pos, radius, collisionFiltering)
	for i = 0 to spatialResultScratch.size() - 1
		into.add(spatialResultScratch.get(i))

function collectNative(vec2 pos, real radius, bool collisionFiltering, group into)
	if collisionFiltering
		let raw = CreateGroup()
		GroupEnumUnitsInRange(raw, pos.x, pos.y, radius + MAX_COLLISION_SIZE, null)
		for u from raw
			if IsUnitInRangeXY(u, pos.x, pos.y, radius)
				into.add(u)
		raw.destr()
	else
		GroupEnumUnitsInRange(into, pos.x, pos.y, radius, null)

function describeDifference(group actual, group expected) returns string
	var missing = 0
	var extra = 0
	for i = 0 to expected.size() - 1
		if not actual.has(expected.get(i))
			missing++
	for i = 0 to actual.size() - 1
		if not expected.has(actual.get(i))
			extra++
	return "engine=" + expected.size() + " closure=" + actual.size()
		+ " missed=" + missing + " spurious=" + extra

/** The closure API must see exactly what the list API sees, which parity above ties to the engine. */
function checkClosureParity(vec2 pos, real radius, string label)
	let viaClosure = CreateGroup()
	let viaList = CreateGroup()
	forEachUnitInRange(pos, radius) u ->
		viaClosure.add(u)
	unitsInRange(spatialResultScratch, pos, radius)
	for i = 0 to spatialResultScratch.size() - 1
		viaList.add(spatialResultScratch.get(i))
	var equal = viaClosure.size() == viaList.size()
	if equal
		for i = 0 to viaClosure.size() - 1
			if not viaList.has(viaClosure.get(i))
				equal = false
	check(equal, label + " (" + describeDifference(viaClosure, viaList) + ")")
	viaClosure.destr()
	viaList.destr()

function checkRangeParity(vec2 pos, real radius, bool collisionFiltering, string label)
	let actual = CreateGroup()
	let expected = CreateGroup()
	collectViaSpatialIndex(pos, radius, collisionFiltering, actual)
	collectNative(pos, radius, collisionFiltering, expected)
	var equal = actual.size() == expected.size()
	if equal
		for i = 0 to actual.size() - 1
			if not expected.has(actual.get(i))
				equal = false
	check(equal, label + " (" + describeDifference(actual, expected) + ")")
	actual.destr()
	expected.destr()

/** Mutated inside closures, so they cannot be locals - see the note at their use. */
var closureVisited = 0
var closureOuter = 0
var closureInner = 0

function testSpatialIndexParity()
	section("--- 13. spatial index vs engine enumeration ---")
	if isLua and USE_UNIT_SPATIAL_INDEX
		note("indexed path active, tracking " + spatialIndexTrackedUnits()
			+ " units, staleness " + spatialIndexWorstStaleness()
			+ "s, padding " + spatialIndexPadCells() + " cell(s)")
	else
		note("index inactive (isLua=" + isLua + ", enabled=" + USE_UNIT_SPATIAL_INDEX + ")")
		return

	// A spread of probes straddling the query boundary, so the distance test is exercised on both
	// sides of it and inside the uncertain annulus rather than only well inside the radius.
	unit array probes
	for i = 0 to 5
		probes[i] = createUnit(players[0], UnitIds.footman,
			SPATIAL_TEST_POS.add(i * 120., 0.), angle(0))

	// Awkward population cases. No expected behaviour is hardcoded - whatever the engine does with
	// these is what the closure must also do.
	let hidden = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS.add(60., 0.), angle(0))
	hidden.hide()
	let locust = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS.add(180., 0.), angle(0))
	locust.addAbility(LOCUST_ID)
	let corpse = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS.add(240., 0.), angle(0))
	corpse.kill()
	// The engine enumerates a corpse even when it still has Locust.
	let locustCorpse = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS.add(270., 0.), angle(0))
	locustCorpse.addAbility(LOCUST_ID)
	locustCorpse.kill()

	// The synchronous bootstrap relies on the engine's player enum, specifically because it includes
	// states omitted by range/rect enums. Pin that engine distinction explicitly.
	let playerUnits = CreateGroup()
	GroupEnumUnitsOfPlayer(playerUnits, players[0], null)
	check(playerUnits.has(hidden), "player enumeration includes hidden units")
	check(playerUnits.has(locust), "player enumeration includes Locust units")
	playerUnits.destr()

	checkRangeParity(SPATIAL_TEST_POS, 300., false, "range query matches the engine")
	checkClosureParity(SPATIAL_TEST_POS, 300., "closure API sees the same units as the list API")
	checkClosureParity(SPATIAL_TEST_POS, 2000., "closure API agrees on a wide radius")

	// Early exit must stop, and must stop after the callback that asked to.
	// The counters are package level on purpose: a local captured by a closure is captured by
	// value, so incrementing one inside the callback would leave the copy read here at zero and
	// the check would fail whether or not the API worked.
	closureVisited = 0
	forEachUnitInRangeUntil(SPATIAL_TEST_POS, 2000.) u ->
		closureVisited++
		return closureVisited < 2
	check(closureVisited == 2, "forEachUnitInRangeUntil stops when the callback says so ("
		+ closureVisited + ")")

	// A callback starting another query must not disturb the one it is inside: each takes its own
	// scratch list, and gives it back itself.
	closureOuter = 0
	closureInner = 0
	forEachUnitInRange(SPATIAL_TEST_POS, 300.) _u ->
		closureOuter++
		forEachUnitInRange(SPATIAL_TEST_POS, 300.) _v ->
			closureInner++
	let flat = CreateGroup()
	collectViaSpatialIndex(SPATIAL_TEST_POS, 300., false, flat)
	check(closureOuter == flat.size(), "nested query leaves the outer iteration intact ("
		+ closureOuter + " vs " + flat.size() + ")")
	check(closureInner == closureOuter * flat.size(), "nested query runs in full each time ("
		+ closureInner + ")")
	flat.destr()
	checkRangeParity(SPATIAL_TEST_POS, 300., true, "collision-filtered query matches the engine")
	checkRangeParity(SPATIAL_TEST_POS, 121., false, "tight radius on a probe boundary")
	checkRangeParity(SPATIAL_TEST_POS, 2000., false, "wide radius")

	let foreign = createUnit(players[1], UnitIds.footman, SPATIAL_TEST_POS, angle(0))
	unitsInRange(spatialResultScratch, SPATIAL_TEST_POS, 300., false, spatialPlayerZeroFilter)
	check(not spatialResultScratch.has(foreign), "query filter excludes a spatial match in one pass")
	foreign.remove()

	// The index holds what UnitIndexer holds: a unit deindexed by hand leaves it, although the engine
	// still enumerates it, and indexing it again brings it back.
	probes[0].deindex()
	unitsInRange(spatialResultScratch, SPATIAL_TEST_POS, 300.)
	check(not spatialResultScratch.has(probes[0]), "a manually deindexed unit leaves the index")
	probes[0].toUnitIndex()
	checkRangeParity(SPATIAL_TEST_POS, 300., false, "indexing it again brings it back")

	// This unit was created directly in this package's init, before OnUnitEnterLeave dispatches the
	// units init created. The dispatch has run by now, so the index holds it.
	checkRangeParity(spatialInitProbe.getPos(), 32., false, "init-time spawn is indexed")
	check(spatialInitProbeEnterEvents == 1, "init-time spawn emits one enter event ("
		+ spatialInitProbeEnterEvents + ")")

	// Eligibility is evaluated at query time. Toggling Locust must take effect immediately in both
	// directions rather than waiting for a sweep or permanently dropping the unit from the index.
	probes[1].addAbility(LOCUST_ID)
	locust.removeAbility(LOCUST_ID)
	checkRangeParity(SPATIAL_TEST_POS, 300., false, "locust transitions match immediately")
	probes[1].removeAbility(LOCUST_ID)
	locust.addAbility(LOCUST_ID)

	// Rect parity, including the engine's documented +32 minimum-bound off-by-one.
	let r = Rect(SPATIAL_TEST_POS.x - 200., SPATIAL_TEST_POS.y - 200.,
		SPATIAL_TEST_POS.x + 200., SPATIAL_TEST_POS.y + 200.)
	let actualRect = CreateGroup()
	let expectedRect = CreateGroup()
	unitsInBox(spatialResultScratch, vec2(r.getMinX() + 32., r.getMinY() + 32.),
		vec2(r.getMaxX(), r.getMaxY()))
	for i = 0 to spatialResultScratch.size() - 1
		actualRect.add(spatialResultScratch.get(i))
	GroupEnumUnitsInRect(expectedRect, r, null)
	var rectEqual = actualRect.size() == expectedRect.size()
	if rectEqual
		for i = 0 to actualRect.size() - 1
			if not expectedRect.has(actualRect.get(i))
				rectEqual = false
	check(rectEqual, "rect query matches the engine ("
		+ describeDifference(actualRect, expectedRect) + ")")
	actualRect.destr()
	expectedRect.destr()
	r.remove()

	// A teleport is not observable, so the index only learns about it from the sweep or from an
	// explicit refresh. This pins the documented contract: after updateSpatialIndex() it agrees
	// immediately. (Ordinary movement needs no such call - the padding covers it.)
	probes[5].setPos(SPATIAL_TEST_POS)
	probes[5].updateSpatialIndex()
	checkRangeParity(SPATIAL_TEST_POS, 50., false, "teleport is visible after updateSpatialIndex")

	for i = 0 to 5
		probes[i].remove()
	hidden.remove()
	locust.remove()
	corpse.remove()
	locustCorpse.remove()

/** A global because the second wave is spawned from a timer, and closures cannot capture local arrays. */
unit array lifecycleProbes

function testSpatialIndexLifecycle()
	section("--- 14. spatial index lifecycle bounds ---")
	if not isLua or not USE_UNIT_SPATIAL_INDEX
		note("indexed path inactive - lifecycle-specific checks skipped")
		return

	// Growing by two complete sweep budgets guarantees a larger cycle regardless of where the
	// pre-existing population sits relative to a ceil boundary.
	let batchSize = SPATIAL_INDEX_UNITS_PER_TICK * 2
	let initialBound = spatialIndexWorstStaleness()
	for i = 0 to batchSize - 1
		lifecycleProbes[i] = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS, angle(0))
	let expandedBound = spatialIndexWorstStaleness()
	check(expandedBound > initialBound, "registry growth expands the staleness bound immediately")
	let allocatedAtPeak = spatialIndexAllocatedSlots()

	for i = 0 to batchSize - 1
		lifecycleProbes[i].remove()
		lifecycleProbes[i] = null

	// Warcraft reports a removal after the thread that removed the unit, and before a zero-second
	// timer fires (measured on the 3.0.0 client), so the index frees the ids only from then on. Two
	// sweep ticks have to pass before the bound can shrink, and a zero-second timer fires well before.
	doAfter(0.) ->
		runGuarded("14. spatial index lifecycle bounds, after the removals") ->
			check(spatialIndexWorstStaleness() >= expandedBound,
				"registry shrink retains the old bound until a stable sweep completes")

			// A second same-sized wave must reuse the just-freed ids rather than extending every numeric
			// cache table with another session-long block of slots. The ids are UnitIndexer indices, which
			// other objects share, so a few fresh ones are fine; a whole wave of them is not. Measured
			// against the count right before it: the sections after this one spawn units while the first
			// wave's ids are still waiting for their removal, and those take fresh ids.
			let slotsBeforeWave = spatialIndexAllocatedSlots()
			for i = 0 to batchSize - 1
				lifecycleProbes[i] = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS, angle(0))
			check(spatialIndexAllocatedSlots() - slotsBeforeWave < batchSize div 2
				and slotsBeforeWave >= allocatedAtPeak,
				"removed-unit cache slots are reused (" + slotsBeforeWave + " allocated before the wave, "
				+ spatialIndexAllocatedSlots() + " after)")
			for i = 0 to batchSize - 1
				lifecycleProbes[i].remove()
				lifecycleProbes[i] = null

var reentrancyVisited = 0
var reentrancyNested = 0
// Globals rather than locals: Wurst closures cannot capture local arrays, and these probes have to
// be reachable from inside the visitors that mutate them.
unit array reentrancyProbes
unit spawnedDuringQuery = null

function testSpatialIndexReentrancy()
	section("--- 15. spatial index reentrancy ---")
	if not isLua or not USE_UNIT_SPATIAL_INDEX
		note("indexed path inactive - snapshot-specific checks skipped")
		return

	for i = 0 to 3
		reentrancyProbes[i] = createUnit(players[0], UnitIds.footman,
			SPATIAL_TEST_POS.add(i * 64., 0.), angle(0))

	// A visitor that removes a *later* unit in the same batch. This is the case that breaks a naive
	// readout which caches the group size and indexes into it: groups silently drop removed units,
	// so every later index shifts down and a unit is skipped. A snapshot is immune.
	reentrancyVisited = 0
	unitsInRange(spatialOuterScratch, SPATIAL_TEST_POS.add(96., 0.), 400.)
	for i = 0 to spatialOuterScratch.size() - 1
		let u = spatialOuterScratch.get(i)
		reentrancyVisited++
		if reentrancyVisited == 1
			for j = 0 to 3
				if reentrancyProbes[j] != u
					reentrancyProbes[j].remove()
					reentrancyProbes[j] = null
					break
	check(reentrancyVisited >= 4, "removing a unit mid-iteration skips nobody ("
		+ reentrancyVisited + " visited)")

	for i = 0 to 3
		if reentrancyProbes[i] != null
			reentrancyProbes[i].remove()
			reentrancyProbes[i] = null
	for i = 0 to 3
		reentrancyProbes[i] = createUnit(players[0], UnitIds.footman,
			SPATIAL_TEST_POS.add(i * 64., 0.), angle(0))

	// A nested query inside a visitor, three deep, to exercise the snapshot stack: an inner query
	// pushes above the outer one and must not disturb it.
	reentrancyVisited = 0
	reentrancyNested = 0
	unitsInRange(spatialOuterScratch, SPATIAL_TEST_POS.add(96., 0.), 400.)
	for outerIndex = 0 to spatialOuterScratch.size() - 1
		let outerUnit = spatialOuterScratch.get(outerIndex)
		reentrancyVisited++
		unitsInRange(spatialMiddleScratch, outerUnit.getPos(), 300.)
		for middleIndex = 0 to spatialMiddleScratch.size() - 1
			let middleUnit = spatialMiddleScratch.get(middleIndex)
			reentrancyNested++
			unitsInRange(spatialInnerScratch, middleUnit.getPos(), 100.)
			for innerIndex = 0 to spatialInnerScratch.size() - 1
				let innerUnit = spatialInnerScratch.get(innerIndex)
				if innerUnit == null
					reentrancyNested--
	check(reentrancyVisited == 4, "outer enumeration unaffected by nesting ("
		+ reentrancyVisited + ")")
	check(reentrancyNested > 0, "nested enumerations ran (" + reentrancyNested + ")")

	// A visitor that creates a unit inside the query radius: it must not be visited by the query
	// that is already running, and must not corrupt the iteration.
	reentrancyVisited = 0
	spawnedDuringQuery = null
	unitsInRange(spatialOuterScratch, SPATIAL_TEST_POS.add(96., 0.), 400.)
	for i = 0 to spatialOuterScratch.size() - 1
		let _u = spatialOuterScratch.get(i)
		reentrancyVisited++
		if spawnedDuringQuery == null
			spawnedDuringQuery = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS, angle(0))
	check(reentrancyVisited == 4, "creating a unit mid-iteration does not extend it ("
		+ reentrancyVisited + ")")
	spawnedDuringQuery?.remove()
	spawnedDuringQuery = null

	for i = 0 to 3
		reentrancyProbes[i].remove()

// ============================================================================
// 8 + 9. TimedLoop registration
// ============================================================================

class LoopProbe
	use TimedLoop
	var ticks = 0

	override function onTimedLoop()
		ticks++

function testTimedLoopStopBeforeStart()
	section("--- 8. TimedLoop: stop() before the first start() ---")
	let probe = new LoopProbe()
	// a defensive stop on an instance that was never started
	probe.stopTimedLoop()
	probe.startTimedLoop()

	doAfter(0.5) ->
		check(probe.ticks > 0, "onTimedLoop runs after stop-then-start (ticks " + probe.ticks + ")")
		probe.stopTimedLoopAndDestroy()

function testTimedLoopDoubleStart()
	section("--- 9. TimedLoop: repeated start() must not double register ---")
	let single = new LoopProbe()
	let tripled = new LoopProbe()
	single.startTimedLoop()
	tripled..startTimedLoop()..startTimedLoop()..startTimedLoop()

	doAfter(0.5) ->
		check(tripled.ticks == single.ticks, "three starts tick as often as one ("
			+ tripled.ticks + " vs " + single.ticks + ")")
		single.stopTimedLoopAndDestroy()
		tripled.stopTimedLoopAndDestroy()

// ============================================================================
// 17. Error listeners
// ============================================================================

constant ERROR_PROBE = "stdlib in-game error listener probe"
var errorsHeard = 0
var lastErrorHeard = ""
var errorHeardSuppressed = false
var errorListenersInstalled = false

/*	On Lua, error() returns instead of ending the thread, so an error in a callback leaves nothing
	behind unless something listens. grill test cannot check this: at compile time error() is a
	compile error. */
function testErrorListeners()
	section("--- 17. error listeners ---")
	if not errorListenersInstalled
		errorListenersInstalled = true
		// Fails on the probe on purpose: its own error must not recurse into the listeners, and the
		// listener after it must still run.
		addErrorListener() msg ->
			if msg == ERROR_PROBE
				error("a listener failed on " + msg)
		addErrorListener() msg ->
			errorsHeard++
			lastErrorHeard = msg
			errorHeardSuppressed = suppressErrorMessages
	let before = errorsHeard
	// try() also ends the thread on Jass, where error() crashes it.
	try(() -> error(ERROR_PROBE))
	check(errorsHeard - before == 1, "an error reaches the listeners once, past a failing listener ("
		+ (errorsHeard - before).toString() + ")")
	check(lastErrorHeard == ERROR_PROBE, "the listener gets the message")
	check(errorHeardSuppressed, "a listener can tell an error try() caught")
	check(lastError == ERROR_PROBE, "lastError keeps the error, not the failing listener's (" + lastError + ")")

// ============================================================================
// 16. UnitIndexer storage
// ============================================================================

/**	The index store is target-specific: user data on Jass, a keyed map on Lua.
	Whichever backs it, indices must be live, distinct, resolvable and
	cleared on deindex. */
function testUnitIndexerStorage()
	section("16. unit indexer storage")
	let a = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS.add(200., 200.), angle(0))
	let b = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS.add(250., 200.), angle(0))
	let ia = a.getIndex()
	let ib = b.getIndex()
	check(ia > 0 and ib > 0, "created units are indexed (" + ia + ", " + ib + ")")
	check(ia != ib, "two units get distinct indices")
	check((ia castTo UnitIndex).getUnit() == a, "an index resolves back to its unit")
	check(a.toUnitIndex() castTo int == ia, "toUnitIndex is stable for an indexed unit")
	a.deindex()
	check(a.getIndex() == 0, "a deindexed unit reads index 0")
	check(b.getIndex() == ib, "deindexing one unit leaves another intact")
	let ia2 = a.toUnitIndex() castTo int
	check(ia2 > 0 and a.getIndex() == ia2, "reindexing assigns a live index")
	check((ia2 castTo UnitIndex).getUnit() == a, "the new index resolves back to the unit")
	a.remove()
	b.remove()

// ============================================================================
// 18. Spell listeners of every kind on the one spell effect trigger
// ============================================================================

/*	The spell effect trigger has a listener from registerPlayerUnitEvent, from registerSpellEffectEvent and from
	EventListener.onCast, and the library adds its own. On Lua they sit behind one bridge in the trigger, so
	this checks what the bridge must keep: every listener runs once per cast, in the order it was added, for the
	ability it was added for, and one which was destroyed stops running. Two instant spells are cast for real. */

constant BRIDGE_ABIL_A = 'W9E1'
constant BRIDGE_ABIL_B = 'W9E2'

function defineBridgeSpell(int id) returns string
	let spell = new ChannelAbilityPreset(id, 1, true)
	spell.makeUnitSpell(0, 0.)
	spell.presetTargetTypes(Targettype.NONE)
	return spell.getOrderString()

constant BRIDGE_ORDER_A = compiletime(defineBridgeSpell(BRIDGE_ABIL_A))
constant BRIDGE_ORDER_B = compiletime(defineBridgeSpell(BRIDGE_ABIL_B))

constant BRIDGE_COND1 = 0
constant BRIDGE_COND2 = 1
constant BRIDGE_SPELL1 = 2
constant BRIDGE_SPELL2 = 3
constant BRIDGE_SPELL_B = 4
constant BRIDGE_CLOSURE = 5
constant BRIDGE_UNIT_CLOSURE = 6

int array bridgeCount
int array bridgeSeq
var bridgeSeqCounter = 0
var bridgeRegistered = false
var bridgeResponsesRight = true
unit bridgeCaster = null

function bridgeHit(int id)
	bridgeCount[id] = bridgeCount[id] + 1
	bridgeSeqCounter++
	bridgeSeq[id] = bridgeSeqCounter

/** Whether this is a cast of one of the two spells of this section; other sections cast spells of their own. */
function bridgeOwnCast() returns boolean
	let abilityId = GetSpellAbilityId()
	return abilityId == BRIDGE_ABIL_A or abilityId == BRIDGE_ABIL_B

function bridgeCond1()
	if bridgeOwnCast()
		bridgeHit(BRIDGE_COND1)
		if GetTriggerUnit() == null
			bridgeResponsesRight = false

function bridgeCond2()
	if bridgeOwnCast()
		bridgeHit(BRIDGE_COND2)

function bridgeSpell1()
	bridgeHit(BRIDGE_SPELL1)

function bridgeSpell2()
	bridgeHit(BRIDGE_SPELL2)

function bridgeSpellB()
	bridgeHit(BRIDGE_SPELL_B)

function bridgeExpect(string label, int cond, int spell1, int spellB, int closure, int unitClosure)
	check(bridgeCount[BRIDGE_COND1] == cond and bridgeCount[BRIDGE_COND2] == cond,
		label + ": conditions ran " + cond + " times (" + bridgeCount[BRIDGE_COND1] + ", "
		+ bridgeCount[BRIDGE_COND2] + ")")
	check(bridgeCount[BRIDGE_SPELL1] == spell1 and bridgeCount[BRIDGE_SPELL2] == spell1,
		label + ": ability A listeners ran " + spell1 + " times (" + bridgeCount[BRIDGE_SPELL1] + ", "
		+ bridgeCount[BRIDGE_SPELL2] + ")")
	check(bridgeCount[BRIDGE_SPELL_B] == spellB,
		label + ": the ability B listener ran " + spellB + " times (" + bridgeCount[BRIDGE_SPELL_B] + ")")
	check(bridgeCount[BRIDGE_CLOSURE] == closure and bridgeCount[BRIDGE_UNIT_CLOSURE] == unitClosure,
		label + ": cast listeners ran " + closure + " and " + unitClosure + " times ("
		+ bridgeCount[BRIDGE_CLOSURE] + ", " + bridgeCount[BRIDGE_UNIT_CLOSURE] + ")")

/** Takes the map as the HashMap it always was, so this stops compiling if it ever is not one. */
function castMapEntries(HashMap<int, OnCastListener> map) returns int
	return map.size()

function giveBridgeAbilities(unit u)
	u.addAbility(BRIDGE_ABIL_A)
	u.addAbility(BRIDGE_ABIL_B)

function testEventBridge()
	section("--- 18. spell listeners behind one bridge ---")
	for i = 0 to 6
		bridgeCount[i] = 0
		bridgeSeq[i] = 0
	bridgeSeqCounter = 0
	bridgeResponsesRight = true
	// One caster per cast: a unit which has just cast is still in its animation and drops the next order.
	bridgeCaster = createUnit(players[0], UnitIds.footman, vec2(-2500., -2500.), angle(0))
	let casterB = createUnit(players[0], UnitIds.footman, vec2(-2600., -2500.), angle(0))
	let casterA2 = createUnit(players[0], UnitIds.footman, vec2(-2700., -2500.), angle(0))
	giveBridgeAbilities(bridgeCaster)
	giveBridgeAbilities(casterB)
	giveBridgeAbilities(casterA2)
	// A listener can not be taken back, so the plain ones are added once however often the suite runs.
	if not bridgeRegistered
		bridgeRegistered = true
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_EFFECT, function bridgeCond1)
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_EFFECT, function bridgeCond2)
		registerSpellEffectEvent(BRIDGE_ABIL_A, function bridgeSpell1)
		registerSpellEffectEvent(BRIDGE_ABIL_A, function bridgeSpell2)
		registerSpellEffectEvent(BRIDGE_ABIL_B, function bridgeSpellB)
	let castMapSize = castMapEntries(EventListener.castMap)
	let closure = EventListener.onCast(BRIDGE_ABIL_A, caster -> bridgeHit(BRIDGE_CLOSURE))
	check(castMapEntries(EventListener.castMap) == castMapSize + 1 and EventListener.castMap.has(BRIDGE_ABIL_A),
		"castMap is a HashMap which holds the listener of the ability (" + castMapEntries(EventListener.castMap) + ")")
	let unitClosure = EventListener.onCast(bridgeCaster, BRIDGE_ABIL_A, caster -> bridgeHit(BRIDGE_UNIT_CLOSURE))

	// A cast takes effect a fraction of a second after its order, so the three casts go out together.
	doAfter(0.1) ->
		bridgeCaster.issueImmediateOrder(BRIDGE_ORDER_A)
		casterB.issueImmediateOrder(BRIDGE_ORDER_B)
		casterA2.issueImmediateOrder(BRIDGE_ORDER_A)
	doAfter(0.9) ->
		bridgeExpect("three casts", 3, 2, 1, 2, 1)
		check(bridgeSeq[BRIDGE_COND1] < bridgeSeq[BRIDGE_COND2], "conditions run in the order they were added")
		check(bridgeSeq[BRIDGE_SPELL1] < bridgeSeq[BRIDGE_SPELL2], "ability listeners run in the order they were added")
		check(bridgeResponsesRight, "a listener sees the caster and the ability of the event")
		destroy closure
		destroy unitClosure
		bridgeCaster.issueImmediateOrder(BRIDGE_ORDER_A)
	doAfter(1.7) ->
		bridgeExpect("another cast after the cast listeners were destroyed", 4, 3, 1, 2, 1)
		check(castMapEntries(EventListener.castMap) == castMapSize and not EventListener.castMap.has(BRIDGE_ABIL_A),
			"castMap gave the listener up again (" + castMapEntries(EventListener.castMap) + ")")
		bridgeCaster.remove()
		bridgeCaster = null
		casterB.remove()
		casterA2.remove()

// ============================================================================
// 19. TimedLoop classes which leave while others run
// ============================================================================

/*	All TimedLoop classes of one period are called from one timer, in the order they became active. A class
	which runs out of instances leaves that list in the middle of a tick. The classes after it must still
	run in that tick, and a class which comes back goes to the end. */

var loopSeq = 0

class LoopFirst
	use TimedLoop
	var ticks = 0
	var seen = 0

	override function onTimedLoop()
		ticks++
		loopSeq++
		seen = loopSeq

class LoopMiddle
	use TimedLoop
	var ticks = 0
	var seen = 0

	override function onTimedLoop()
		ticks++
		loopSeq++
		seen = loopSeq
		if ticks == 5
			stopTimedLoop()

class LoopLast
	use TimedLoop
	var ticks = 0
	var seen = 0

	override function onTimedLoop()
		ticks++
		loopSeq++
		seen = loopSeq

function testTimedLoopClasses()
	section("--- 19. TimedLoop classes which leave while others run ---")
	loopSeq = 0
	let first = new LoopFirst()
	let middle = new LoopMiddle()
	let last = new LoopLast()
	first.startTimedLoop()
	middle.startTimedLoop()
	last.startTimedLoop()

	doAfter(0.12) ->
		check(first.ticks > 0 and first.ticks == middle.ticks and first.ticks == last.ticks,
			"every class runs once per tick (" + first.ticks + ", " + middle.ticks + ", " + last.ticks + ")")
		check(first.seen < middle.seen and middle.seen < last.seen, "classes run in the order they became active")
	doAfter(0.6) ->
		check(middle.ticks == 5, "the class which stopped itself ran no more (" + middle.ticks + " ticks)")
		check(first.ticks > 10 and first.ticks == last.ticks,
			"the class after the one which left never missed a tick (" + first.ticks + " vs " + last.ticks + ")")
		middle.ticks = 0
		middle.startTimedLoop()
	// Three ticks after it came back, before it stops itself again at its fifth.
	doAfter(0.7) ->
		check(middle.ticks > 0, "the class which came back runs again (" + middle.ticks + " ticks)")
		check(first.seen < last.seen and last.seen < middle.seen, "and it runs last, as the newest to become active")
		first.stopTimedLoopAndDestroy()
		middle.stopTimedLoopAndDestroy()
		last.stopTimedLoopAndDestroy()

// ============================================================================
// 20. A condition gates the action registered with it
// ============================================================================

/*	A registration with an action keeps its condition as a condition of the event's trigger, so the action runs
	if the condition holds and only then, whatever else listens to the event. Point and target orders are used,
	as the library has no listeners of its own on them. */

int array gateHits
var gateRegistered = false

function gateListener() returns boolean
	gateHits[0] = gateHits[0] + 1
	return true

function gateConditionTrue() returns boolean
	return true

function gateConditionFalse() returns boolean
	return false

function gateActionAllowed()
	gateHits[1] = gateHits[1] + 1

function gateActionDenied()
	gateHits[2] = gateHits[2] + 1

function testConditionGatesAction()
	section("--- 20. a condition gates the action registered with it ---")
	for i = 0 to 2
		gateHits[i] = 0
	// A listener comes first on the point order, so the action is registered on a trigger which has one.
	if not gateRegistered
		gateRegistered = true
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, function gateListener)
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_POINT_ORDER, null, function gateConditionTrue,
			function gateActionAllowed)
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_ISSUED_TARGET_ORDER, null, function gateConditionFalse,
			function gateActionDenied)
	let gateUnit = createUnit(players[0], UnitIds.footman, vec2(-2500., -2900.), angle(0))
	let gateTarget = createUnit(players[0], UnitIds.footman, vec2(-2400., -2900.), angle(0))
	doAfter(0.1) ->
		gateUnit.issuePointOrder("move", vec2(-2500., -2800.))
		gateUnit.issueTargetOrder("smart", gateTarget)
	doAfter(0.6) ->
		check(gateHits[0] == 1, "the listener of the point order ran once (" + gateHits[0] + ")")
		check(gateHits[1] == 1, "the action ran, as its condition held (" + gateHits[1] + ")")
		check(gateHits[2] == 0, "the action did not run, as its condition did not hold (" + gateHits[2] + ")")
		gateUnit.remove()
		gateTarget.remove()

// ============================================================================
// 21. A condition added to the exported trigger keeps its place
// ============================================================================

/*	getPlayerUnitEventTrigger hands out the trigger the listeners of an event sit on, and what is added to it
	directly runs among them in the order of adding. Listener A, a condition B added to the trigger and listener C
	must run as A, B, C however the listeners are kept. The spell channel event is used, as the library has no
	listeners of its own on it, and a spell of its own so that no other cast is counted. */

constant ORDER_ABIL = 'W9E3'
constant ORDER_SPELL_ORDER = compiletime(defineBridgeSpell(ORDER_ABIL))

int array orderCount
int array orderSeq
var orderSeqCounter = 0
var orderRegistered = false

function orderHit(int id)
	if GetSpellAbilityId() == ORDER_ABIL
		orderCount[id] = orderCount[id] + 1
		orderSeqCounter++
		orderSeq[id] = orderSeqCounter

function orderListenerA()
	orderHit(0)

function orderConditionB() returns boolean
	orderHit(1)
	return true

function orderListenerC()
	orderHit(2)

function testExportedTriggerOrder()
	section("--- 21. a condition added to the exported trigger keeps its place ---")
	for i = 0 to 2
		orderCount[i] = 0
		orderSeq[i] = 0
	orderSeqCounter = 0
	// Nothing can be taken back from a trigger, so this is done once however often the suite runs.
	if not orderRegistered
		orderRegistered = true
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_CHANNEL, function orderListenerA)
		getPlayerUnitEventTrigger(EVENT_PLAYER_UNIT_SPELL_CHANNEL).addCondition(Filter(function orderConditionB))
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_CHANNEL, function orderListenerC)
	let orderCaster = createUnit(players[0], UnitIds.footman, vec2(-2800., -2500.), angle(0))
	orderCaster.addAbility(ORDER_ABIL)
	doAfter(0.1) ->
		orderCaster.issueImmediateOrder(ORDER_SPELL_ORDER)
	doAfter(0.9) ->
		check(orderCount[0] == 1 and orderCount[1] == 1 and orderCount[2] == 1,
			"each of the three ran once (" + orderCount[0] + ", " + orderCount[1] + ", " + orderCount[2] + ")")
		check(orderSeq[0] < orderSeq[1] and orderSeq[1] < orderSeq[2],
			"they ran in the order they were added (" + orderSeq[0] + ", " + orderSeq[1] + ", " + orderSeq[2] + ")")
		orderCaster.remove()

// ============================================================================
// 22. Taking the exported trigger while its event is delivered
// ============================================================================

/*	getPlayerUnitEventTrigger takes the listeners of an event off their one condition and puts them back as
	conditions of their own, and a listener may call it while the event is being delivered. That must not run a
	listener twice, which it would if the engine reached conditions added during the evaluation of a trigger it
	fires. It does not, on the client this was checked on, and this pins it. The second cast shows that the
	conditions put back work. */

constant TAKE_ABIL = 'W9E4'
constant TAKE_ORDER = compiletime(defineBridgeSpell(TAKE_ABIL))

int array takeCount
var takeTaken = false
var takeRegistered = false

function takeFirst()
	if GetSpellAbilityId() == TAKE_ABIL
		takeCount[0] = takeCount[0] + 1

function takeMiddle()
	if GetSpellAbilityId() == TAKE_ABIL
		takeCount[1] = takeCount[1] + 1
		if not takeTaken
			takeTaken = true
			getPlayerUnitEventTrigger(EVENT_PLAYER_UNIT_SPELL_CAST)

function takeLast()
	if GetSpellAbilityId() == TAKE_ABIL
		takeCount[2] = takeCount[2] + 1

function testTakingTheTriggerWhileDelivering()
	section("--- 22. taking the exported trigger while its event is delivered ---")
	for i = 0 to 2
		takeCount[i] = 0
	// Nothing can be taken back from a trigger, so this is done once however often the suite runs.
	if not takeRegistered
		takeRegistered = true
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_CAST, function takeFirst)
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_CAST, function takeMiddle)
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_CAST, function takeLast)
	let takeCaster = createUnit(players[0], UnitIds.footman, vec2(-2900., -2500.), angle(0))
	let takeCaster2 = createUnit(players[0], UnitIds.footman, vec2(-3000., -2500.), angle(0))
	takeCaster.addAbility(TAKE_ABIL)
	takeCaster2.addAbility(TAKE_ABIL)
	doAfter(0.1) ->
		takeCaster.issueImmediateOrder(TAKE_ORDER)
	doAfter(0.9) ->
		check(takeCount[0] == 1 and takeCount[1] == 1 and takeCount[2] == 1,
			"each listener ran once for the cast which took the trigger (" + takeCount[0] + ", " + takeCount[1]
			+ ", " + takeCount[2] + ")")
		takeCaster2.issueImmediateOrder(TAKE_ORDER)
	doAfter(1.7) ->
		check(takeCount[0] == 2 and takeCount[1] == 2 and takeCount[2] == 2,
			"and once more for the next cast, as conditions of their own (" + takeCount[0] + ", " + takeCount[1]
			+ ", " + takeCount[2] + ")")
		takeCaster.remove()
		takeCaster2.remove()

// ============================================================================
// 23. A listener registered while its event is delivered
// ============================================================================

/*	A condition added to a trigger while the engine fires it is not reached by that firing, and a listener
	registered by a listener is not either: it gets the events from the next one on. That holds for the first
	listener of an event and for the listeners after it, which are kept in a list. Two casts show it on two
	events: the first cast, in which the listeners register, and the second, which the new ones must get. */

constant LATE_ABIL = 'W9E5'
constant LATE_ORDER = compiletime(defineBridgeSpell(LATE_ABIL))

int array lateCount
var lateRegistered = false
var lateAdded = false

function lateOwnCast() returns boolean
	return GetSpellAbilityId() == LATE_ABIL

/** Two listeners of the finish event; the second registers a third one while it runs. */
function lateFinishFirst()
	if lateOwnCast()
		lateCount[0] = lateCount[0] + 1

function lateFinishThird()
	if lateOwnCast()
		lateCount[2] = lateCount[2] + 1

function lateFinishSecond()
	if lateOwnCast()
		lateCount[1] = lateCount[1] + 1
		if not lateAdded
			lateAdded = true
			registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_FINISH, function lateFinishThird)

/** The only listener of the endcast event, which registers another one while it runs. */
function lateEndcastAlone()
	if lateOwnCast()
		lateCount[3] = lateCount[3] + 1
		if lateCount[3] == 1
			registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_ENDCAST, function lateEndcastAdded)

function lateEndcastAdded()
	if lateOwnCast()
		lateCount[4] = lateCount[4] + 1

function testListenerRegisteredWhileDelivering()
	section("--- 23. a listener registered while its event is delivered ---")
	for i = 0 to 4
		lateCount[i] = 0
	// Nothing can be taken back from a trigger, so this is done once however often the suite runs.
	if not lateRegistered
		lateRegistered = true
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_FINISH, function lateFinishFirst)
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_FINISH, function lateFinishSecond)
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_ENDCAST, function lateEndcastAlone)
	let lateCaster = createUnit(players[0], UnitIds.footman, vec2(-3100., -2500.), angle(0))
	let lateCaster2 = createUnit(players[0], UnitIds.footman, vec2(-3200., -2500.), angle(0))
	lateCaster.addAbility(LATE_ABIL)
	lateCaster2.addAbility(LATE_ABIL)
	doAfter(0.1) ->
		lateCaster.issueImmediateOrder(LATE_ORDER)
	doAfter(0.9) ->
		check(lateCount[0] == 1 and lateCount[1] == 1 and lateCount[2] == 0,
			"the listener registered among several did not get the event it was registered in ("
			+ lateCount[0] + ", " + lateCount[1] + ", " + lateCount[2] + ")")
		check(lateCount[3] == 1 and lateCount[4] == 0,
			"nor did the one registered by the only listener (" + lateCount[3] + ", " + lateCount[4] + ")")
		lateCaster2.issueImmediateOrder(LATE_ORDER)
	doAfter(1.7) ->
		check(lateCount[0] == 2 and lateCount[1] == 2 and lateCount[2] == 1,
			"but the next event (" + lateCount[0] + ", " + lateCount[1] + ", " + lateCount[2] + ")")
		check(lateCount[3] == 2 and lateCount[4] == 1,
			"for both events (" + lateCount[3] + ", " + lateCount[4] + ")")
		lateCaster.remove()
		lateCaster2.remove()

// ============================================================================
// Runner
// ============================================================================

/**	Runs every in-game check and reports the totals to done once the summary
	is out. Call from a timer callback rather than straight from init, because
	it creates units. The callback is destroyed after it ran. If a run is
	already in flight, a new one starts after it and done gets the new run's
	totals. */
public function runStdlibIngameTests(StdlibIngameTestsDone done)
	if runInFlight
		queuedCallbacks.add(done)
	else
		runCallbacks.add(done)
	runStdlibIngameTests()

/**	Runs every in-game check. Call from a timer callback rather than straight
	from init, because it creates units. If a run is already in flight, this
	queues one more run to start after it. */
public function runStdlibIngameTests()
	if runInFlight
		if not rerunQueued
			rerunQueued = true
			print("|cffffcc00INFO|r  stdlib in-game tests already running; will run again after it")
		return
	runInFlight = true
	checksRun = 0
	checksFailed = 0
	reportLines.clear()
	report("|cff8888ff=== Wurst stdlib in-game tests ===|r")

	runGuarded("setup") ->
		setupUnits()
	runGuarded("1. zeroed DAMAGING") ->
		testZeroedDamaging()
	runGuarded("2. zeroed hit poisoning") ->
		testZeroDoesNotPoisonNextInstance()
	runGuarded("3. abortCurrent poisoning") ->
		testAbortInUnreducedListener()
	runGuarded("4. listener order") ->
		testListenerOrder()
	runGuarded("5. destroy next listener") ->
		testDestroyNextListener()
	runGuarded("6. self destroying listener") ->
		testSelfDestroyingListener()
	runGuarded("10. zeroed nested hit") ->
		testNestedZeroedDamage()
	runGuarded("11. late default reduced listener") ->
		testLateDefaultReducedListenerPriority()
	runGuarded("12. late default unreduced listener") ->
		testLateDefaultUnreducedListenerPriority()
	runGuarded("teardown") ->
		teardownUnits()

	runGuarded("7. nested enumeration") ->
		testGroupNesting()

	runGuarded("13. spatial index parity") ->
		testSpatialIndexParity()
	runGuarded("14. spatial index lifecycle bounds") ->
		testSpatialIndexLifecycle()
	runGuarded("15. spatial index reentrancy") ->
		testSpatialIndexReentrancy()
	runGuarded("16. unit indexer storage") ->
		testUnitIndexerStorage()
	runGuarded("17. error listeners") ->
		testErrorListeners()
	runGuarded("18. spell listeners behind one bridge") ->
		testEventBridge()
	runGuarded("19. TimedLoop classes") ->
		testTimedLoopClasses()
	runGuarded("20. a condition gates its action") ->
		testConditionGatesAction()
	runGuarded("21. the exported trigger keeps the order") ->
		testExportedTriggerOrder()
	runGuarded("22. taking the trigger while delivering") ->
		testTakingTheTriggerWhileDelivering()
	runGuarded("23. a listener registered while delivering") ->
		testListenerRegisteredWhileDelivering()

	// these finish asynchronously, so the summary waits for them
	runGuarded("8. TimedLoop stop before start") ->
		testTimedLoopStopBeforeStart()
	runGuarded("9. TimedLoop double start") ->
		testTimedLoopDoubleStart()

	doAfter(2.5) ->
		report("|cff8888ff=== " + (checksRun - checksFailed) + "/" + checksRun
			+ " checks passed ===|r")
		if checksFailed > 0
			report("|cffff4444" + checksFailed + " check(s) FAILED|r")
		writeReport()
		finishRun()

/**	Ends the run in flight: tells its callbacks, then starts the queued run,
	if any. The run stays in flight until every callback has returned, so each
	of them sees this run's totals and report (stdlibIngameReport), and a
	callback asking for another run only queues it. */
function finishRun()
	for i = 0 to runCallbacks.size() - 1
		let done = runCallbacks.get(i)
		// Guarded like a check: a crashing callback must not leave the run in
		// flight, or every later request would queue behind it forever.
		if not try(() -> done.onDone(checksRun, checksFailed))
			print("|cffff4444CRASH|r stdlib in-game tests callback -> "
				+ (lastError == "" ? "thread crashed" : lastError))
		destroy done
	runCallbacks.clear()
	runInFlight = false
	if rerunQueued
		rerunQueued = false
		for i = 0 to queuedCallbacks.size() - 1
			runCallbacks.add(queuedCallbacks.get(i))
		queuedCallbacks.clear()
		runStdlibIngameTests()

/** Registers "-stdlibtest" as a chat command that runs the suite. */
public function registerStdlibIngameTestCommand()
	let trig = CreateTrigger()
	for i = 0 to bj_MAX_PLAYERS - 1
		trig.registerPlayerChatEvent(players[i], "-stdlibtest", true)
	trig.addAction(() -> runStdlibIngameTests())

init
	// Created during init on purpose: this exercises the window before the deferred preplaced pass.
	onEnter(function countSpatialInitProbeEnter)
	creatingSpatialInitProbe = true
	spatialInitProbe = createUnit(players[0], UnitIds.footman, SPATIAL_TEST_POS.add(-400., 0.), angle(0))
	creatingSpatialInitProbe = false
	// Importing the package is enough to run the suite. The delay lets the map
	// and the stdlib's own init blocks finish before units are created.
	if STDLIB_INGAME_TESTS_AUTORUN
		doAfter(1.) ->
			runStdlibIngameTests()
	registerStdlibIngameTestCommand()
