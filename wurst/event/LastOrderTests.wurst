package LastOrderTests
import LastOrder
import UnitIndexer

function newTestUnit() returns unit
	return createUnit(players[0], 'hfoo', ZERO2, angle(0))

@Test function unenteredUnitHasNoRecordedOrderAndStaysUnindexed()
	let u = newTestUnit()
	(u.getLastOrder() == null).assertTrue()
	u.peekIndex().assertEquals(0)
	u.remove()

@Test function unenteredUnitCleanupDoesNotIndex()
	let u = newTestUnit()
	u.clearLastOrders()
	(u.getLastOrder() == null).assertTrue()
	u.peekIndex().assertEquals(0)
	u.remove()

@Test function unenteredUnitOrderRemainsDetachedWithoutIndexing()
	let u = newTestUnit()
	let detached = new Order(u, 851986, OrderType.POINT, null, ZERO2)
	(u.getLastOrder() == null).assertTrue()
	u.peekIndex().assertEquals(0)
	destroy detached
	u.remove()

// Importing LastOrder must leave the canonical Unit extension unambiguous.
@Test function abortOrderRemainsAvailableWithLastOrder()
	let u = newTestUnit()
	u.abortOrder().assertTrue()
	u.isPaused().assertFalse()
	u.pause()
	u.abortOrder().assertFalse()
	u.isPaused().assertTrue()
	u.remove()

@Test function recordedHistoryIncludesAtMostThreeOrders()
	let u = newTestUnit()
	new UnitIndex(u)
	for i = 1 to 10
		new Order(u, 851986, OrderType.POINT, null, vec2(i.toReal(), 0.))
	var entry = u.getLastOrder()
	var count = 0
	while entry != null
		entry.targetPosition.x.assertEquals((10 - count).toReal())
		count++
		entry = entry.prev
	count.assertEquals(3)
	u.clearLastOrders()
	u.deindex()
	u.remove()

@Test function aLaterEntryDoesNotInheritReleasedOrderHistory()
	// The interpreter does not run package init; install the production cleanup hook explicitly.
	onUnitDeindex(() -> getIndexingUnit().clearLastOrders())
	let a = newTestUnit()
	new UnitIndex(a)
	new Order(a, 851986, OrderType.POINT, null, vec2(1, 2))
	a.deindex()
	a.peekIndex().assertEquals(0)
	let b = newTestUnit()
	new UnitIndex(b)
	(b.getLastOrder() == null).assertTrue()
	b.deindex()
	a.remove()
	b.remove()

@Test function anIndexedUnitKeepsItsOrdersNewestFirst()
	let u = newTestUnit()
	new UnitIndex(u)
	let first = new Order(u, 851986, OrderType.POINT, null, vec2(1, 2))
	(u.getLastOrder() == first).assertTrue()
	let second = new Order(u, 851971, OrderType.POINT, null, vec2(3, 4))
	(u.getLastOrder() == second).assertTrue()
	(second.prev == first).assertTrue()
	u.clearLastOrders()
	(u.getLastOrder() == null).assertTrue()
	u.deindex()

@Test function ordersOfOneUnitDoNotReachAnother()
	let u = newTestUnit()
	let v = newTestUnit()
	new UnitIndex(u)
	new UnitIndex(v)
	new Order(u, 851986, OrderType.POINT, null, vec2(1, 2))
	(v.getLastOrder() == null).assertTrue()
	u.clearLastOrders()
	u.deindex()
	v.deindex()
