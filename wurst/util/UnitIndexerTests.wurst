package UnitIndexerTests
import UnitIndexer

unit array seenIndexed
unit array seenDeindexed
var indexedCount = 0
var deindexedCount = 0
var deindexSawIndex = 0
unit recursiveUnit = null
unit nestedUnit = null
var recursiveCalls = 0
var nestedCalls = 0
var attemptedRecursion = false

function reentrantDeindexTest()
	let u = getIndexingUnit()
	if u == recursiveUnit
		recursiveCalls++
		u.getIndex().assertGreaterThan(0)
		if not attemptedRecursion
			attemptedRecursion = true
			u.deindex().assertFalse()
			nestedUnit.deindex().assertTrue()
			(getIndexingUnit() == u).assertTrue()
	else if u == nestedUnit
		nestedCalls++

@Test function reentrantDeindexPreservesHooksAndOtherUnits()
	onUnitDeindex(function reentrantDeindexTest)
	recursiveUnit = newTestUnit()
	nestedUnit = newTestUnit()
	recursiveUnit.toUnitIndex()
	nestedUnit.toUnitIndex()
	recursiveCalls = 0
	nestedCalls = 0
	attemptedRecursion = false
	recursiveUnit.deindex().assertTrue()
	recursiveCalls.assertEquals(1)
	nestedCalls.assertEquals(1)
	recursiveUnit.getIndex().assertEquals(0)
	nestedUnit.getIndex().assertEquals(0)
	(getIndexingUnit() == null).assertTrue()
	// The allocator must still issue distinct live ids after nested cleanup.
	let a = newTestUnit()
	let b = newTestUnit()
	(a.toUnitIndex() != b.toUnitIndex()).assertTrue()
	a.deindex()
	b.deindex()
	recursiveUnit.remove()
	nestedUnit.remove()
	recursiveUnit = null
	nestedUnit = null
	a.remove()
	b.remove()

function onIndexedTest()
	seenIndexed[indexedCount] = getIndexingUnit()
	indexedCount++

function onDeindexedTest()
	seenDeindexed[deindexedCount] = getIndexingUnit()
	deindexSawIndex = getIndexingUnit().getIndex()
	deindexedCount++

function newTestUnit() returns unit
	return createUnit(players[0], 'hfoo', ZERO2, angle(0))

@Test function toUnitIndexIsStableAndDistinct()
	let a = newTestUnit()
	let b = newTestUnit()
	a.getIndex().assertEquals(0)
	let ia = a.toUnitIndex().getIndex()
	let ib = b.toUnitIndex().getIndex()
	ia.assertGreaterThan(0)
	ib.assertGreaterThan(0)
	(ia != ib).assertTrue()
	a.toUnitIndex().getIndex().assertEquals(ia)
	a.getIndex().assertEquals(ia)
	(a.toUnitIndex().getUnit() == a).assertTrue()
	a.deindex()
	b.deindex()

@Test function deindexReportsOnceAndClearsTheIndex()
	let u = newTestUnit()
	u.deindex().assertFalse()
	u.toUnitIndex()
	u.deindex().assertTrue()
	u.getIndex().assertEquals(0)
	u.deindex().assertFalse()

@Test function reindexingGivesALiveIndex()
	let u = newTestUnit()
	u.toUnitIndex()
	u.deindex()
	u.toUnitIndex()
	u.getIndex().assertGreaterThan(0)
	u.deindex()

@Test function listenersSeeTheIndexingUnit()
	onUnitIndex(function onIndexedTest)
	onUnitDeindex(function onDeindexedTest)
	let before = indexedCount
	let beforeDe = deindexedCount
	let u = newTestUnit()
	u.toUnitIndex()
	indexedCount.assertEquals(before + 1)
	(seenIndexed[before] == u).assertTrue()
	u.deindex()
	deindexedCount.assertEquals(beforeDe + 1)
	(seenDeindexed[beforeDe] == u).assertTrue()
	// The index is still set while the deindex listeners run, and gone afterwards.
	deindexSawIndex.assertGreaterThan(0)
	u.getIndex().assertEquals(0)
	(getIndexingUnit() == null).assertTrue()
