package TimerUtils
import NoWurst
import ErrorHandling
import Basics
import ArrayList
import CodeList
import HashMap
import KeyedMap
import Trigger
import public Timer

/* Basic Timer Recycling and data attachment */

timer array freeTimers
int freeTimersCount = 0
constant timerData = new Table()
// On Lua the data lives in a KeyedMap keyed by the timer itself: one table
// index, instead of a Table access through the timer's handle id. Every
// closure timer attaches its callback here when it starts and reads it back
// when it expires. The Jass path above is unchanged.
constant luaTimerData = keyedMapCreate()
constant HELD = 0x28829022

/** Attach Data to this timer */
public function timer.setData(int data)
	if isLua
		keyedMapPut(luaTimerData, this, data)
	else
		timerData.saveInt(this.getTCHandleId(), data)

/** Retrieve the data attached to this timer */
public function timer.getData() returns int
	if isLua
		return keyedMapGetInt(luaTimerData, this)
	return timerData.loadInt(this.getTCHandleId())

/** Get a new timer. Use this instead of "CreateTimer".
You can attach data to the timer with .setData and retrieve it with .getData
If you're done with the timer, release it with .release */
public function getTimer() returns timer
	if freeTimersCount > 0
		freeTimersCount--
		freeTimers[freeTimersCount].setData(0)
		return freeTimers[freeTimersCount]
	else
		return CreateTimer()..setData(0)

/** Release the timer. Use this instead of "DestroyTimer" ! */
public function timer.release()
	if this == null
		error("Trying to release a null timer")
		return
	if this.getData() == HELD
		error("ReleaseTimer: Double free!")
		return
	this.setData(HELD)
	this.pause()
	freeTimers[freeTimersCount] = this
	freeTimersCount++


/* TimedLoop for classes */

/*	One TimedLoop class, as the timer of its period sees it. Jass keeps the loop as a condition of the timer's
	trigger. On Lua that condition would be a call from the engine into the script per class and tick, so the
	loop is a CodeList instead and the timer calls it directly. */
class TimedLoopEntry
	/** The Lua form: a list of the one loop function. */
	CodeList list = null
	/** The Jass form: the condition, and the registration of it while the entry is active. */
	conditionfunc filter = null
	triggercondition condition = null

	construct(code onTick)
		if isLua
			list = new CodeList()
			list.add(onTick)
		else
			filter = Condition(onTick)

/** Runs the loops of one period from a single timer, in the order they became active. */
class TimedLoopTimer

	constant loopTimer = getTimer()..setData(this castTo int)
	/** Jass: the loops are the conditions of this trigger. */
	constant loopTrigger = CreateTrigger()
	/** Lua: the lists of the active loops. */
	constant loops = new ArrayList<CodeList>()
	/** Lua: the index of the loop which is running, so releasing one during a tick does not skip the next. */
	int running = -1
	/** Lua: how many of the loops the tick under way calls. The ones added meanwhile come after it. */
	int boundary = 0
	int conditionsCount = 0

	real period

	static constant timerMap = new HashMap<real,thistype>

	construct(real period)
		this.period = period

	static function get(real period) returns thistype
		var instance = timerMap.get(period)
		if instance == null
			instance = new TimedLoopTimer(period)
			timerMap.put(period, instance)
		return instance

	function add(TimedLoopEntry entry)
		if isLua
			loops.add(entry.list)
		else
			entry.condition = loopTrigger.addCondition(entry.filter)
		conditionsCount++
		if conditionsCount == 1
			loopTimer.startPeriodic(period, function triggerEval)

	static function triggerEval()
		let instance = GetExpiredTimer().getData() castTo thistype
		if isLua
			instance.runLoops()
		else
			instance.loopTrigger.evaluate()
		if instance.conditionsCount == 0
			instance.loopTimer.pause()

	/** Calls the active loops. One added meanwhile waits for the next tick, as a condition added to a trigger during
		its evaluation does. */
	function runLoops()
		boundary = loops.size()
		running = 0
		while running < boundary
			loops.get(running).run()
			running++
		running = -1
		boundary = 0

	function release(TimedLoopEntry entry)
		if isLua
			let index = loops.indexOf(entry.list)
			if index < 0
				return
			loops.removeAtOrdered(index)
			if index < boundary
				boundary--
			if index <= running
				// The loop which is running or one before it left, so the next has moved down to the index
				// which is running now.
				running--
		else
			loopTrigger.removeCondition(entry.condition)
			entry.condition = null
		conditionsCount--


public enum TimedLoopState
	RUNNING
	PAUSED
	STOPPED
	STOPPED_FOR_GOOD


public module TimedLoop
	static private thistype array instances
	static private int instanceCount = 0

	static private TimedLoopTimer timedLoopTimer
	static private TimedLoopEntry timedLoopEntry = null
	/** True from the first instance starting until the tick which finds none left. */
	static private bool timedLoopActive = false

	protected TimedLoopState timedLoopState = PAUSED
	/** True exactly while this instance has a slot in `instances`. Tracked
		separately from timedLoopState, because a stopped instance stays
		registered until the next tick sweeps it out, while an instance that was
		stopped before it ever started was never registered at all. */
	private bool timedLoopRegistered = false

	abstract function onTimedLoop()

	/** Returns the period of the timed loop.
		Overwrite this to set a custom period. It is read once, when the first
		instance of this class starts its loop. */
	function getPeriod() returns real
		return ANIMATION_PERIOD

	private static function onExpire() returns boolean
		int i = instanceCount - 1
		while i >= 0
			let t = instances[i]

			if t.timedLoopState != RUNNING
				instanceCount--
				instances[i] = instances[instanceCount]
				t.timedLoopRegistered = false
				if t.timedLoopState == STOPPED_FOR_GOOD
					t.timedLoopState = PAUSED
					destroy t
				else
					t.timedLoopState = PAUSED
			else
				t.onTimedLoop()
			i--

		if instanceCount == 0
			timedLoopTimer.release(timedLoopEntry)
			timedLoopActive = false
		return false

	/** Stops the periodic update of this object. */
	function stopTimedLoop()
		timedLoopState = STOPPED

	/** Stops the periodic update and destroys the object. */
	function stopTimedLoopAndDestroy()
		timedLoopState = STOPPED_FOR_GOOD

	/** Starts the periodic updates for this object.
		Calling this on an already running instance has no effect. */
	function startTimedLoop()
		timedLoopState = RUNNING
		if timedLoopRegistered
			// Already holds a slot, either because it is running or because it
			// was stopped and this tick's sweep has not removed it yet.
			// Registering again would run onTimedLoop twice per tick and leave a
			// stale slot behind once the object is stopped or destroyed.
			return
		timedLoopRegistered = true
		instances[instanceCount] = this
		instanceCount++
		if instanceCount == 1
			if not timedLoopActive
				timedLoopTimer = TimedLoopTimer.get(getPeriod())
				if timedLoopEntry == null
					timedLoopEntry = new TimedLoopEntry(function onExpire)
				timedLoopTimer.add(timedLoopEntry)
				timedLoopActive = true

	ondestroy
		if timedLoopState != PAUSED
			stopTimedLoop()
