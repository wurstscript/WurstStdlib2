package UnitIndexer
import OnUnitEnterLeave
import KeyedMap
import CodeList
import UnitLifecycleTrace
import ErrorHandling

/* Unit identity is assigned by native entry, before ordinary onEnter consumers.
 * The constructor stores the association before firing onUnitIndex. Death keeps
 * the identity; OnUnitEnterLeave owns release when the unit leaves the map.
 *
 * getIndex() and toUnitIndex() only read existing identity. Missing/stale identity
 * is a critical error; neither lookup allocates or repairs it. peekIndex() is
 * reserved for lifecycle infrastructure and diagnostics that must observe absence.
 * Manual deindex/destruction is not a gameplay operation.
 *
 * Lua stores the unit itself as a KeyedMap key and its Wurst allocation id as
 * value. Jass uses the native user-data slot, which no other system may write.
 * The Jass array limit does not apply to Lua's unit-keyed table.
 */

// Listeners run as a CodeList: a call each on Lua, a trigger condition each on Jass.
let onIndexList = new CodeList()
let onDeindexList = new CodeList()

/* Unit stack for nested usage */
unit array tempUnits
var tempUnitsCount = 0

function pushUnit(unit u)
	tempUnits[tempUnitsCount] = u
	tempUnitsCount++

function popUnit()
	tempUnitsCount--

// On the Jass target the native per-unit user-data slot is the fastest option
// available and is kept as-is. On Lua, use a KeyedMap: the compiler lowers it
// to one native table keyed by the unit itself, so a lookup is a single index
// with no handle-id round trip. Both paths default an unindexed unit to 0.
let luaUnitIndices = keyedMapCreate()

function unit.getStoredIndex() returns int
	if isLua
		return keyedMapGetInt(luaUnitIndices, this)
	return this.getUserData()

function unit.setStoredIndex(int value)
	if isLua
		if value == 0
			keyedMapRemove(luaUnitIndices, this)
		else
			keyedMapPut(luaUnitIndices, this, value)
	else
		this.setUserData(value)

@configurable public function shouldIndex(unit _u) returns boolean
	return true

/** Read-only lifecycle/diagnostic observation. Zero means no association exists.
    Never allocates or dispatches; normal consumers require getIndex instead. */
@configurable public function unit.peekIndex() returns int
	return this.getStoredIndex()

/**  Returns the int index of this unit. A missing or stale association is a critical error.
	Can be configured by the user to supply a custom unit indexer which won't break
	other stdlib components, as long as it keeps firing onUnitIndex and onUnitDeindex:
	UnitSpatialIndex, for one, registers units only through them. */
@configurable public function unit.getIndex() returns int
	let index = this.getStoredIndex()
	if index == 0
		error("UnitIndexer: missing unit index; native entry did not establish identity")
	else if (index castTo UnitIndex).getUnit() != this
		error("UnitIndexer: stale unit index; identity does not match")
		return 0
	return index

/** Returns the existing UnitIndex. Lookup never creates an index or fires onUnitIndex. */
@configurable public function unit.toUnitIndex() returns UnitIndex
	return this.getIndex() castTo UnitIndex

/**	Returns the currently indexing unit.
	That's the last indexed unit or
	the one about to be deindexed. */
public function getIndexingUnit() returns unit
	if tempUnitsCount <= 0
		return null
	return tempUnits[tempUnitsCount - 1]

/**  Adds a function to be called before a unit is deindexed.
	Use the getIndexingUnit() function to refer to the deindexing unit. */
public function onUnitDeindex(code func)
	onDeindexList.add(func)
	traceUnitLifecycle(UnitLifecyclePhase.DEINDEX_LISTENER_REGISTERED, null, 0)

/**  Adds a function to be called after a unit is indexed.
	Use the getIndexingUnit() function to refer to the indexed unit. */
public function onUnitIndex(code func)
	onIndexList.add(func)
	traceUnitLifecycle(UnitLifecyclePhase.INDEX_LISTENER_REGISTERED, null, 0)

/**  Deindexes a unit.
	Returns false if the unit is unindexed or a deindex hook is already releasing it. */
public function unit.deindex() returns bool
	if this.getStoredIndex() == 0
		return false
	else
		return this.toUnitIndex().deindex()

public class UnitIndex
	protected unit _unit
	private bool deindexing = false

	/** Deindexes the unit, returning false if a deindex hook is already releasing it. */
	function deindex() returns bool
		if deindexing
			return false
		destroy this
		return true

	function getUnit() returns unit
		return this._unit

	function getIndex() returns int
		return this castTo int

	construct(unit whichUnit)
		this._unit = whichUnit
		this._unit.setStoredIndex(this castTo int)
		traceUnitLifecycle(UnitLifecyclePhase.INDEX_STORED, whichUnit, tempUnitsCount)
		pushUnit(whichUnit)
		onIndexList.run()
		traceUnitLifecycle(UnitLifecyclePhase.INDEX_DISPATCH_END, whichUnit, tempUnitsCount)
		popUnit()

	ondestroy
		deindexing = true
		traceUnitLifecycle(UnitLifecyclePhase.DEINDEX_BEGIN, this._unit, tempUnitsCount)
		pushUnit(this._unit)
		onDeindexList.run()
		popUnit()
		this._unit.setStoredIndex(0)
		traceUnitLifecycle(UnitLifecyclePhase.DEINDEX_END, this._unit, tempUnitsCount)

function indexEnteringUnit()
	let u = getEnterLeaveUnit()
	traceUnitLifecycle(UnitLifecyclePhase.INDEX_LISTENER, u, tempUnitsCount)
	if shouldIndex(u)
		let existing = u.getStoredIndex()
		if existing == 0
			let _index = new UnitIndex(u)
		else if (existing castTo UnitIndex).getUnit() != u
			error("UnitIndexer: entering unit has a stale index association")

// Auto instanciation/destruction
init
	onEnterIndex(function indexEnteringUnit)
	// A unit that leaves loses its index even when shouldIndex would not index it now: it may have been
	// indexed through toUnitIndex(), or the predicate may have changed since it entered, and an index
	// that outlives its unit leaks, along with everything keyed by it.
	onLeave(() -> getEnterLeaveUnit().deindex())
