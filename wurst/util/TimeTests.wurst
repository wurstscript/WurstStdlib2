package TimeTests
import Time


@Test function testDisplay()
	print(1..hours().displayVerbose())
	assertTrue(.1.seconds().displayVerbose() == "100 milliseconds")
	assertTrue(1.1.seconds().displayVerbose() == "1 seconds")
	assertTrue(61..seconds().display() == "PT1M1S")
	assertTrue(1..hours().displayVerbose() == "1 hours, 0 minutes, and 0 seconds")


@Test function testNewerThan()
	assertTrue(5..minutesFromNow().isNewerThan(5..secondsFromNow()))
	assertTrue(5..minutesFromNow().isInTheFuture())


/** Built from explicit timestamps rather than instantNow(), because the
	compiletime interpreter's game clock is a unix epoch value whose 32 bit
	real precision swallows small offsets. See GameTimer.getElapsedGameTime. */
@Test function testInstantComparisons()
	let earlier = instant(10.)
	let later = instant(20.)

	earlier.isOlderThan(later).assertTrue()
	later.isNewerThan(earlier).assertTrue()
	later.isOlderThan(earlier).assertFalse()
	earlier.isNewerThan(later).assertFalse()
	earlier.isOlderThan(earlier).assertFalse()
	earlier.isNewerThan(earlier).assertFalse()

	(later - earlier).seconds.assertEquals(10., 0.0001)


/** Negative durations used to render as "0", because every component was
	gated behind a "> 0" check. */
@Test function testNegativeDurationDisplay()
	(-61.).seconds().displayVerbose().assertEquals("-1 minutes, and 1 seconds")
	(-1.).hours().display().assertEquals("-PT1H0M0S")
	(0.).seconds().displayVerbose().assertEquals("0")
	(61.).seconds().displayVerbose().assertEquals("1 minutes, and 1 seconds")


@Test function testDurationArithmetic()
	(5..minutes() + 5..minutes()).seconds.assertEquals(600., 0.0001)
	(5..minutes() - 2..minutes()).seconds.assertEquals(180., 0.0001)
	(2..hours()).seconds.assertEquals(7200., 0.0001)
	(1.5).minutes().seconds.assertEquals(90., 0.0001)
	5..minutes().greaterThan(5..seconds()).assertTrue()
	5..seconds().lessThan(5..minutes()).assertTrue()
	5..seconds().lessThan(5..seconds()).assertFalse()

@Test function testInstantDurationArithmetic()
	let start = instant(100.)
	(start + 30..seconds()).timestamp_seconds.assertEquals(130., 0.0001)
	(start - 30..seconds()).timestamp_seconds.assertEquals(70., 0.0001)
	(30..seconds() + start).timestamp_seconds.assertEquals(130., 0.0001)
	(start - instant(40.)).seconds.assertEquals(60., 0.0001)

@Test function testDisplayBoundaries()
	59..seconds().displayVerbose().assertEquals("59 seconds")
	60..seconds().displayVerbose().assertEquals("1 minutes, and 0 seconds")
	3599..seconds().displayVerbose().assertEquals("59 minutes, and 59 seconds")
	3600..seconds().displayVerbose().assertEquals("1 hours, 0 minutes, and 0 seconds")
	59..seconds().display().assertEquals("PT59S")
	60..seconds().display().assertEquals("PT1M0S")
	3599..seconds().display().assertEquals("PT59M59S")
	3600..seconds().display().assertEquals("PT1H0M0S")
	59..seconds().display("T-").assertEquals("T-59S")
