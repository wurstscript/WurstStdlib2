package StringUtilsTests
import StringUtils

import LinkedList
import ObjectIds

@Test function testSplit()
	var list = "this is a string".split(" ")
	list.get(0).assertEquals("this")
	list.get(1).assertEquals("is")
	list.get(2).assertEquals("a")
	list.get(3).assertEquals("string")
	destroy list

	list = "this,is,a,string".split(",")
	list.get(0).assertEquals("this")
	list.get(1).assertEquals("is")
	list.get(2).assertEquals("a")
	list.get(3).assertEquals("string")
	destroy list

	list = "thisisastring".split(" ")
	(list.size() == 1).assertTrue()
	destroy list

@Test function splitToArrayPreservesEmptyFieldsAndMultiCharacterDelimiters()
	let fields = "::alpha::::beta::".splitToArray("::")
	fields.size().assertEquals(5)
	fields.get(0).assertEquals("")
	fields.get(1).assertEquals("alpha")
	fields.get(2).assertEquals("")
	fields.get(3).assertEquals("beta")
	fields.get(4).assertEquals("")
	destroy fields
	let empty = "".splitToArray(",")
	empty.size().assertEquals(1)
	empty.get(0).assertEquals("")
	destroy empty
	let unchanged = "alpha".splitToArray("")
	unchanged.size().assertEquals(1)
	unchanged.get(0).assertEquals("alpha")
	destroy unchanged

@Test function splitToArrayPreservesNullInput()
	string input = null
	let fields = input.splitToArray(",")
	fields.size().assertEquals(1)
	(fields.get(0) == null).assertTrue()
	destroy fields

@Test function testJoin()
	let list = new LinkedList<string>()
		..add("this", "is", "a", "string")

	list.join().assertEquals("thisisastring")
	list.joinBy(" ").assertEquals("this is a string")

	destroy list

@Test function testReduce()
	"reee      duu   cee".reduce("e").reduce("u").reduce(" ").assertEquals("re du ce")
	"redu      ce".reduce().assertEquals("redu ce")

@Test function testChar()
	char("/").toInt().assertEquals(47)
	char("\\").toInt().assertEquals(92)
	char("|").toInt().assertEquals(124)

@Test function testCreateDelimitedString_ForEachIn()
	let str = commaList("a", "b", "c")

	let l = new LinkedList<string>()
	str.forEachIn(",") (string str) ->
		l.add(str)
	l.has("a").assertTrue()
	l.has("b").assertTrue()
	l.has("c").assertTrue()


@Test function testIsNumber_IsValidLength()
	"a".isNumber().assertFalse()
	"1".isNumber().assertTrue()
	"259812".isNumber().assertTrue()
	"251a52".isNumber().assertFalse()
	"1251FDSFA".isValidDescription().assertTrue()
	"-1232.32".isNumber().assertTrue()
	"-1231.3a1".isNumber().assertFalse()

@Test function testIsNumberRequiresADigit()
	// a sign or decimal point alone used to be accepted as a number
	"-".isNumber().assertFalse()
	"-.".isNumber().assertFalse()
	".".isNumber().assertFalse()
	"".isNumber().assertFalse()
	"-0".isNumber().assertTrue()
	".5".isNumber().assertTrue()
	"-.5".isNumber().assertTrue()
	"1.2.3".isNumber().assertFalse()
	"1-2".isNumber().assertFalse()
	
@Test function testReplaceChars()
	"abca".replaceChars("ca", "d").assertEquals("dbdd")

function collectForEachIn(string s, string delim) returns string
	let fields = new LinkedList<string>()
	s.forEachIn(delim) (string field) ->
		fields.add(field)
	var joined = ""
	for field in fields
		joined += "[" + field + "]"
	destroy fields
	return joined

function joinedSplit(string s, string delim) returns string
	let fields = s.split(delim)
	var joined = ""
	for field in fields
		joined += "[" + field + "]"
	destroy fields
	return joined

@Test function forEachInAdvancesByDelimiterLength()
	collectForEachIn("a::b", "::").assertEquals("[a][b]")
	collectForEachIn("a::b::c", "::").assertEquals(joinedSplit("a::b::c", "::"))
	collectForEachIn("a,b,", ",").assertEquals(joinedSplit("a,b,", ","))
	collectForEachIn("a,,b", ",").assertEquals("[a][][b]")
	collectForEachIn("abc", ",").assertEquals("[abc]")
	collectForEachIn("", ",").assertEquals("")

@Test function forEachInEmptyDelimiterYieldsWholeString()
	collectForEachIn("abc", "").assertEquals("[abc]")

@Test function splitEmptyDelimiterReturnsWholeString()
	let fields = "abc".split("")
	fields.size().assertEquals(1)
	fields.get(0).assertEquals("abc")
	destroy fields

@Test function splitEdgeCases()
	joinedSplit("a,,b", ",").assertEquals("[a][][b]")
	joinedSplit("a,", ",").assertEquals("[a][]")
	joinedSplit("", ",").assertEquals("[]")
	joinedSplit("a::b", "::").assertEquals("[a][b]")

@Test function replaceCharsIsSinglePass()
	"ab".replaceChars("ab", "ba").assertEquals("baba")
	"a-b_c".replaceChars("-_", " ").assertEquals("a b c")
	"abc".replaceChars("", "x").assertEquals("abc")
	"abc".replaceChars("xyz", "q").assertEquals("abc")

@Test function charRoundTrip()
	for i = 32 to 126
		char(i).toString().toChar().toInt().assertEquals(i)
		i.toChar().toInt().assertEquals(i)
