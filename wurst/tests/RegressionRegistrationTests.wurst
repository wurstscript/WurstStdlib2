package RegressionRegistrationTests
import ClosureEvents
import UnitIndexer
import UnitIds
import AbilityIds

@Test function spellRegistrationIndexesAnUnindexedUnit()
	let u = createUnit(players[0], UnitIds.footman, ZERO2, angle(0.))
	u.deindex()
	u.getIndex().assertEquals(0)
	let listener = EventListener.onCast(u, AbilityIds.berserkerRage1) (_) ->
		skip
	u.getIndex().assertGreaterThan(0)
	(EventListener.castMapCasters[u.getIndex()] == listener).assertTrue()
	destroy listener
	(EventListener.castMapCasters[u.getIndex()] == null).assertTrue()
	u.remove()
