package RegressionRegistrationTests
import ClosureEvents
import UnitIndexer
import UnitIds
import AbilityIds

function ignoreRegistrationCast(unit _caster)
	skip

// The native fixture proves deferred binding, late index hooks and cancellation with object-id reuse.
@Test function pendingCastRegistrationDoesNotIndexTheUnit()
	let u = createUnit(players[0], UnitIds.footman, ZERO2, angle(0.))
	u.peekIndex().assertEquals(0)
	OnCastListener listener = caster -> ignoreRegistrationCast(caster)
	OnCastListener.deferRegistration(u, AbilityIds.berserkerRage1, listener)
	u.peekIndex().assertEquals(0)
	(EventListener.castMapCasters[0] == null).assertTrue()
	destroy listener
	// Model native entry explicitly; public lookup is never an allocator.
	new UnitIndex(u)
	(EventListener.castMapCasters[u.getIndex()] == null).assertTrue()
	u.remove()
