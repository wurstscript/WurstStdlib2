package PriorityQueueTests

import ArrayList
import PriorityQueue

constant Comparator<int> maxIntComparator = (a, b) -> a > b ? -1 : (a < b ? 1 : 0)

@Test
function priorityQueueReturnsSmallestFirst()
    let queue = new PriorityQueue<int>(intComparator)
    queue.add(7)
    queue.add(2)
    queue.add(5)
    queue.add(2)

    queue.peek().assertEquals(2)
    queue.size().assertEquals(4)
    queue.poll().assertEquals(2)
    queue.poll().assertEquals(2)
    queue.poll().assertEquals(5)
    queue.poll().assertEquals(7)
    queue.isEmpty().assertTrue()
    destroy queue

@Test
function priorityQueueSupportsMaxHeapComparator()
    let queue = new PriorityQueue<int>(maxIntComparator)
    queue.offer(3)
    queue.offer(9)
    queue.offer(1)

    queue.remove().assertEquals(9)
    queue.remove().assertEquals(3)
    queue.remove().assertEquals(1)
    destroy queue

@Test
function priorityQueueClearRetainsUsability()
    let queue = new PriorityQueue<int>(intComparator, 2)
    queue.add(4)
    queue.add(1)
    queue.clear()
    queue.isEmpty().assertTrue()
    queue.add(6)
    queue.peek().assertEquals(6)
    queue.size().assertEquals(1)
    destroy queue

@Test
function priorityQueueHandlesEmptyAndGrowth()
    let queue = new PriorityQueue<int>(intComparator, 1)
    queue.isEmpty().assertTrue()
    queue.size().assertEquals(0)
    queue.peek()
    queue.poll()

    for i = 0 to 31
        queue.add((i * 17) mod 32)
    queue.size().assertEquals(32)
    for expected = 0 to 31
        queue.poll().assertEquals(expected)
    queue.isEmpty().assertTrue()
    destroy queue

@Test
function priorityQueueInterleavedMatchesSortedReference()
    let queue = new PriorityQueue<int>(intComparator)
    // reference model: an unsorted list from which the minimum is removed on poll
    let reference = new ArrayList<int>()
    for i = 0 to 199
        let value = (i * 37 + 11) mod 101
        queue.add(value)
        reference.add(value)
        if i mod 3 == 2
            var minIndex = 0
            for j = 1 to reference.size() - 1
                if reference.get(j) < reference.get(minIndex)
                    minIndex = j
            let minimum = reference.get(minIndex)
            reference.removeAtUnordered(minIndex)
            queue.poll().assertEquals(minimum)
            queue.size().assertEquals(reference.size())

    reference.sort()
    for i = 0 to reference.size() - 1
        queue.poll().assertEquals(reference.get(i))
    queue.isEmpty().assertTrue()
    destroy reference
    destroy queue

class PriorityQueueEntry
    int priority
    int id

    construct(int priority, int id)
        this.priority = priority
        this.id = id

@Test
function priorityQueueEqualPrioritiesAreEachReturnedOnce()
    let queue = new PriorityQueue<PriorityQueueEntry>((a, b) -> a.priority < b.priority ? -1 : (a.priority > b.priority ? 1 : 0))
    let seen = new ArrayList<int>()
    for id = 0 to 9
        queue.add(new PriorityQueueEntry(id mod 2, id))

    var lastPriority = -1
    while not queue.isEmpty()
        let entry = queue.poll()
        (entry.priority >= lastPriority).assertTrue()
        lastPriority = entry.priority
        seen.has(entry.id).assertFalse()
        seen.add(entry.id)
        destroy entry

    seen.size().assertEquals(10)
    destroy seen
    destroy queue

@Test
function priorityQueueHandlesIntExtremes()
    let queue = new PriorityQueue<int>(intComparator)
    queue.add(INT_MAX)
    queue.add(0)
    queue.add(INT_MIN)
    queue.add(-1)
    queue.poll().assertEquals(INT_MIN)
    queue.poll().assertEquals(-1)
    queue.poll().assertEquals(0)
    queue.poll().assertEquals(INT_MAX)
    queue.isEmpty().assertTrue()
    destroy queue
