package HashSet
import public HashList
import ErrorHandling

/** Generic set implementation */
public class HashSet<T> extends HashList<T>
	private static constant position = compiletime(InitHashtable())

	/** Adds an element to this set */
	override function add(vararg T elems)
		for elem in elems
			if count(elem) <= 0
				position.saveInt(this castTo int, elem castTo int, size())
				super.add(elem)

	/** Replaces an element or appends at size(). An already-present value is a no-op.
		Sparse indexes are rejected: repeated null padding would violate set uniqueness. */
	override function set(int index, T elem)
		if index < 0 or index > size()
			error("HashSet: Index out of bounds: " + index)
			return
		if has(elem)
			return
		if index == size()
			add(elem)
		else
			position.removeInt(this castTo int, get(index) castTo int)
			super.set(index, elem)
			position.saveInt(this castTo int, elem castTo int, index)

	/** Removes an element from this set if present */
	override function remove(T elem) returns boolean
		var result = false
		if count(elem) > 0
			removeAt(position.loadInt(this castTo int, elem castTo int))
			result = true
		return result

	/** Remove the element at the given index.
		Indices outside [0, size) are an error. */
	override function removeAt(int index) returns T
		if index < 0 or index >= size()
			error("HashSet: Index out of bounds: " + index)
			return null
		position.removeInt(this castTo int, get(index) castTo int)
		for i = index + 1 to size() - 1
			position.saveInt(this castTo int, get(i) castTo int, i - 1)
		return super.removeAt(index)

	/** Removes matching elements in linear time and rebuilds the compacted indexes. */
	override function removeIf(RemovePredicate<T> predicate)
		super.removeIf(predicate)
		position.flushChild(this castTo int)
		for i = 0 to size() - 1
			position.saveInt(this castTo int, get(i) castTo int, i)

	override function clear()
		super.clear()
		position.flushChild(this castTo int)

	ondestroy
		position.flushChild(this castTo int)

