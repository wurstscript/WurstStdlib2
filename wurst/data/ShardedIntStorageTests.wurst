package ShardedIntStorageTests
import ShardedIntStorage

@Test function allocationReadsAndWritesAcrossNativeArrayBoundary()
	let size = JASS_MAX_ARRAY_SIZE + 2
	let start = ShardedIntStorage.allocate(size)
	ShardedIntStorage.set(start + JASS_MAX_ARRAY_SIZE - 1, 41)
	ShardedIntStorage.set(start + JASS_MAX_ARRAY_SIZE, 42)
	ShardedIntStorage.get(start + JASS_MAX_ARRAY_SIZE - 1).assertEquals(41)
	ShardedIntStorage.get(start + JASS_MAX_ARRAY_SIZE).assertEquals(42)
	ShardedIntStorage.release(start, size)

@Test function releasedAdjacentRangesAreCoalescedAndReused()
	let first = ShardedIntStorage.allocate(10)
	let second = ShardedIntStorage.allocate(20)
	ShardedIntStorage.release(second, 20)
	ShardedIntStorage.release(first, 10)
	let combined = ShardedIntStorage.allocate(30)
	combined.assertEquals(first)
	ShardedIntStorage.release(combined, 30)

@Test function oversizedAllocationCanFailWithoutAbortingCaller()
	ShardedIntStorage.tryAllocate(ShardedIntStorage.capacity() + 1).assertEquals(-1)

@Test function firstFitSplitsAFreeRange()
	let first = ShardedIntStorage.allocate(10)
	let second = ShardedIntStorage.allocate(5)
	let third = ShardedIntStorage.allocate(10)
	ShardedIntStorage.release(first, 10)

	// the freed range sits before a live allocation, so it is split first-fit
	let head = ShardedIntStorage.allocate(4)
	head.assertEquals(first)
	let tail = ShardedIntStorage.allocate(6)
	tail.assertEquals(first + 4)

	ShardedIntStorage.release(head, 4)
	ShardedIntStorage.release(tail, 6)
	ShardedIntStorage.release(second, 5)
	ShardedIntStorage.release(third, 10)
	// everything is back, so the arena is empty again
	let probe = ShardedIntStorage.allocate(1)
	probe.assertEquals(first)
	ShardedIntStorage.release(probe, 1)

@Test function releaseCoalescesWithPreviousFreeRangeOnly()
	let a = ShardedIntStorage.allocate(4)
	let b = ShardedIntStorage.allocate(4)
	let c = ShardedIntStorage.allocate(4)
	ShardedIntStorage.release(a, 4)
	ShardedIntStorage.release(b, 4)
	let merged = ShardedIntStorage.allocate(8)
	merged.assertEquals(a)
	ShardedIntStorage.release(merged, 8)
	ShardedIntStorage.release(c, 4)

@Test function releaseCoalescesWithNextFreeRangeOnly()
	let a = ShardedIntStorage.allocate(4)
	let b = ShardedIntStorage.allocate(4)
	let c = ShardedIntStorage.allocate(4)
	let d = ShardedIntStorage.allocate(4)
	ShardedIntStorage.release(c, 4)
	ShardedIntStorage.release(b, 4)
	let merged = ShardedIntStorage.allocate(8)
	merged.assertEquals(b)
	ShardedIntStorage.release(merged, 8)
	ShardedIntStorage.release(a, 4)
	ShardedIntStorage.release(d, 4)

@Test function trailingReleaseIsReusedAsFreshStorage()
	let a = ShardedIntStorage.allocate(4)
	let b = ShardedIntStorage.allocate(4)
	ShardedIntStorage.release(b, 4)
	let again = ShardedIntStorage.allocate(4)
	again.assertEquals(b)
	ShardedIntStorage.release(again, 4)
	ShardedIntStorage.release(a, 4)
	let probe = ShardedIntStorage.allocate(1)
	probe.assertEquals(a)
	ShardedIntStorage.release(probe, 1)
