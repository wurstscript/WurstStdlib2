package HashListTests
import HashList

@Test
function testAdd()
	let list = new HashList<int>
	list.add(5)
	list.get(0).assertEquals(5)

@Test
function testSet()
	let list = new HashList<int>
	list.add(3)
	list.add(5)
	list.set(1, 6)
	list.get(1).assertEquals(6)

	list.set(3, 42)
	list.get(3).assertEquals(42)
	// resize when index out of size
	list.size().assertEquals(4)
	// elem insert use null
	list.hasAt(2).assertTrue()
	list.get(2).assertEquals(0)
	list.has(0).assertTrue()
	list.count(0).assertEquals(1)

	list.set(3, 42)
	// not resize
	list.size().assertEquals(4)
	// un-inserted
	list.count(0).assertEquals(1)

@Test
function testAddAll()
	let vals = [5, 3, 6, 4, 1, 9]
	let list = new HashList<int>
		..add(5, 3, 6)

	let addl = new HashList<int>
		..add(4, 1, 9)

	list.addAll(addl)
	var i = 0
	for val in list
		val.assertEquals(vals[i])
		i++

	list.get(4).assertEquals(1)

@Test
function testClear()
	let list = new HashList<int>
		..add(5, 3, 4)

	list.clear()
	list.size().assertEquals(0)

@Test
function testRemoveAll()
	let list = new HashList<int>
		..add(5, 3, 4)

	list.clear()
	list.size().assertEquals(0)

@Test
function testRemoveAt()
	let list = new HashList<int>
		..add(3, 5)

	list.removeAt(1)
	list.get(0).assertEquals(3)
	list.get(1).assertEquals(0)

@Test
function testRemoveAtShiftEnd()
	let list = new HashList<int>
		..add(1, 2, 3)
	list.removeAt(1)
	list.size().assertEquals(2)
	list.get(0).assertEquals(1)
	list.get(1).assertEquals(3)

@Test
function testRemove()
	let list = new HashList<int>
		..add(1, 3, 5)

	list.remove(3)
	list.get(0).assertEquals(1)
	list.get(1).assertEquals(5)

@Test
function testSize()
	let list = new HashList<int>
	list.size().assertEquals(0)
	list
		..add(5, 3, 1)
	list.size().assertEquals(3)

@Test
function testIsEmpty()
	let list = new HashList<int>
	list.isEmpty().assertEquals(true)
	list.add(1)
	list.isEmpty().assertEquals(false)

@Test
function testGet()
	let list = new HashList<int>
		..add(5, 1, 3)

	list.get(1).assertEquals(1)

@Test
function testHas()
	let list = new HashList<int>
		..add(1, 3, 5)

	list.has(3).assertEquals(true)
	list.add(3)
	list.remove(3)
	list.has(3).assertEquals(true)
	list.remove(3)
	list.has(3).assertEquals(false)
	list.has(9).assertEquals(false)

@Test
function testIterator()
	let list = new HashList<int>
	let vals = [1, 3, 5]
	var i = 0

	list
		..add(1, 3, 5)

	for val in list
		val.assertEquals(vals[i])
		i++

@Test
function testCopy()
	let list = new HashList<int>
		..add(1, 3, 5)

	let copy = list.copy()
	var i = 0

	for val in list
		val.assertEquals(copy.get(i))
		i++

@Test
function testCopyConstructor()
	let list = new HashList<int>
		..add(1, 3, 5)

	let copy = new HashList<int>(list)
	var i = 0

	for val in list
		val.assertEquals(copy.get(i))
		i++

@Test
function testHasAt()
	let list = new HashList<int>
		..add(1, 3, 5, 7, 9)

	list.hasAt(4).assertTrue()
	list.hasAt(5).assertFalse()

	list.hasAt(-1).assertFalse()

	list..remove(3)..remove(9)

	list.hasAt(4).assertFalse()
	list.hasAt(2).assertTrue()

	list.hasAt(0).assertTrue()


var xn_1 = 0
var xn = 1
@Test
function testForEachFibonacci()
	let list = new HashList<int>
		..add(1, 1, 2, 3, 5, 8, 13, 21, 34)


	list.forEach() (entry) ->
		xn.assertEquals(entry)
		let oldxn = xn
		xn = xn + xn_1
		xn_1 = oldxn


@Test
function testRemoveIf()
	let list = new HashList<int>
		..add(1, 2, 3, 4, 5, 6)

	list.removeIf(i -> i mod 2 == 0)

	list.size().assertEquals(3)
	list.get(0).assertEquals(1)
	list.get(1).assertEquals(3)
	list.get(2).assertEquals(5)
	// the occurrence counters must track the removals
	list.has(2).assertFalse()
	list.has(4).assertFalse()
	list.has(6).assertFalse()
	list.has(1).assertTrue()
	list.has(5).assertTrue()

@Test
function testRemoveIfEdgeCases()
	let removeAll = new HashList<int>
		..add(1, 2, 3)
	removeAll.removeIf(_i -> true)
	removeAll.size().assertEquals(0)
	removeAll.isEmpty().assertTrue()

	let removeNone = new HashList<int>
		..add(1, 2, 3)
	removeNone.removeIf(_i -> false)
	removeNone.size().assertEquals(3)
	removeNone.get(2).assertEquals(3)

	let empty = new HashList<int>
	empty.removeIf(_i -> true)
	empty.size().assertEquals(0)

@Test
function testRemoveIfWithDuplicates()
	let list = new HashList<int>
		..add(1, 2, 1, 2, 1)
	list.count(1).assertEquals(3)
	list.removeIf(i -> i == 2)
	list.size().assertEquals(3)
	list.count(1).assertEquals(3)
	list.count(2).assertEquals(0)

@Test
function testIteratorRemove()
	let list = new HashList<int>
		..add(1, 1, 2, 3, 5, 8, 13, 21, 34)

	let itr = list.iterator()
	while itr.hasNext()
		let next = itr.next()
		if next > 2 and next < 25
			itr.remove()

	list.size().assertEquals(4)
	list.get(0).assertEquals(1)
	list.get(1).assertEquals(1)
	list.get(2).assertEquals(2)
	list.get(3).assertEquals(34)


@Test
function testRemoveAtBookkeeping()
	let list = new HashList<int>
	list.add(10, 20, 30, 20, 40)

	list.removeAt(0).assertEquals(10)
	list.size().assertEquals(4)
	list.has(10).assertFalse()
	list.get(0).assertEquals(20)

	list.removeAt(1).assertEquals(30)
	list.size().assertEquals(3)
	list.has(30).assertFalse()
	list.count(20).assertEquals(2)

	list.removeAt(list.size() - 1).assertEquals(40)
	list.size().assertEquals(2)
	list.has(40).assertFalse()

	list.removeAt(0).assertEquals(20)
	list.count(20).assertEquals(1)
	list.has(20).assertTrue()
	list.get(0).assertEquals(20)
	destroy list

@Test
function testIteratorRemoveBeforeNextIsIgnored()
	let list = new HashList<int>
	list.add(1, 2, 3)
	let itr = list.iterator()
	itr.remove()
	list.size().assertEquals(3)
	list.count(1).assertEquals(1)
	list.count(0).assertEquals(0)
	itr.next().assertEquals(1)
	itr.close()
	list.get(0).assertEquals(1)
	list.get(2).assertEquals(3)
	destroy list

@Test
function testIteratorRemoveTwiceRemovesOnlyOne()
	let list = new HashList<int>
	list.add(1, 2, 3)
	let itr = list.iterator()
	itr.next().assertEquals(1)
	itr.remove()
	itr.remove()
	itr.close()
	list.size().assertEquals(2)
	list.get(0).assertEquals(2)
	list.get(1).assertEquals(3)
	list.has(1).assertFalse()
	list.has(2).assertTrue()
	destroy list

@Test
function testIteratorRemoveWhileWalking()
	let list = new HashList<int>
	list.add(1, 2, 3, 4, 5, 6)
	let itr = list.iterator()
	while itr.hasNext()
		if itr.next() mod 2 == 0
			itr.remove()
	itr.close()
	list.size().assertEquals(3)
	list.get(0).assertEquals(1)
	list.get(1).assertEquals(3)
	list.get(2).assertEquals(5)
	list.has(4).assertFalse()
	destroy list

@Test
function testClearResetsCounts()
	let list = new HashList<int>
	list.add(1, 1, 2)
	list.clear()
	list.size().assertEquals(0)
	list.count(1).assertEquals(0)
	list.has(2).assertFalse()
	list.add(2)
	list.count(2).assertEquals(1)
	destroy list

@Test
function testSetOverwriteAdjustsCounts()
	let list = new HashList<int>
	list.add(5, 5, 7)
	list.set(0, 7)
	list.count(5).assertEquals(1)
	list.count(7).assertEquals(2)
	list.set(1, 9)
	list.has(5).assertFalse()
	list.count(9).assertEquals(1)
	list.size().assertEquals(3)
	destroy list

@Test
function testRemoveAbsentReturnsFalse()
	let list = new HashList<int>
	list.add(1, 2)
	list.remove(3).assertFalse()
	list.size().assertEquals(2)
	list.remove(2).assertTrue()
	list.size().assertEquals(1)
	list.has(2).assertFalse()
	destroy list

@Test
function testAddAllSelf()
	let list = new HashList<int>
	list.add(1, 2, 3)
	list.addAll(list)
	list.size().assertEquals(6)
	list.get(3).assertEquals(1)
	list.get(5).assertEquals(3)
	list.count(2).assertEquals(2)
	destroy list
