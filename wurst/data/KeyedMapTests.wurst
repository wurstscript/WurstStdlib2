package KeyedMapTests
import KeyedMap

@Test
function fastStringKeysAreCollisionSafe()
	let map = new FastKeyedMap<string, int>()
	let other = new FastKeyedMap<string, int>()
	// StringHash folds ASCII case, but string equality does not.
	StringHash("alpha").assertEquals(StringHash("ALPHA"))
	map.put("alpha", 42)
	map.put("ALPHA", 7)
	map.put("", 0)
	map.put("alpha", 43)
	map.get("alpha").assertEquals(43)
	map.get("ALPHA").assertEquals(7)
	map.has("").assertEquals(true)
	other.has("alpha").assertEquals(false)
	map.remove("alpha")
	map.remove("missing")
	map.has("alpha").assertEquals(false)
	map.get("ALPHA").assertEquals(7)
	map.remove("ALPHA")
	map.has("ALPHA").assertEquals(false)
	destroy map
	let reused = new FastKeyedMap<string, int>()
	reused.has("").assertEquals(false)
	destroy reused
	destroy other

class KeyedMapTestData
	int value

	construct(int value)
		this.value = value

@Test
function distinctUnitsGetDistinctEntries()
	let map = keyedMapCreate()
	let a = CreateUnit(Player(0), 'hfoo', 0., 0., 0.)
	let b = CreateUnit(Player(0), 'hfoo', 0., 0., 0.)
	keyedMapHas(map, a).assertEquals(false)
	keyedMapGetInt(map, a).assertEquals(0)
	keyedMapPut(map, a, 1)
	keyedMapPut(map, b, 2)
	keyedMapHas(map, a).assertEquals(true)
	keyedMapGetInt(map, a).assertEquals(1)
	keyedMapGetInt(map, b).assertEquals(2)
	keyedMapDestroy(map)

@Test
function overwriteAndRemove()
	let map = keyedMapCreate()
	let a = CreateUnit(Player(0), 'hfoo', 0., 0., 0.)
	let b = CreateUnit(Player(0), 'hfoo', 0., 0., 0.)
	keyedMapPut(map, a, 1)
	keyedMapPut(map, b, 2)
	keyedMapPut(map, a, 3)
	keyedMapGetInt(map, a).assertEquals(3)
	keyedMapRemove(map, a)
	keyedMapHas(map, a).assertEquals(false)
	keyedMapGetInt(map, a).assertEquals(0)
	keyedMapGetInt(map, b).assertEquals(2)
	keyedMapDestroy(map)

@Test
function nullKeyReadsAsAbsent()
	let map = keyedMapCreate()
	unit none = null
	keyedMapHas(map, none).assertEquals(false)
	keyedMapGetInt(map, none).assertEquals(0)
	keyedMapRemove(map, none)
	keyedMapHas(map, none).assertEquals(false)
	keyedMapDestroy(map)

@Test
function timerKeysGetTheirOwnEntries()
	let map = keyedMapCreate()
	let t = CreateTimer()
	let other = CreateTimer()
	keyedMapPut(map, t, 5)
	keyedMapPut(map, other, 6)
	keyedMapGetInt(map, t).assertEquals(5)
	keyedMapGetInt(map, other).assertEquals(6)
	keyedMapRemove(map, t)
	keyedMapHas(map, t).assertEquals(false)
	keyedMapGetInt(map, other).assertEquals(6)
	timer none = null
	keyedMapPut(map, none, 1)
	keyedMapHas(map, none).assertEquals(false)
	keyedMapDestroy(map)

@Test
function bareNullKeyStillCompilesAndReadsAbsent()
	let map = keyedMapCreate()
	keyedMapPut(map, null, 1)
	keyedMapHas(map, null).assertEquals(false)
	keyedMapGetInt(map, null).assertEquals(0)
	keyedMapRemove(map, null)
	keyedMapDestroy(map)

@Test
function fastKeyedMapStoresSpecializedIntegers()
	let map = new FastKeyedMap<unit, int>()
	let u = CreateUnit(Player(0), 'hfoo', 0., 0., 0.)
	map.has(u).assertEquals(false)
	map.put(u, 42)
	map.has(u).assertEquals(true)
	map.get(u).assertEquals(42)
	map.remove(u)
	map.has(u).assertEquals(false)
	destroy map

@Test
function fastKeyedMapStoresClassReferences()
	let map = new FastKeyedMap<unit, KeyedMapTestData>()
	let u = CreateUnit(Player(0), 'hfoo', 0., 0., 0.)
	let data = new KeyedMapTestData(17)
	map.put(u, data)
	map.has(u).assertEquals(true)
	map.get(u).value.assertEquals(17)
	map.remove(u)
	map.has(u).assertEquals(false)
	destroy map
	destroy data
