package HashMapTests
import HashMap

@Test
function testHas()
	let map = new HashMap<int, int>
	map.has(5).assertEquals(false)
	map.put(5, 1)
	map.has(5).assertEquals(true)

@Test
function testPutGet()
	let map = new HashMap<int, int>
	map.put(3, 1)
	map.get(3).assertEquals(1)
	map.get(5).assertEquals(0)
	map.remove(3)
	map.get(3).assertEquals(0)

@Test
function testRemove()
	let map = new HashMap<int, int>
		..put(3, 5)
	map.has(3).assertEquals(true)
	map.has(5).assertEquals(false)
	map.remove(3)
	map.has(3).assertEquals(false)

/** removeValue used "firstMatch != null" as its found-flag, so a key whose
	underlying int is 0 was never removed. */
@Test
function testRemoveValueZeroKey()
	let map = new IterableMap<int, int>
		..put(0, 42)
		..put(1, 42)

	map.removeValue(42, false)
	map.size().assertEquals(1)

	map.removeValue(42, false)
	map.size().assertEquals(0)
	map.hasKey(0).assertFalse()
	map.hasKey(1).assertFalse()

@Test
function testRemoveValueAll()
	let map = new IterableMap<int, int>
		..put(0, 7)
		..put(1, 7)
		..put(2, 9)

	map.removeValue(7, true)
	map.size().assertEquals(1)
	map.hasKey(2).assertTrue()
	map.get(2).assertEquals(9)

	// removing a value that is not present must be a no-op
	map.removeValue(1234, true)
	map.size().assertEquals(1)
	map.removeValue(1234, false)
	map.size().assertEquals(1)

@Test
function testIterableMapGetAndRemove()
	let map = new IterableMap<int, int>
		..put(1, 100)
		..put(2, 200)

	map.getAndRemove(1).assertEquals(100)
	map.size().assertEquals(1)
	map.hasKey(1).assertFalse()
	map.hasKey(2).assertTrue()
	map.get(2).assertEquals(200)

@Test
function testBooleanHashmap()
	let hm = new HashMap<int, boolean>
	hm.put(1, true)
	hm.get(1).assertEquals(true)


@Test
function testSize()
	let hm = new HashMap<int, boolean>
	hm.put(1, true)
	hm.size().assertEquals(1)
	hm.get(1).assertEquals(true)
	hm.size().assertEquals(1)
	hm.put(1, false)
	hm.size().assertEquals(1)
	hm.put(2, true)
	hm.size().assertEquals(2)
	hm.put(3, true)
	hm.put(4, true)
	hm.size().assertEquals(4)
	hm.remove(4)
	hm.size().assertEquals(3)
	hm.remove(3)
	hm.remove(2)
	hm.size().assertEquals(1)
	hm.getAndRemove(2)
	hm.size().assertEquals(1)
	hm.getAndRemove(1)
	hm.size().assertEquals(0)

/* IterableMap */
@Test
function testIterableMap()
	let map = new IterableMap<int, string>
	map.put(3, "string1 ")
	map.put(9, "removed")
	map.put(2, "string2 ")
	map.put(8, "removed")
	map.put(1, "string3")

	map.remove(2)
	map.removeValue("removed", true)

	let otherMap = new IterableMap<int, string>(map)

	string test = ""
	for key in otherMap
		test += otherMap.get(key)

	test.assertEquals("string1 string3")
	otherMap.hasKey(2).assertFalse()
	otherMap.hasKey(3).assertTrue()

@Test
function testIMIterator()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(9, 5)

	var i = 0
	let vals = [1, 3, 5]
	for key in map
		map.get(key).assertEquals(vals[i])
		i++

@Test
function testIMGetPut()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(9, 5)

	map.get(8).assertEquals(3)
	map.get(2).assertEquals(0)
	map.get(5).assertEquals(1)
	map.put(5, 2)
	map.get(5).assertEquals(2)

@Test
function testIMHasKeyRemove()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(9, 5)

	map.hasKey(5).assertEquals(true)
	map.hasKey(6).assertEquals(false)
	map.remove(5)
	map.hasKey(5).assertEquals(false)

@Test
function testIMRemoveValue()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(6, 1)
		..put(9, 2)
		..put(3, 1)
		..put(4, 5)

	map.removeValue(1, false)
	map.hasKey(5).assertEquals(false)
	map.hasKey(6).assertEquals(true)
	map.hasKey(3).assertEquals(true)
	map.removeValue(1, true)
	map.hasKey(6).assertEquals(false)
	map.hasKey(3).assertEquals(false)

@Test
function testIMRemoveValueSingle()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(6, 1)

	map.removeValue(1, false)
	map.hasKey(5).assertEquals(false)
	map.hasKey(6).assertEquals(true)

@Test
function testIMAddAll()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(9, 5)

	let map2 = new IterableMap<int, int>
		..put(4, 1)
		..put(8, 5)
		..put(3, 5)

	let keys = [5, 8, 9, 4, 3]
	let vals = [1, 5, 5, 1, 5]

	map.addAll(map2)
	for i = 0 to 4
		map.get(keys[i]).assertEquals(vals[i])

@Test
function testIMCopy()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(9, 5)

	let map2 = map.copy()

	for key in map
		map2.get(key).assertEquals(map.get(key))

@Test
function testIMCopyConstructor()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(9, 5)

	let map2 = new IterableMap<int, int>(map)

	for key in map
		map2.get(key).assertEquals(map.get(key))

@Test
function testIMFlush()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(9, 5)

	map.flush()
	map.hasKey(5).assertEquals(false)
	map.get(5).assertEquals(0)
	destroy map

@Test
function testIMForEach()
	let map = new IterableMap<int, int>
		..put(5, 1)
		..put(8, 3)
		..put(9, 5)

	var count = 0
	map.forEach() (integer key, integer value) ->
		count++
		if count == 1
			key.assertEquals(5)
			value.assertEquals(1)
		else if count == 2
			key.assertEquals(8)
			value.assertEquals(3)
		else if count == 3
			key.assertEquals(9)
			value.assertEquals(5)


	destroy map


/* Regression and coverage tests */

/** The iterator used to be keys.iterator(), so remove() dropped only the key
	and left the Table entry and size behind. */
@Test
function testIterableMapIteratorRemoveDropsEntry()
	let map = new IterableMap<int, int>
		..put(1, 10)
	let itr = map.iterator()
	itr.hasNext().assertTrue()
	itr.next().assertEquals(1)
	itr.remove()
	itr.hasNext().assertFalse()
	itr.close()

	map.has(1).assertFalse()
	map.hasKey(1).assertFalse()
	map.get(1).assertEquals(0)
	map.size().assertEquals(0)

@Test
function testIterableMapIteratorRemoveOncePerNext()
	let map = new IterableMap<int, int>
		..put(1, 10)
		..put(2, 20)
		..put(3, 30)
	let itr = map.iterator()
	itr.remove()
	map.size().assertEquals(3)
	itr.next().assertEquals(1)
	itr.next().assertEquals(2)
	itr.remove()
	itr.remove()
	itr.close()

	map.size().assertEquals(2)
	map.has(1).assertTrue()
	map.has(2).assertFalse()
	map.has(3).assertTrue()

@Test
function testIterableMapIteratorRemoveSome()
	let map = new IterableMap<int, int>
		..put(1, 10)
		..put(2, 20)
		..put(3, 30)
		..put(4, 40)
	let itr = map.iterator()
	while itr.hasNext()
		let key = itr.next()
		if key mod 2 == 0
			itr.remove()
	itr.close()

	map.size().assertEquals(2)
	map.has(2).assertFalse()
	map.has(4).assertFalse()
	map.get(1).assertEquals(10)
	map.get(3).assertEquals(30)
	var sum = 0
	for key in map
		sum += key
	sum.assertEquals(4)

@Test
function testIterableMapRemoveValueManyKeys()
	let map = new IterableMap<int, int>
	for i = 1 to 300
		map.put(i, 5)
	map.size().assertEquals(300)
	map.removeValue(5, true)
	map.size().assertEquals(0)
	map.has(150).assertFalse()
	map.hasKey(300).assertFalse()

@Test
function testIterableMapRemoveThenReinsertAppearsAtEnd()
	let map = new IterableMap<int, int>
		..put(1, 10)
		..put(2, 20)
		..put(3, 30)
	map.remove(1)
	map.put(1, 11)
	var order = ""
	for key in map
		order += key + ","
	order.assertEquals("2,3,1,")
	map.get(1).assertEquals(11)
	map.size().assertEquals(3)

@Test
function testHashMapZeroValueIsPresent()
	let map = new HashMap<int, int>
	map.put(7, 0)
	map.has(7).assertTrue()
	map.size().assertEquals(1)
	map.get(7).assertEquals(0)

@Test
function testHashMapRemoveThenReinsert()
	let map = new HashMap<int, int>
	map.put(1, 10)
	map.remove(1)
	map.has(1).assertFalse()
	map.size().assertEquals(0)
	map.put(1, 20)
	map.has(1).assertTrue()
	map.get(1).assertEquals(20)
	map.size().assertEquals(1)

@Test
function testHashMapExtremeKeys()
	let map = new HashMap<int, int>
	map.put(INT_MIN, 1)
	map.put(INT_MAX, 2)
	map.put(0, 3)
	map.put(-1, 4)
	map.size().assertEquals(4)
	map.get(INT_MIN).assertEquals(1)
	map.get(INT_MAX).assertEquals(2)
	map.get(0).assertEquals(3)
	map.get(-1).assertEquals(4)
	map.remove(INT_MIN)
	map.has(INT_MIN).assertFalse()
	map.has(INT_MAX).assertTrue()
	map.size().assertEquals(3)

@Test
function testHashMapStringKeysAreCaseSensitive()
	let map = new HashMap<string, int>
	map.put("Alpha", 1)
	map.put("alpha", 2)
	map.size().assertEquals(2)
	map.get("Alpha").assertEquals(1)
	map.get("alpha").assertEquals(2)
	map.has("ALPHA").assertFalse()

/** Real keys and values are stored through R2I_PRECISION (3 decimals). */
@Test
function testHashMapRealQuantisation()
	let map = new HashMap<real, real>
	map.put(0.0004, 0.0004)
	map.get(0.).assertEquals(0.)
	map.has(0.).assertTrue()
	map.put(1.2344, 2.5006)
	map.has(1.234).assertTrue()
	map.get(1.234).assertEquals(2.5)
