package KeyedMap
import Table
import ErrorHandling

/*	KeyedMap

	A handle-to-integer map which the Lua backend lowers to one native Lua table
	per map, keyed by the handle itself: every operation is a single table
	index, with no handle-id round trip and no entry retained for a unit after
	it is removed.

	The bodies of the fixed-signature functions (keyedMapPut, keyedMapGetInt and
	the rest) are the Jass implementation, a Table keyed by the handle id, and
	they are also what any compiler without the lowering compiles on both
	targets. They are correct in source, so nothing degrades silently: such a
	build only pays the hashtable path.

	The generic keyedMapPutNative and keyedMapGetNative, and FastKeyedMap on top
	of them, are different: a Table cannot store a generic value without the
	castTo int path they exist to avoid. Their bodies only raise an error, and
	they need a compiler with the keyed-map lowering, which gives them their
	bodies on both targets and runs them at compile time and in tests.

	The functions are recognised by the compiler through their annotation and
	their exact signatures, so they must keep these shapes. There is
	deliberately no iteration: enumerating a Lua table follows its internal
	hash layout, which differs between clients and would desync a game.
*/

/** Creates an empty map. Free it with keyedMapDestroy when it is no longer needed. */
@compilerintrinsic public function keyedMapCreate() returns int
	return (new Table()) castTo int

/** Stores value under key. A null key stores nothing. */
@compilerintrinsic public function keyedMapPut(int map, handle key, int value)
	if key == null
		return
	(map castTo Table).saveInt(GetHandleId(key), value)

/** The value stored under key, or 0 when there is none. */
@compilerintrinsic public function keyedMapGetInt(int map, handle key) returns int
	return (map castTo Table).loadInt(GetHandleId(key))

/**
 * Typed value intrinsic used by FastKeyedMap. Keep the name distinct from keyedMapPut: the legacy
 * fixed signature must remain unambiguous for existing callers. Lua lowers this to one raw table
 * store; Jass specializes int and class values to the handle or string integer fallback.
 */
@compilerintrinsic public function keyedMapPutNative<K:, V:>(int map, K key, V value)
	error("keyedMapPutNative requires compiler keyed-map intrinsic support")

/** Typed get paired with keyedMapPutNative. */
@compilerintrinsic public function keyedMapGetNative<K:, V:>(int map, K key) returns V
	error("keyedMapGetNative requires compiler keyed-map intrinsic support")
	return null

/** Whether a value is stored under key. */
@compilerintrinsic public function keyedMapHas(int map, handle key) returns boolean
	return (map castTo Table).hasInt(GetHandleId(key))

/** Removes the value stored under key, if any. */
@compilerintrinsic public function keyedMapRemove(int map, handle key)
	if key == null
		return
	(map castTo Table).removeInt(GetHandleId(key))

/** Frees the map. Lua lowering clears its backing table in place, even if an alias still references it. */
@compilerintrinsic public function keyedMapDestroy(int map)
	var entry = stringHeads[map]
	stringHeads[map] = null
	while entry != null
		let next = entry.nextAll
		destroy entry
		entry = next
	destroy (map castTo Table)

// Jass owns collision entries. Lua lowers the operations to direct table accesses, so these
// nodes and their ownership list are unreachable there. Bucket links handle StringHash collisions;
// the separate ownership list lets destroy release every entry without enumerating a hashtable.
class StringMapEntry
	string key
	int value
	StringMapEntry nextBucket
	StringMapEntry nextAll
	StringMapEntry previousAll

	ondestroy
		key = ""
		nextBucket = null
		nextAll = null
		previousAll = null

StringMapEntry array stringHeads

function findStringEntry(int map, string key) returns StringMapEntry
	var entry = (map castTo Table).loadInt(StringHash(key)) castTo StringMapEntry
	while entry != null
		if entry.key == key
			return entry
		entry = entry.nextBucket
	return null

@compilerintrinsic public function keyedMapPutString(int map, string key, int value)
	let old = findStringEntry(map, key)
	if old != null
		old.value = value
		return
	let table = map castTo Table
	let hash = StringHash(key)
	let entry = new StringMapEntry()
	entry.key = key
	entry.value = value
	entry.nextBucket = table.loadInt(hash) castTo StringMapEntry
	entry.nextAll = stringHeads[map]
	entry.previousAll = null
	if entry.nextAll != null
		entry.nextAll.previousAll = entry
	stringHeads[map] = entry
	table.saveInt(hash, entry castTo int)

@compilerintrinsic public function keyedMapGetStringInt(int map, string key) returns int
	let entry = findStringEntry(map, key)
	if entry == null
		return 0
	return entry.value

@compilerintrinsic public function keyedMapHasString(int map, string key) returns boolean
	return findStringEntry(map, key) != null

@compilerintrinsic public function keyedMapRemoveString(int map, string key)
	let table = map castTo Table
	let hash = StringHash(key)
	var entry = table.loadInt(hash) castTo StringMapEntry
	StringMapEntry previous = null
	while entry != null
		if entry.key == key
			if previous == null
				if entry.nextBucket == null
					table.removeInt(hash)
				else
					table.saveInt(hash, entry.nextBucket castTo int)
			else
				previous.nextBucket = entry.nextBucket
			if entry.previousAll == null
				stringHeads[map] = entry.nextAll
			else
				entry.previousAll.nextAll = entry.nextAll
			if entry.nextAll != null
				entry.nextAll.previousAll = entry.previousAll
			destroy entry
			return
		previous = entry
		entry = entry.nextBucket

@compilerintrinsic public function keyedMapHasNative<K:>(int map, K key) returns boolean
	error("keyedMapHasNative requires compiler keyed-map intrinsic support")
	return false

@compilerintrinsic public function keyedMapRemoveNative<K:>(int map, K key)
	error("keyedMapRemoveNative requires compiler keyed-map intrinsic support")

/**
 * High-performance map for handle or string keys and native int or class-reference values.
 * Jass uses Warcraft's hashtable with full-string collision checks; Lua uses a native table and stores V
 * directly, without boxing.
 *
 * This deliberately narrow API avoids key hashing and handle-id conversions on Lua. It is not a
 * general-purpose replacement for HashMap: only handle and string keys are supported, keys are not iterable,
 * and there is no size counter. Use remove() for absence; reference values must be non-null because
 * Lua represents nil as a missing table entry. Keep class-reference values alive while stored, and
 * remove or replace them before destroy: Jass stores their integer object IDs, which can be reused,
 * on both targets. The same holds for handle keys: remove a key's entry before you
 * destroy that handle. Jass stores the entry under the handle id, which Warcraft hands to a later
 * handle, so the new handle would read the old value; Lua would keep the destroyed handle referenced.
 * This requires the compiler's keyed-map intrinsic lowering.
 * The intrinsic source bodies fail loudly if a compiler understands the generic declarations but
 * lacks that lowering; they never silently discard writes or return defaults.
 */
public class FastKeyedMap<K:, V:>
	private int map

	construct()
		map = keyedMapCreate()

	/** Stores a value. Null keys are ignored; reference values should not be null. */
	function put(K key, V value)
		keyedMapPutNative<K, V>(map, key, value)

	/** Returns the value or the Wurst default for V when the key is absent. */
	function get(K key) returns V
		return keyedMapGetNative<K, V>(map, key)

	/** Returns whether the key has a stored value. */
	function has(K key) returns boolean
		return keyedMapHasNative<K>(map, key)

	/** Removes a key and its value. */
	function remove(K key)
		keyedMapRemoveNative<K>(map, key)

	ondestroy
		keyedMapDestroy(map)
