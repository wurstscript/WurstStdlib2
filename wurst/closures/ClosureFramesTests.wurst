package ClosureFramesTests
import ClosureFrames

class TestFrameListener extends FrameHandleListener
    static int array order
    static int runs = 0
    static TestFrameListener array made
    int which
    int destroyWhich

    construct(int which, int destroyWhich)
        this.which = which
        this.destroyWhich = destroyWhich

    override function onEvent()
        order[runs] = which
        runs++
        if destroyWhich >= 0
            destroy made[destroyWhich]

    static function link(TestFrameListener listener, int frameId, frameeventtype eventType) returns bool
        return linkForTest(listener, frameId, eventType)

    static function dispatch(int frameId, frameeventtype eventType)
        dispatchForTest(frameId, eventType)

function newTestListener(int which, int destroyWhich, int frameId) returns TestFrameListener
    let l = new TestFrameListener(which, destroyWhich)
    TestFrameListener.made[which] = l
    TestFrameListener.link(l, frameId, FRAMEEVENT_CONTROL_CLICK)
    return l

@Test function aFrameEventIsRegisteredOnceOnTheSharedTrigger()
    let first = new TestFrameListener(0, -1)
    TestFrameListener.link(first, 910001, FRAMEEVENT_CONTROL_CLICK).assertTrue()
    let second = new TestFrameListener(1, -1)
    TestFrameListener.link(second, 910001, FRAMEEVENT_CONTROL_CLICK).assertFalse()
    // Another event of the same frame, and the same event of another frame, are new.
    let other = new TestFrameListener(3, -1)
    TestFrameListener.link(other, 910001, FRAMEEVENT_MOUSE_ENTER).assertTrue()
    let otherFrame = new TestFrameListener(4, -1)
    TestFrameListener.link(otherFrame, 910002, FRAMEEVENT_CONTROL_CLICK).assertTrue()
    destroy first
    destroy second
    destroy other
    destroy otherFrame

@Test function aPairWhoseListenersWentAwayStaysRegistered()
    let first = new TestFrameListener(0, -1)
    TestFrameListener.link(first, 910005, FRAMEEVENT_CONTROL_CLICK).assertTrue()
    destroy first
    // WC3 has no per-event unregister: the pair is still on the shared trigger, and registering it again would run
    // every handler of the frame twice per click.
    let again = new TestFrameListener(1, -1)
    TestFrameListener.link(again, 910005, FRAMEEVENT_CONTROL_CLICK).assertFalse()
    TestFrameListener.runs = 0
    TestFrameListener.dispatch(910005, FRAMEEVENT_CONTROL_CLICK)
    TestFrameListener.runs.assertEquals(1)
    destroy again

class OpensNextFrameListener extends FrameHandleListener
    static TestFrameListener opened = null

    override function onEvent()
        opened = new TestFrameListener(7, -1)
        TestFrameListener.link(opened, 910010, FRAMEEVENT_CONTROL_CLICK)

    static function link(OpensNextFrameListener listener, int frameId, frameeventtype eventType) returns bool
        return linkForTest(listener, frameId, eventType)

/** A dialog's button opening the next dialog: the new button's listener is linked while the first click is still
    being dispatched, and its own click must reach it. Before the shared trigger, such a button never got its real
    clicks. */
@Test function aListenerLinkedDuringADispatchGetsItsOwnFrameEvents()
    TestFrameListener.runs = 0
    let opener = new OpensNextFrameListener()
    OpensNextFrameListener.link(opener, 910009, FRAMEEVENT_CONTROL_CLICK).assertTrue()
    TestFrameListener.dispatch(910009, FRAMEEVENT_CONTROL_CLICK)
    (OpensNextFrameListener.opened != null).assertTrue()
    TestFrameListener.dispatch(910010, FRAMEEVENT_CONTROL_CLICK)
    TestFrameListener.runs.assertEquals(1)
    TestFrameListener.order[0].assertEquals(7)
    destroy OpensNextFrameListener.opened
    destroy opener

@Test function frameDispatchSurvivesAListenerDestroyingItsNextSibling()
    TestFrameListener.runs = 0
    // linked 0, 1, 2: the list is 2 -> 1 -> 0, and 2 destroys 1 before its turn
    newTestListener(0, -1, 910003)
    newTestListener(1, -1, 910003)
    newTestListener(2, 1, 910003)
    TestFrameListener.dispatch(910003, FRAMEEVENT_CONTROL_CLICK)
    TestFrameListener.runs.assertEquals(2)
    TestFrameListener.order[0].assertEquals(2)
    TestFrameListener.order[1].assertEquals(0)
    destroy TestFrameListener.made[2]
    destroy TestFrameListener.made[0]

@Test function frameDispatchSurvivesAListenerDestroyingItself()
    TestFrameListener.runs = 0
    newTestListener(0, -1, 910004)
    newTestListener(1, -1, 910004)
    newTestListener(2, 2, 910004)
    TestFrameListener.dispatch(910004, FRAMEEVENT_CONTROL_CLICK)
    TestFrameListener.runs.assertEquals(3)
    destroy TestFrameListener.made[1]
    destroy TestFrameListener.made[0]
