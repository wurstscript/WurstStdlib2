package ClosureFrames
import NoWurst
import Annotations
import Trigger
import KeyedMap
import Table
import Unit
import Framehandle

/*
    Example usage:
        createSimpleFrame("MySimpleButton", GAME_UI, 0)
        ..onClick(() -> print("The button was clicked."))
        ..onMouseEnter(() -> print("The mouse is on the button."))
        ..onMouseLeave(() -> print("The mouse left the button."))

    Important:
        * Most frametypes don't support most events (some might not support any)
        * Registrating origin frames to event seems to override their default behaviour.
        For instance using the origin menu button for a onClick() event will make it not prompt the menu.
*/

/* CONSTANTS */

// Frame handle id -> the first listener of that frame. A KeyedMap with an int key and a class-typed value,
// which the compiler lowers to a native table on Lua. It recognises these three functions by their
// annotation and their exact shape, so they must keep it; the bodies are what runs on Jass.
@compilerintrinsic function keyedMapPut(int map, int key, FrameHandleListener value)
    (map castTo Table).saveInt(key, value castTo int)

@compilerintrinsic function keyedMapGet(int map, int key) returns FrameHandleListener
    return (map castTo Table).loadInt(key) castTo FrameHandleListener

@compilerintrinsic function keyedMapRemove(int map, int key)
    (map castTo Table).removeInt(key)

constant FRAME_MAP = keyedMapCreate()

// Frame handle id -> event type handle id -> the trigger which holds that event of that frame, and how many
// listeners use it. Each pair has a trigger of its own, so that the last listener going away can retire it: WC3 has
// no per-event unregister. A pair which gets listeners again, or a new frame with the reused handle id of a
// destroyed one, is then registered on a fresh trigger, and never twice on a live one.
constant FRAME_EVENT_TRIGGERS = InitHashtable()
constant FRAME_EVENT_LISTENERS = InitHashtable()

// Triggers whose last listener went away. They are destroyed only while no frame event is being dispatched, since
// one of them may be the trigger whose action is running (possibly suspended in a wait): by the next listener
// change or the next frame event after the dispatches end. Until then onEvent ignores their fires, as they are no
// longer the pair's trigger.
trigger array retiredTriggers
var retiredTriggerCount = 0

// The listener each dispatch in progress steps to next, in a slot the dispatch owns until it ends. Slots are not
// tied to a nesting depth: a listener may wait, and dispatches paused that way resume in any order.
FrameHandleListener array frameCursor
bool array frameCursorUsed
int array freeFrameCursors
var freeFrameCursorCount = 0
// How many slots were ever handed out; the ones not in use are on freeFrameCursors.
var frameCursorSlots = 0
// How many dispatches are in progress, paused ones included
var frameDispatches = 0


/* CLOSURES */

public function framehandle.onCheckboxCheck(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_CHECKBOX_CHECKED)

public function framehandle.onCheckboxUncheck(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_CHECKBOX_UNCHECKED)

public function framehandle.onClick(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_CONTROL_CLICK)

/** Registers a click listener that releases keyboard focus for the triggering player.
    Use this for buttons and editboxes that would otherwise keep Warcraft III hotkeys focused on the frame. */
public function framehandle.onClickReleaseFocus() returns FrameHandleListener
    return addListenerForFrame(new ReleaseKeyboardFocusFrameListener(), this, FRAMEEVENT_CONTROL_CLICK)

public function framehandle.onDialogAccept(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_DIALOG_ACCEPT)

public function framehandle.onDialogCancel(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_DIALOG_CANCEL)

public function framehandle.onEditboxEnter(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_EDITBOX_ENTER)

public function framehandle.onEditboxChange(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_EDITBOX_TEXT_CHANGED)

public function framehandle.onMouseDoubleClick(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_MOUSE_DOUBLECLICK)

public function framehandle.onMouseDown(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_MOUSE_DOWN)

public function framehandle.onMouseEnter(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_MOUSE_ENTER)

public function framehandle.onMouseLeave(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_MOUSE_LEAVE)

public function framehandle.onMouseUp(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_MOUSE_UP)

public function framehandle.onMouseWheel(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_MOUSE_WHEEL)

public function framehandle.onPopupMenuItemChange(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_POPUPMENU_ITEM_CHANGED)

public function framehandle.onSliderValueChange(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_SLIDER_VALUE_CHANGED)

public function framehandle.onSpriteAnimUpdate(FrameHandleListener listener) returns FrameHandleListener
    return addListenerForFrame(listener, this, FRAMEEVENT_SPRITE_ANIM_UPDATE)

function addListenerForFrame(FrameHandleListener listener, framehandle frame, frameeventtype eventType) returns FrameHandleListener
    listener.frame = frame
    let t = linkListener(listener, frame.getHandleId(), eventType)
    if t != null
        t.registerFrameEvent(frame, eventType)
    return listener

/** Puts the listener at the head of the frame's list. Returns the new trigger to register (frame, eventType) on when
    the pair had no listener yet, or null when its trigger already holds the event.

    A pair is registered only ONCE per trigger. onEvent() already fans a single trigger fire out to every listener in
    the list, so re-registering on each added listener makes the trigger fire once PER registration: a frame with two
    CONTROL_CLICK listeners then runs its click handler twice (which silently toggled controls back, e.g. a
    checkbox that never unchecks). */
function linkListener(FrameHandleListener listener, int id, frameeventtype eventType) returns trigger
    if frameDispatches == 0
        destroyRetiredTriggers()
    listener.frameId = id
    listener.eventType = eventType
    let first = keyedMapGet(FRAME_MAP, id)
    if first != null
        first.prev = listener
        listener.next = first
    keyedMapPut(FRAME_MAP, id, listener)

    let eventId = eventType.getHandleId()
    let listeners = LoadInteger(FRAME_EVENT_LISTENERS, id, eventId)
    SaveInteger(FRAME_EVENT_LISTENERS, id, eventId, listeners + 1)
    if listeners > 0
        return null
    let t = CreateTrigger()..addAction(function onEvent)
    SaveTriggerHandle(FRAME_EVENT_TRIGGERS, id, eventId, t)
    return t

/** Called when a listener of the pair goes away: the last one retires the pair's trigger. */
function unlinkEvent(int id, frameeventtype eventType)
    if eventType == null
        return
    let eventId = eventType.getHandleId()
    let listeners = LoadInteger(FRAME_EVENT_LISTENERS, id, eventId) - 1
    if listeners > 0
        SaveInteger(FRAME_EVENT_LISTENERS, id, eventId, listeners)
        return
    RemoveSavedInteger(FRAME_EVENT_LISTENERS, id, eventId)
    let t = LoadTriggerHandle(FRAME_EVENT_TRIGGERS, id, eventId)
    RemoveSavedHandle(FRAME_EVENT_TRIGGERS, id, eventId)
    if t != null
        retiredTriggers[retiredTriggerCount] = t
        retiredTriggerCount++
    if frameDispatches == 0
        destroyRetiredTriggers()

function destroyRetiredTriggers()
    for i = 0 to retiredTriggerCount - 1
        DestroyTrigger(retiredTriggers[i])
        retiredTriggers[i] = null
    retiredTriggerCount = 0


/* ON EVENT */

function onEvent()
    let id = BlzGetTriggerFrame().getHandleId()
    let eventType = BlzGetTriggerFrameEvent()
    // A retired trigger may still fire until it is destroyed; only the pair's current trigger dispatches.
    if GetTriggeringTrigger() == LoadTriggerHandle(FRAME_EVENT_TRIGGERS, id, eventType.getHandleId())
        dispatchFrameEvent(id, eventType)

/** Runs the listeners of the frame for the event, newest first. A listener may destroy itself or any other listener:
    the successor is published in frameCursor before each call, and the destructor advances it when it is the one
    destroyed. There is one cursor per dispatch, as a listener may raise frame events itself or wait. */
function dispatchFrameEvent(int id, frameeventtype eventType)
    // Triggers retired by an earlier dispatch go now, unless a dispatch is still in progress. The trigger which
    // runs this one is not among them: onEvent dispatches only for a pair's current trigger.
    if frameDispatches == 0
        destroyRetiredTriggers()
    var slot = frameCursorSlots
    if freeFrameCursorCount > 0
        freeFrameCursorCount--
        slot = freeFrameCursors[freeFrameCursorCount]
    else
        frameCursorSlots++
    frameCursorUsed[slot] = true
    frameDispatches++
    var listener = keyedMapGet(FRAME_MAP, id)
    while listener != null
        frameCursor[slot] = listener.next
        if listener.eventType == eventType
            listener.onEvent()
        listener = frameCursor[slot]
    frameCursor[slot] = null
    frameCursorUsed[slot] = false
    freeFrameCursors[freeFrameCursorCount] = slot
    freeFrameCursorCount++
    frameDispatches--


/* FRAME HANDLE LISTENER */

public abstract class FrameHandleListener
    framehandle frame
    frameeventtype eventType
    /** The handle id of the frame, which the map is keyed by. Kept apart from `frame`, which may be gone by the
        time the listener is destroyed. */
    int frameId = 0
    thistype next = null
    thistype prev = null

    abstract function onEvent()

    ondestroy
        for slot = 0 to frameCursorSlots - 1
            if frameCursorUsed[slot] and frameCursor[slot] == this
                frameCursor[slot] = next
        let id = frameId
        let first = keyedMapGet(FRAME_MAP, id)
        if first == this
            if next == null
                keyedMapRemove(FRAME_MAP, id)
            else
                keyedMapPut(FRAME_MAP, id, next)
        else if prev != null
            prev.next = next
        if next != null
            next.prev = prev
        next = null
        prev = null
        unlinkEvent(id, eventType)

    /** Links a listener to a frame id and event without a frame, for tests: the frame event itself is not
        registered. Returns whether the pair needed a new trigger. */
    protected static function linkForTest(thistype listener, int frameId, frameeventtype eventType) returns bool
        return linkListener(listener, frameId, eventType) != null

    /** Runs the listeners of a frame id for an event, as a fire of its trigger does. For tests. */
    protected static function dispatchForTest(int frameId, frameeventtype eventType)
        dispatchFrameEvent(frameId, eventType)

    /** How many retired triggers wait for no frame event to be running. For tests. */
    protected static function retiredTriggersForTest() returns int
        return retiredTriggerCount

class ReleaseKeyboardFocusFrameListener extends FrameHandleListener

    override function onEvent()
        frame.releaseKeyboardFocus(GetTriggerPlayer())
