package ClosureEvents
import public EventHelper
import public RegisterEvents
import ClosureTimers
import UnitIndexer
import HashMap
import KeyedMap
import ErrorHandling
import ArrayList

// Init-time cast registrations wait for the normal deferred UnitIndexer pass.
var castRegistrationDuringInit = true

/** Use this chat event if you want to access the entered message */
public constant EVENT_PLAYER_CHAT_FILTER = ConvertPlayerEvent(96)

/** Configure this function if you want some logic to prevent events being
	fired for specific units */
@configurable function fireEvents(unit _u) returns boolean
	return true

/**
	This package is a comfort wrapper around wc3 events,
	for easy global and per-unit event listening via closures.

	To listen to an event, simply #add, optionally passing a target unit:

		> EventListener.add(EVENT_PLAYER_UNIT_DEATH) ->
		>	 <any unit death actions>

		> EventListener.add(someUnit, EVENT_PLAYER_UNIT_DEATH) ->
		>	 <only 'someUnit' death actions>

	For spell handling there are comfort wrappers via the `on` prefix:

	> EventListener.onCast(MY_SPELL_ID) (caster) ->
	>	 <some non target spell event for all units>

	> EventListener.onCast(myUnit, MY_SPELL_ID) (caster) ->
	>	 <some non target spell for 'myUnit'>

	> EventListener.onPointCast(myUnit, MY_SPELL_ID) (caster, target) ->
	>	 <actions for a point cast spell. 'target' is the vec2 target point>


	Listeners of the same event, and cast listeners of the same ability, run newest first (LIFO):
	the one added last is called first. Do not rely on this to order listeners; use DamageEvent
	priorities when the order matters. A listener may destroy itself or any other listener from
	within a callback; the listeners which are still registered then run as usual.

	Listeners of a unit are registered for its UnitIndexer index. A unit which is not indexed
	can not take listeners: adding one logs a warning and the listener is not registered.
	Init-time cast registrations wait until the deferred indexing pass has completed; units still
	unindexed then remain rejected. Listeners are destroyed when the unit is deindexed.

	**IMPORTANT**:
		Make sure to always use the "EVENT_PLAYER_UNIT_*" variants of the eventids.
		Other supported events:
			- EVENT_PLAYER_LEAVE
			- EVENT_UNIT_DAMAGED (handled as EVENT_PLAYER_UNIT_DAMAGED)
			- EVENT_PLAYER_CHAT_FILTER
			- EVENT_PLAYER_ARROW_*
			- EVENT_PLAYER_END_CINEMATIC
			- EVENT_PLAYER_MOUSE_UP, EVENT_PLAYER_MOUSE_DOWN, EVENT_PLAYER_MOUSE_MOVE
		Any other eventid raises an error when a listener is registered for it.
*/

public abstract class OnCastListener
	static private ArrayList<OnCastListener> pendingRegistrations = new ArrayList<OnCastListener>()
	private int pendingSlot = -1
	OnCastListener next = null
	OnCastListener prev = null
	int abilId
	unit eventUnit = null

	abstract function fire(unit caster)

	/** Internal startup queue. Cancelled slots are cleared before an object id can be reused. */
	static function deferRegistration(unit u, int abilId, OnCastListener listener) returns OnCastListener
		listener.eventUnit = u
		listener.abilId = abilId
		listener.pendingSlot = pendingRegistrations.size()
		pendingRegistrations.add(listener)
		return listener

	/** Internal: keep later registrations queued when their unit was manually indexed meanwhile. */
	static function hasPendingForUnit(unit u) returns bool
		for i = 0 to pendingRegistrations.size() - 1
			let listener = pendingRegistrations.get(i)
			if listener != null and listener.eventUnit == u
				return true
		return false

	/** Internal: pending registrations obey the same deindex lifetime as active ones. */
	static function cancelPendingForUnit(unit u)
		var i = 0
		while i < pendingRegistrations.size()
			let listener = pendingRegistrations.get(i)
			if listener != null and listener.eventUnit == u
				destroy listener
			i++

	/** Internal: bind surviving requests after normal startup indexing. Oldest first preserves LIFO dispatch. */
	static function registerPendingCasts()
		castRegistrationDuringInit = false
		for i = 0 to pendingRegistrations.size() - 1
			let listener = pendingRegistrations.get(i)
			if listener != null
				pendingRegistrations.set(i, null)
				listener.pendingSlot = -1
				if listener.eventUnit.getIndex() > 0
					EventListener.onCast(listener.eventUnit, listener.abilId, listener)
				else
					Log.warn("Init-time cast listener rejected: the unit remains unindexed after startup.")
		pendingRegistrations.clear()

	ondestroy
		EventListener.repairCastCursors(this)
		if pendingSlot >= 0
			pendingRegistrations.set(pendingSlot, null)
			pendingSlot = -1
		else if eventUnit != null
			let index = eventUnit.getIndex()
			let listener = EventListener.castMapCasters[index]
			if listener == this
				if next != null
					EventListener.castMapCasters[index] = next
				else
					EventListener.castMapCasters[index] = null
			else if prev != null
				prev.next = next
		else
			let listener = EventListener.castMap.get(abilId)
			if listener == this
				if next != null
					EventListener.castMap.put(abilId, next)
				else
					EventListener.castMap.remove(abilId)
			else if prev != null
				prev.next = next

		if next != null
			next.prev = prev

		next = null
		prev = null

public abstract class OnCast extends OnCastListener

	override function fire(unit caster)
		fireEx(GetSpellAbilityId())

	abstract function fireEx(int id)

public abstract class OnPointCast extends OnCastListener

	override function fire(unit caster)
		if EventData.getSpellTargetUnit() == null
			fireEx(caster, EventData.getSpellTargetPos())

	abstract function fireEx(unit caster, vec2 target)

public abstract class OnUnitCast extends OnCastListener

	override function fire(unit caster)
		if EventData.getSpellTargetUnit() != null
			fireEx(caster, EventData.getSpellTargetUnit())

	abstract function fireEx(unit caster, unit target)

/*	A KeyedMap with an int key and a class-typed value, which the compiler lowers to one native table on Lua.
	It recognises the three functions below by their annotation and their exact shape, so they must keep it;
	the bodies are what runs on Jass. */
@compilerintrinsic function keyedMapPut(int map, int key, OnCastListener value)
	(map castTo Table).saveInt(key, value castTo int)

@compilerintrinsic function keyedMapGet(int map, int key) returns OnCastListener
	return (map castTo Table).loadInt(key) castTo OnCastListener

@compilerintrinsic function keyedMapRemove(int map, int key)
	(map castTo Table).removeInt(key)

/** Ability id -> the first cast listener registered for it, as a chain through next and prev.
	A HashMap, so everything else a HashMap does still works; a cast reads the listener from a native table on
	Lua instead, which put and remove keep in step with the HashMap. */
public class CastListenerMap extends HashMap<int, OnCastListener>
	private int fast = keyedMapCreate()

	override function get(int abilId) returns OnCastListener
		return keyedMapGet(fast, abilId)

	override function put(int abilId, OnCastListener listener)
		super.put(abilId, listener)
		keyedMapPut(fast, abilId, listener)

	override function remove(int abilId)
		super.remove(abilId)
		keyedMapRemove(fast, abilId)

	/** Set when the map is being destroyed: the HashMap destructor flushes it, and that is when the native table goes. */
	private bool destroying = false

	override function flush()
		super.flush()
		keyedMapDestroy(fast)
		if not destroying
			fast = keyedMapCreate()

	ondestroy
		destroying = true

public abstract class EventListener
	static constant castMap = new CastListenerMap()
	/** Whether a cast listener was ever added. Never reset, so it can not fall out of step with the chains. */
	static var hasCastListeners = false
	static OnCastListener array castMapCasters
	/** The listener each walk in progress steps to next, in a slot the walk owns until it ends; see dispatchTo.
		Slots are not tied to a nesting depth: a listener may wait in an action trigger, and walks paused that way
		resume in any order. dispatchNext holds the cursors of event walks, castNext those of cast walks. */
	static EventListener array dispatchNext
	static OnCastListener array castNext
	static bool array walkSlotUsed
	static int array freeWalkSlots
	static int freeWalkSlotCount = 0
	/** How many slots were ever handed out; the ones not in use are on freeWalkSlots. */
	static int walkSlots = 0
	static EventListener array generalListenersFirsts
	static EventListener array unitListenersFirsts
	static var useMouseEvents = false
	/** Whether a listener of one unit was ever added. Until then a delivery needs not look at the unit. */
	static var hasUnitListeners = false
	/** The ids of the two damage events, whose deliveries are told the id and so need not ask the engine. */
	static int damagedId = 0
	static int damagingId = 0
	/** The handle ids of the same two events, to ask whether their triggers have been handed out. */
	static int damagedHandleId = 0
	static int damagingHandleId = 0

	var eventId = 0
	var uid = -1
	EventListener next = null
	EventListener prev = null

	abstract function onEvent()

	static function add(eventid eventId, EventListener listener) returns EventListener
		listener.eventId = eventId.toIntId()
		if generalListenersFirsts[listener.eventId] != null
			generalListenersFirsts[listener.eventId].prev = listener
			listener.next = generalListenersFirsts[listener.eventId]

		generalListenersFirsts[listener.eventId] = listener
		return listener

	static function add(unit u, eventid eventId, EventListener listener) returns EventListener
		let uid = u.getIndex()
		if uid <= 0
			Log.warn("Attempting to register event listener for a unit that is not indexed by UnitIndexer. " +
				"If this happens during initialization, consider registering the EventListener in a callback to nullTimer() instead.")
			return listener
		hasUnitListeners = true
		listener.eventId = eventId.toIntId()
		listener.uid = uid
		if unitListenersFirsts[uid] != null
			unitListenersFirsts[uid].prev = listener
			listener.next = unitListenersFirsts[uid]
		unitListenersFirsts[uid] = listener
		return listener

	static function onCast(unit u, int abilId, OnCastListener listener) returns OnCastListener
		return addSpellInternal(u, abilId, listener)

	static function onTargetCast(unit u, int abilId, OnUnitCast listener) returns OnUnitCast
		return addSpellInternal(u, abilId, listener) castTo OnUnitCast

	static function onPointCast(unit u, int abilId, OnPointCast listener) returns OnPointCast
		return addSpellInternal(u, abilId, listener) castTo OnPointCast

	static function onCast(int abilId, OnCastListener listener) returns OnCastListener
		return addSpellInternal(null, abilId, listener)

	static function onCast(unit u, OnCast listener) returns OnCast
		return addSpellInternal(u, -1, listener) castTo OnCast

	static function onTargetCast(int abilId, OnUnitCast listener) returns OnUnitCast
		return addSpellInternal(null, abilId, listener) castTo OnUnitCast

	static function onPointCast(int abilId, OnPointCast listener) returns OnPointCast
		return addSpellInternal(null, abilId, listener) castTo OnPointCast

	static private function addSpellInternal(unit u, int abilId, OnCastListener listener) returns OnCastListener
		if u != null
			let index = u.getIndex()
			if castRegistrationDuringInit and (index <= 0 or OnCastListener.hasPendingForUnit(u))
				return OnCastListener.deferRegistration(u, abilId, listener)
			if index <= 0
				// Every unit without an index would share slot 0, so the listener would answer the casts of all of them.
				Log.warn("Attempting to register a cast listener for a unit that is not indexed by UnitIndexer. " +
					"If this happens during initialization, consider registering the listener in a callback to nullTimer() instead.")
				return listener
		hasCastListeners = true
		listener.abilId = abilId
		if u != null
			listener.eventUnit = u
			let index = u.getIndex()
			if castMapCasters[index] != null
				castMapCasters[index].prev = listener
				listener.next = castMapCasters[index]
			castMapCasters[index] = listener
		else
			let entry = castMap.get(abilId)
			if entry != null
				entry.prev = listener
				listener.next = entry

			castMap.put(abilId, listener)
		return listener

	static function generalEventCallback()
		dispatch(GetTriggerEventId().toIntId())

	/** The damage events are the busiest, so they are delivered with the id they were registered with. That holds
		while nobody else can have registered an event on their trigger: once getPlayerUnitEventTrigger has handed it
		out, the engine is asked which event fired, as it is for every other event. One way to put an event on the
		trigger is not seen: a listener which takes it with GetTriggeringTrigger and registers an event on it, the same
		limit as stated at getPlayerUnitEventTrigger. Asking the engine on every delivery would cover it and give back
		the gain, which is about 1.5 us per hit. */
	static function damagedCallback()
		if isPlayerUnitEventTriggerTaken(damagedHandleId)
			generalEventCallback()
		else
			dispatch(damagedId)

	static function damagingCallback()
		if isPlayerUnitEventTriggerTaken(damagingHandleId)
			generalEventCallback()
		else
			dispatch(damagingId)

	/** Delivers the event of the given id to the listeners of the triggering unit and then to the global ones. */
	static private function dispatch(int id)
		if hasUnitListeners
			dispatchTo(GetTriggerUnit(), id)
		else
			dispatchTo(null, id)

	/** Delivers the event to the listeners of the unit, if any, and then to the global ones. Apart from the
		triggering unit it reads nothing from the engine, which lets a test drive it.

		The listeners of a chain run newest first. A listener may destroy itself or any other listener while the
		chain is walked: the successor is published in dispatchNext before each call and ondestroy advances it if
		that successor is the one destroyed, so no later listener is skipped and no destroyed one is read. */
	protected static function dispatchTo(unit trigUnit, int id)
		let depth = takeWalkSlot()
		// Unit Listeners
		if hasUnitListeners
			if trigUnit != null
				let index = trigUnit.getIndex()
				if index > 0
					var listener = unitListenersFirsts[index]
					if listener != null and fireEvents(trigUnit)
						while listener != null
							dispatchNext[depth] = listener.next
							if listener.eventId == id
								listener.onEvent()
							listener = dispatchNext[depth]
		// Global Listeners
		var globalListener = generalListenersFirsts[id]
		while globalListener != null
			dispatchNext[depth] = globalListener.next
			globalListener.onEvent()
			globalListener = dispatchNext[depth]
		releaseWalkSlot(depth)

	static function onSpellEffect()
		// Registered for every project which imports this package, used by few: most casts end here.
		if not hasCastListeners
			return
		dispatchSpell(GetTriggerUnit(), GetSpellAbilityId(), GetSpellAbilityUnit())

	/** Delivers a cast of the ability to the cast listeners of the unit and then to those of the ability.
		Apart from its arguments it reads nothing from the engine, which lets a test drive it.
		The chains are walked as described at dispatchTo, with castNext as the cursor. */
	protected static function dispatchSpell(unit trigUnit, int abilId, unit caster)
		let index = trigUnit.getIndex()
		let depth = takeWalkSlot()
		var listener = castMapCasters[index]
		while listener != null
			castNext[depth] = listener.next
			if listener.abilId == -1 or listener.abilId == abilId
				listener.fire(caster)
			listener = castNext[depth]

		listener = castMap.get(abilId)
		while listener != null
			castNext[depth] = listener.next
			if listener.eventUnit == null or listener.eventUnit == trigUnit
				listener.fire(caster)
			listener = castNext[depth]
		releaseWalkSlot(depth)

	/** Hands a walk a cursor slot of its own, reusing a free one first. */
	static function takeWalkSlot() returns int
		var slot = walkSlots
		if freeWalkSlotCount > 0
			freeWalkSlotCount--
			slot = freeWalkSlots[freeWalkSlotCount]
		else
			walkSlots++
		walkSlotUsed[slot] = true
		return slot

	static function releaseWalkSlot(int slot)
		dispatchNext[slot] = null
		castNext[slot] = null
		walkSlotUsed[slot] = false
		freeWalkSlots[freeWalkSlotCount] = slot
		freeWalkSlotCount++

	/** Advances the cursor of every walk in progress which is about to step onto the destroyed listener.
		There is one cursor per walk, as a listener may raise events itself or wait while its walk is paused. */
	static function repairDispatchCursors(EventListener removed)
		for slot = 0 to walkSlots - 1
			if walkSlotUsed[slot] and dispatchNext[slot] == removed
				dispatchNext[slot] = removed.next

	/** The same for the walks over cast listeners. */
	static function repairCastCursors(OnCastListener removed)
		for slot = 0 to walkSlots - 1
			if walkSlotUsed[slot] and castNext[slot] == removed
				castNext[slot] = removed.next

	ondestroy
		repairDispatchCursors(this)
		if uid < 0
			let listener = generalListenersFirsts[this.eventId]
			if listener == this
				generalListenersFirsts[this.eventId] = next
			else if prev != null
				prev.next = next
		else
			let listener = unitListenersFirsts[this.uid]
			if listener == this
				unitListenersFirsts[this.uid] = next
			else if prev != null
				prev.next = next

		if next != null
			next.prev = prev
		next = null
		prev = null

let leaveTrig = CreateTrigger()
let keyTrig = CreateTrigger()

public function eventid.toIntId() returns int
	var id = eventidToIndex[this.getHandleId()]
	if id == 0
		id = registerEventId(this)
	return id

int array eventidToIndex
var eventTypeCounter = 0

function registerEventId(eventid evnt) returns int
	let eventId = evnt.getHandleId()
	eventTypeCounter++
	eventidToIndex[eventId] = eventTypeCounter
	if evnt == EVENT_UNIT_DAMAGED
		eventidToIndex[EVENT_PLAYER_UNIT_DAMAGED.getHandleId()] = eventTypeCounter
		EventListener.damagedId = eventTypeCounter
		EventListener.damagedHandleId = EVENT_PLAYER_UNIT_DAMAGED.getHandleId()
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_DAMAGED, function EventListener.damagedCallback)
	else if evnt == EVENT_PLAYER_UNIT_DAMAGED
		eventidToIndex[EVENT_UNIT_DAMAGED.getHandleId()] = eventTypeCounter
		EventListener.damagedId = eventTypeCounter
		EventListener.damagedHandleId = EVENT_PLAYER_UNIT_DAMAGED.getHandleId()
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_DAMAGED, function EventListener.damagedCallback)
	else if evnt == EVENT_PLAYER_UNIT_DAMAGING
		EventListener.damagingId = eventTypeCounter
		EventListener.damagingHandleId = EVENT_PLAYER_UNIT_DAMAGING.getHandleId()
		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_DAMAGING, function EventListener.damagingCallback)
	else if evnt.isPlayerunitEvent()
		registerPlayerUnitEvent(ConvertPlayerUnitEvent(eventId), function EventListener.generalEventCallback)
	else if evnt != EVENT_PLAYER_LEAVE and evnt != EVENT_PLAYER_CHAT_FILTER and not evnt.isKeyboardEvent() and not evnt.isMouseEvent()
		error("registering handleid: " + eventId + " is not supported. Supported are playerunitevents, EVENT_UNIT_DAMAGED, EVENT_PLAYER_LEAVE, EVENT_PLAYER_CHAT_FILTER, arrow key, end cinematic and mouse events.")
	if evnt.isMouseEvent() and not EventListener.useMouseEvents
		EventListener.useMouseEvents = true
		for i = 0 to bj_MAX_PLAYERS - 1
			keyTrig..registerPlayerEvent(players[i], EVENT_PLAYER_MOUSE_UP)
			..registerPlayerEvent(players[i], EVENT_PLAYER_MOUSE_DOWN)
			..registerPlayerEvent(players[i], EVENT_PLAYER_MOUSE_MOVE)
	return eventTypeCounter

/** Destroys every listener registered for the unit. This does not depend on fireEvents: a unit whose events are
	not fired still holds listeners, which would answer to whichever unit is given its index next. */
public function unregisterEventsForUnit(unit u)
	let index = u.getIndex()
	OnCastListener.cancelPendingForUnit(u)
	unregisterEvents(index)
	if index > 0 and EventListener.castMapCasters[index] != null
		var listener = EventListener.castMapCasters[index]
		EventListener.castMapCasters[index] = null
		while listener != null
			let t = listener
			listener = listener.next
			destroy t

public function unregisterEvents(int id)
	if id > 0
		if EventListener.unitListenersFirsts[id] != null
			Log.trace("unregister unit has listeners. startid: " + id)
			var listener = EventListener.unitListenersFirsts[id]
			EventListener.unitListenersFirsts[id] = null
			while listener != null
				let t = listener
				listener = listener.next
				destroy t


init
	// Clean up per-unit listener lists when units are deindexed.
	onUnitDeindex(() -> unregisterEventsForUnit(getIndexingUnit()))

	nullTimer() ->
		OnCastListener.registerPendingCasts()
		leaveTrig.addAction(() -> EventListener.generalEventCallback())
		keyTrig.addAction(() -> EventListener.generalEventCallback())

		for i = 0 to bj_MAX_PLAYERS - 1
			leaveTrig.registerPlayerEvent(players[i], EVENT_PLAYER_LEAVE)
			keyTrig..registerPlayerEvent(players[i], EVENT_PLAYER_ARROW_DOWN_DOWN)
			..registerPlayerEvent(players[i], EVENT_PLAYER_ARROW_DOWN_UP)
			..registerPlayerEvent(players[i], EVENT_PLAYER_ARROW_UP_DOWN)
			..registerPlayerEvent(players[i], EVENT_PLAYER_ARROW_UP_UP)
			..registerPlayerEvent(players[i], EVENT_PLAYER_ARROW_LEFT_DOWN)
			..registerPlayerEvent(players[i], EVENT_PLAYER_ARROW_LEFT_UP)
			..registerPlayerEvent(players[i], EVENT_PLAYER_ARROW_RIGHT_DOWN)
			..registerPlayerEvent(players[i], EVENT_PLAYER_ARROW_RIGHT_UP)
			..registerPlayerEvent(players[i], EVENT_PLAYER_END_CINEMATIC)
			..registerPlayerChatEvent(players[i], "", false)

		registerPlayerUnitEvent(EVENT_PLAYER_UNIT_SPELL_EFFECT, null, () -> EventListener.onSpellEffect(), null)

