package ClosureKeyPresses
import HashMap
import KeyedMap

/*
    This package is a comfort wrapper around wc3 key presses events introduced in 1.31,
    for easy event listening via closures.

    Example usage:
        onKeyPress(OSKEY_A) ->
            print("A player pressed on the A key.")

        onKeyPress(OSKEY_B, OSKEY_META.SHIFT) ->
            print("A player pressed on the B key while holding a SHIFT key.")

        onKeyRelease(OSKEY_C) ->
            print("A player released the C key.")

        onKeyPress(players[0], OSKEY_D, OSKEY_META.ALT, false) ->
            print("Player 0 released the D key while holding an ALT key.")

    Important:
        * When the metakey NONE is passed or when no metaKey is given like in `onKeyPress(OSKEY_A, () -> print("A"))`,
          pressing or releasing the key will not fire an event while holding a metakey.
*/


/* CONSTANTS */

constant KEY_TRIGGER = CreateTrigger()..addAction(function onEvent)

// Key handle id -> the first listener of that key. A KeyedMap with an int key and a class-typed value,
// which the compiler lowers to a native table on Lua. It recognises these three functions by their
// annotation and their exact shape, so they must keep it; the bodies are what runs on Jass.
@compilerintrinsic function keyedMapPut(int map, int key, KeyPressListener value)
    (map castTo Table).saveInt(key, value castTo int)

@compilerintrinsic function keyedMapGet(int map, int key) returns KeyPressListener
    return (map castTo Table).loadInt(key) castTo KeyPressListener

@compilerintrinsic function keyedMapRemove(int map, int key)
    (map castTo Table).removeInt(key)

constant KEY_MAP = keyedMapCreate()

// The listener each dispatch in progress steps to next, in a slot the dispatch owns until it ends. Slots are not
// tied to a nesting depth: a listener may wait, and dispatches paused that way resume in any order.
KeyPressListener array keyCursor
bool array keyCursorUsed
int array freeKeyCursors
var freeKeyCursorCount = 0
// How many slots were ever handed out; the ones not in use are on freeKeyCursors.
var keyCursorSlots = 0

// Tracks which (player, key, metaKey, onKeyDown) combos are already registered on KEY_TRIGGER, so a
// second listener for the same combo does NOT register the event twice on one trigger (which fires the
// trigger, and therefore every matching listener, twice per key press). Keyed by key handle id, then by
// a small composite of player id + meta + up/down. Never cleared: WC3 has no per-event unregister, so
// "ever registered" equals "currently registered".
constant KEY_REGISTERED = new HashMap<int, HashMap<int, bool>>

function registerKeyOnce(player whichPlayer, oskeytype key, OSKEY_META metaKey, bool onKeyDown)
    let keyId = key.getHandleId()
    var combos = KEY_REGISTERED.get(keyId)
    if combos == null
        combos = new HashMap<int, bool>
        KEY_REGISTERED.put(keyId, combos)
    let combo = whichPlayer.getId() * 64 + metaKey.toInt() * 2 + (onKeyDown ? 1 : 0)
    if not combos.has(combo)
        combos.put(combo, true)
        KEY_TRIGGER.registerPlayerKeyPress(whichPlayer, key, metaKey, onKeyDown)


/* CLOSURES */

public function onKeyPress(oskeytype key, KeyPressListener listener) returns KeyPressListener
    return onKeyPress(key, OSKEY_META.NONE, true, listener)

public function onKeyPress(oskeytype key, OSKEY_META metaKey, KeyPressListener listener) returns KeyPressListener
    return onKeyPress(key, metaKey, true, listener)

public function onKeyRelease(oskeytype key, KeyPressListener listener) returns KeyPressListener
    return onKeyPress(key, OSKEY_META.NONE, false, listener)

public function onKeyPress(oskeytype key, OSKEY_META metaKey, bool onKeyDown, KeyPressListener listener) returns KeyPressListener
    for i = 0 to bj_MAX_PLAYERS - 1
        if players[i].isIngame()
            registerKeyOnce(players[i], key, metaKey, onKeyDown)
    return registerListener(listener, key, metaKey, onKeyDown, null)

public function onKeyPress(player whichPlayer, oskeytype key, KeyPressListener listener) returns KeyPressListener
    return onKeyPress(whichPlayer, key, OSKEY_META.NONE, true, listener)

public function onKeyPress(player whichPlayer, oskeytype key, OSKEY_META metaKey, KeyPressListener listener) returns KeyPressListener
    return onKeyPress(whichPlayer, key, metaKey, true, listener)

public function onKeyRelease(player whichPlayer, oskeytype key, KeyPressListener listener) returns KeyPressListener
    return onKeyPress(whichPlayer, key, OSKEY_META.NONE, false, listener)

public function onKeyPress(player whichPlayer, oskeytype key, OSKEY_META metaKey, bool onKeyDown, KeyPressListener listener) returns KeyPressListener
    registerKeyOnce(whichPlayer, key, metaKey, onKeyDown)
    return registerListener(listener, key, metaKey, onKeyDown, whichPlayer)

/** Puts the listener at the head of the key's list. A null player listens for every player. */
function registerListener(KeyPressListener listener, oskeytype key, OSKEY_META metaKey, bool onKeyDown, player whichPlayer) returns KeyPressListener
    listener.key = key
    listener.metaKey = metaKey.toInt()
    listener.onKeyDown = onKeyDown
    listener.whichPlayer = whichPlayer
    let id = key.getHandleId()
    let first = keyedMapGet(KEY_MAP, id)
    if first != null
        first.prev = listener
        listener.next = first
    keyedMapPut(KEY_MAP, id, listener)
    return listener


/* ON EVENT */

function onEvent()
    dispatchKey(GetTriggerPlayer(), BlzGetTriggerPlayerKey().getHandleId(), BlzGetTriggerPlayerMetaKey(), BlzGetTriggerPlayerIsKeyDown())

/** Runs the listeners of the key which match, newest first. A listener may destroy itself or any other listener: the
    successor is published in keyCursor before each call, and the destructor advances it when it is the one
    destroyed. There is one cursor per dispatch, as a listener may raise key events itself or wait. */
function dispatchKey(player triggerPlayer, int keyId, int metaKey, bool onKeyDown)
    var slot = keyCursorSlots
    if freeKeyCursorCount > 0
        freeKeyCursorCount--
        slot = freeKeyCursors[freeKeyCursorCount]
    else
        keyCursorSlots++
    keyCursorUsed[slot] = true
    var listener = keyedMapGet(KEY_MAP, keyId)
    while listener != null
        keyCursor[slot] = listener.next
        if listener.metaKey == metaKey and listener.onKeyDown == onKeyDown and (listener.whichPlayer == null or listener.whichPlayer == triggerPlayer)
            listener.onEvent()
        listener = keyCursor[slot]
    keyCursor[slot] = null
    keyCursorUsed[slot] = false
    freeKeyCursors[freeKeyCursorCount] = slot
    freeKeyCursorCount++


/* KEY PRESSES LISTENER */

public abstract class KeyPressListener
    oskeytype key
    int metaKey
    bool onKeyDown
    /** The player this listens for, or null for every player */
    player whichPlayer = null
    thistype next = null
    thistype prev = null

    abstract function onEvent()

    ondestroy
        for slot = 0 to keyCursorSlots - 1
            if keyCursorUsed[slot] and keyCursor[slot] == this
                keyCursor[slot] = next
        let id = key.getHandleId()
        let first = keyedMapGet(KEY_MAP, id)
        if first == this
            if next == null
                keyedMapRemove(KEY_MAP, id)
            else
                keyedMapPut(KEY_MAP, id, next)
        else if prev != null
            prev.next = next
        if next != null
            next.prev = prev
        next = null
        prev = null

    /** Links a listener to a key without registering the key event, for tests. */
    protected static function linkForTest(thistype listener, oskeytype key, player whichPlayer)
        registerListener(listener, key, OSKEY_META.NONE, true, whichPlayer)

    /** Runs the listeners of a key as a key-down without meta keys by the player does. For tests. */
    protected static function pressForTest(player triggerPlayer, oskeytype key)
        dispatchKey(triggerPlayer, key.getHandleId(), 0, true)
