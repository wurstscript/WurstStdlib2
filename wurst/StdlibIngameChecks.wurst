package StdlibIngameChecks

/*	How the in-game checks of the standard library report. The runner in StdlibIngameTests implements it and hands
	it to the packages which hold checks of their own, so they can be kept small and focused. */

public interface IngameChecks
	function check(bool passed, string label)
	function section(string label)
	function note(string label)
	/** A section which does not run its `checks` checks in this run, and why. The totals of a run say how many
		were skipped, so a rerun which runs fewer checks than the first can be told from one which lost some.
		A reporter which does not count them still hears of a skip as a note, so one written before this existed
		keeps compiling. */
	function skipped(int checks, string why)
		note("skipped " + checks + " checks: " + why)

/** Whether `actual` is `expected` as error() reports it. An optimised build replaces each error() message with a
	code E<n> and lists the messages in the build's errors.json, so there a code stands for the message. */
public function isErrorMessage(string actual, string expected) returns bool
	if actual == expected
		return true
	if actual.length() < 2 or actual.substring(0, 1) != "E"
		return false
	let num = actual.substring(1)
	return S2I(num) > 0 and I2S(S2I(num)) == num
