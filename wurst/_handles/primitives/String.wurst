package String
import NoWurst
import Integer
import Annotations
import Maths

@configurable public constant ENABLE_MULTIBYTE_SUPPORT = true

/**	A SubString slice that cuts a multibyte (non-latin) character in half does not
	contain valid data. On current game versions such invalid slices are collapsed
	to a marker string with a constant string hash. Since this behavior is
	undocumented and has changed between game versions, the marker hash is computed
	at runtime from a known 2-byte character, so a future engine change degrades
	gracefully (multibyte detection turns off) instead of corrupting data.
	The historically observed hash 1843378377 is kept as an additional fallback. */
public constant PARTIAL_CHAR_MARKER = "ä".substring(0, 1)
public constant PARTIAL_CHAR_HASH = PARTIAL_CHAR_MARKER.getHash()
constant LEGACY_PARTIAL_CHAR_HASH = 1843378377
/** False if slicing cannot produce invalid data on this game version
	(SubString returned the whole character for a partial slice). */
constant PARTIAL_CHAR_DETECTABLE = PARTIAL_CHAR_MARKER != "ä" and PARTIAL_CHAR_MARKER != ""

/** Returns true if this string is an invalid slice of a multibyte character.
	Only meaningful when ENABLE_MULTIBYTE_SUPPORT is enabled. */
public function string.isMultibytePartial() returns boolean
	if not PARTIAL_CHAR_DETECTABLE
		return false
	let hash = this.getHash()
	return hash == PARTIAL_CHAR_HASH or hash == LEGACY_PARTIAL_CHAR_HASH

/**	The partial char marker only applies to slices that start with the lead byte
	of a multibyte character. A slice starting with a continuation byte keeps a
	per-byte hash instead, so the marker alone cannot tell a continuation byte
	apart from an ascii byte. All 64 continuation byte values 0x80-0xBF occur as
	the second byte of the characters U+0400-U+043F, so slicing this literal
	yields every possible continuation byte, whose hashes we store in a table. */
constant CONT_BYTE_PROBE = "ЀЁЂЃЄЅІЇЈЉЊЋЌЍЎЏАБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдежзийклмноп"
constant CONT_BYTE_MAP = InitHashtable()
/**	Hash of a slice containing only the lead byte of a 4-byte character (emoji and
	other astral plane chars). Current game versions collapse these to the partial
	char marker like any other lead byte, making this equal to PARTIAL_CHAR_HASH.
	It is kept as a fallback for versions that hash them per byte instead. */
public constant LEAD4_HASH = "😀".substring(0, 1).getHash()

/** Returns true if this string can be split at the given position without
	cutting a multibyte character in half, i.e. the byte at the given position
	starts a new character instead of continuing a preceding one.
	Positions at or outside the string's bounds count as boundaries.
	Only meaningful when ENABLE_MULTIBYTE_SUPPORT is enabled. */
public function string.isCharBoundary(int pos) returns boolean
	if pos <= 0 or pos >= this.length()
		return true
	let slice = this.substring(pos, pos + 1)
	if slice.isMultibytePartial()
		// lead byte of a multibyte character, so it starts a new character
		return true
	// the remaining bytes are either ascii (a boundary) or continuation bytes (not)
	return not LoadBoolean(CONT_BYTE_MAP, 0, slice.getHash())

constant charset = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
constant numberset = "0123456789"
constant numbersetlength = numberset.length()
constant charsetlength = charset.length()

/**	Every printable ascii character, in code point order from space (32) to
	tilde (126). Used to give stringCompare a real lexicographic ordering
	without scanning `charset` once per character. */
constant PRINTABLE_ASCII = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
constant CHAR_ORDER_MAP = InitHashtable()
/**	Sort key for anything that is not a printable ascii byte (control bytes and
	the individual bytes of multibyte characters), placing them after all
	printable ascii characters. */
constant UNKNOWN_CHAR_ORDER = 256

/**	Ascii sort keys for stringCompare. StringHash is case insensitive, so 'a'
	and 'A' share a key - only the uppercase form is stored and the lowercase
	code point is recovered at lookup time (same trick as StringUtils.char).

	Marked @compiletime as well as being called from init, because init blocks
	do not run in the compiletime interpreter and @Test/@compiletime code needs
	the table too. The literal is pure ascii, so it behaves identically in the
	interpreter's utf-16 strings and in the game's byte strings. */
@compiletime function initCharOrder()
	for i = 0 to PRINTABLE_ASCII.length() - 1
		let c = PRINTABLE_ASCII.substring(i, i + 1)
		if c == StringCase(c, true)
			SaveInteger(CHAR_ORDER_MAP, 0, c.getHash(), i + 32)

init
	initCharOrder()
	// Every continuation byte 0x80-0xBF, so isCharBoundary can recognise them.
	// Runtime only: this slices a multibyte literal by byte offset, which the
	// compiletime interpreter cannot reproduce (its strings are utf-16, so the
	// probe is 64 characters there rather than 128 bytes).
	for i = 0 to 63
		SaveBoolean(CONT_BYTE_MAP, 0, CONT_BYTE_PROBE.substring(i * 2 + 1, i * 2 + 2).getHash(), true)

/** Sort key of a single byte: its ascii code, or UNKNOWN_CHAR_ORDER if it is
	not printable ascii. */
function charOrder(string c) returns int
	let stored = LoadInteger(CHAR_ORDER_MAP, 0, c.getHash())
	if stored == 0
		return UNKNOWN_CHAR_ORDER
	// a letter that differs from its own uppercase form is the lowercase one,
	// which sits 32 code points above the stored uppercase entry
	return c == StringCase(c, true) ? stored : stored + 32

/** Returns true if this string is non-null and
	not empty or only consisting of whitespace. */
public function string.isNotBlank() returns boolean
	return this != null and this.trim().length() > 0

/** returns the position of the char in the charset
	therefore converting a single char into an int that can
	be converted back to a char with .toCharsetString() */
public function string.toCharsetInt() returns int
	if this.length() > 1
		return -1
	else
		for i = 0 to charsetlength - 1
			if charset.substring(i, i + 1) == this
				return i
		return -1

/** Creates a real from a string that only contains numbers (0-9) and a sign */
public function string.toReal() returns real
	return S2R(this)

/** Creates an int from a string that only contains numbers (0-9) and a sign */
public function string.toInt() returns int
	return S2I(this)

/** Converts an int to the representative char */
public function int.toCharsetString() returns string
	return charset.substring(this, this + 1)

/** returns a substring specified by end and start position.
	Positions are byte offsets, so slicing a string containing multibyte
	(non-latin) characters can cut one in half. See string.isCharBoundary. */
public function string.substring(int start, int stop) returns string
	return SubString(this, start, stop)

/** returns a substring specified by end and start position.
	Positions are byte offsets, see string.substring(int, int). */
public function string.substring(int start) returns string
	return SubString(this, start, this.length())

/** Length of the string in bytes. Multibyte (non-latin) characters count as
	2-4 bytes each, so this is not the number of characters. Iterate the string
	to count those, e.g. `for c in s`. */
public function string.length() returns int
	return StringLength(this)

/** Returns the byte at the given position. 0 = first byte.
	This only returns a whole character for single byte (latin) characters,
	iterate the string instead to read multibyte characters. */
public function string.charAt(int index) returns string
	return SubString(this, index, index + 1)

/**	Converts a string to an ability id */
public function string.toAbilityId() returns int
	return AbilityId(this)

/**	Returns if the given string ends with the specified string.	*/
public function string.endsWith(string s) returns boolean
	if s == ""
		return true
	let len = this.length()
	if s.length() > len
		return false
	return this.substring(len - s.length(), len) == s

/**	Returns if the given string starts with the specified string.	*/
public function string.startsWith(string s) returns boolean
	let len = this.length()
	if s.length() > len
		return false
	return this.substring(0, s.length()) == s

/** Returns the string in lowercase letters */
public function string.toLowerCase() returns string
	return StringCase(this, false)

/** Returns the string in uppercase letters */
public function string.toUpperCase() returns string
	return StringCase(this, true)

/** True when string contains only uppercase letters */
public function string.isUpper() returns boolean
	return this == StringCase(this, true)

/** True when string contains only lowercase letters */
public function string.isLower() returns boolean
	return this == StringCase(this, false)

/** Returns the given string with whitespace (" ", \n, \t, \r) removed from both ends */
public function string.trim() returns string
	var i = 0
	var j = this.length()
	while i != j and this.charAt(i).isWhitespace()
		i++
	while i != j and this.charAt(j - 1).isWhitespace()
		j--
	return this.substring(i, j)

/** Returns the given string with whitespace (" ", \n, \t, \r) removed from the left end */
public function string.ltrim() returns string
	var i = 0
	let length = this.length()
	while i < length and this.charAt(i).isWhitespace()
		i++
	return this.substring(i, length)

/** Returns the given string with whitespace (" ", \n, \t, \r) removed from the right end */
public function string.rtrim() returns string
	var j = this.length()
	while j != 0 and this.charAt(j - 1).isWhitespace()
		j--
	return this.substring(0, j)

/** Removes a string from the beginning of another string */
public function string.ltrim(string val) returns string
	if this.startsWith(val)
		return this.substring(val.length(), this.length()).ltrim(val)
	else
		return this

/** Removes a string from the end of another string */
public function string.rtrim(string val) returns string
	if this.endsWith(val)
		return this.substring(0, this.length() - val.length()).rtrim(val)
	else
		return this

/** Removes a string from both ends of another string */
public function string.trim(string val) returns string
	return this.ltrim(val).rtrim(val)

/**
	Returns the index of the specified string inside the given string.
	If the string does not exist, the returnvalue is -1
*/
public function string.indexOf(string s) returns int
	let len = s.length()
	for int i = 0 to this.length() - len
		if this.substring(i, i + len) == s
			return i
	return -1

/**
	Returns the index of the specified string inside the given string,
	starting the search at given startposition.
	If the string does not exist, the returnvalue is -1
*/
public function string.indexOf(string s, int startpos) returns int
	for int i = startpos to this.length() - s.length()
		if this.substring(i, i + s.length()) == s
			return i
	return -1

/**
	Returns the last index of the specified string inside the given string,
	If the string does not exist, the returnvalue is -1
*/
public function string.lastIndexOf(string s) returns int
	for int i = this.length() - s.length() downto 0
		if this.substring(i, i + s.length()) == s
			return i
	return -1

/** Returns the occurences of a certain string within a string */
public function string.countOccurences(string findStr) returns int
	int lastIndex = 0
	int count = 0
	while lastIndex != -1
		lastIndex = this.indexOf(findStr, lastIndex)

		if lastIndex != -1
			count++
			lastIndex += findStr.length()
	return count

/** True if the string contains the given string */
public function string.contains(string s) returns boolean
	return this.indexOf(s) != -1

/** Returns if the given string is a whitespace (" ",\n,\t,\r) */
public function string.isWhitespace() returns boolean
	return this == " " or this == "\n" or this == "\t" or this == "\r"

/** Returns a new string with first letter is upper */
public function string.firstUpper() returns string
	if this == ""
		return ""
	return StringCase(this.substring(0, 1), true) + this.substring(1, this.length())

/** Returns a new string with first letter is lower */
public function string.firstLower() returns string
	if this == ""
		return ""
	return StringCase(this.substring(0, 1), false) + this.substring(1, this.length())

/** Returns a new string in which all occurrences of a specified string in the current instance are replaced with another specified string */
public function string.replace(string oldSubstring, string newSubstring) returns string
	var s = this
	if oldSubstring.length() > 0
		int i = this.indexOf(oldSubstring)
		while (i != -1)
			s = s.substring(0, i) + newSubstring + s.substring(i + oldSubstring.length(), s.length())
			i = s.indexOf(oldSubstring, i + newSubstring.length())
	return s

/**	Returns a negative number if s1 sorts before s2, a positive number if it
	sorts after, and 0 only if the two strings are equal.

	Ordering is by ascii code point, so digits sort before uppercase letters,
	which sort before lowercase letters. Bytes outside printable ascii - control
	characters and the individual bytes of multibyte characters - all sort after
	printable ascii, ordered by string hash so the result stays consistent. */
public function stringCompare(string s1, string s2) returns int
	let s1Len = s1.length()
	let s2Len = s2.length()
	let shared = min(s1Len, s2Len)
	for int i = 0 to shared - 1
		let c1 = s1.charAt(i)
		let c2 = s2.charAt(i)
		if c1 != c2
			let o1 = charOrder(c1)
			let o2 = charOrder(c2)
			if o1 != o2
				return o1 < o2 ? -1 : 1
			let h1 = c1.getHash()
			let h2 = c2.getHash()
			if h1 != h2
				// two distinct non-ascii bytes: stable hash tie-break
				return h1 < h2 ? -1 : 1
			// nothing left to distinguish them by, treat as equal and move on
			skip

	if s1Len < s2Len
		return -1
	else if s1Len > s2Len
		return 1
	return 0

public function string.getHash() returns int
	return StringHash(this)

/** Formats the given string replacing {x} delimiters with the passed replacements.
	Example: "You got {0} gold".format(goldAmount) **/
public function string.format(vararg string replacements) returns string
	var result = this
	var i = 0
	for replacement in replacements
		result = result.replace("{" + i.toString() + "}", replacement)
		i++
	return result

/** Iterates the string one character at a time. With ENABLE_MULTIBYTE_SUPPORT
	this yields whole multibyte (non-latin) characters, otherwise single bytes. */
public function string.iterator() returns StringIterator
	return new StringIterator(this, 0, this.length())

public class StringIterator
	string s
	int currentpos
	int stringLen

	construct(string s, int currentpos, int stringLen)
		this.s = s
		this.currentpos = currentpos
		this.stringLen = stringLen

	function hasNext() returns boolean
		return currentpos < stringLen

	function next() returns string
		var val = s.substring(currentpos, currentpos + 1)
		var width = 1
		if ENABLE_MULTIBYTE_SUPPORT and PARTIAL_CHAR_DETECTABLE
			let hash = val.getHash()
			if LEAD4_HASH != PARTIAL_CHAR_HASH and hash == LEAD4_HASH
				// only on versions that do not collapse 4-byte lead bytes to the marker
				width = 4
				val = s.substring(currentpos, currentpos + width)
			else if hash == PARTIAL_CHAR_HASH or hash == LEGACY_PARTIAL_CHAR_HASH
				// A multibyte character is 2-4 bytes long - widen the slice until it is valid
				width = 2
				val = s.substring(currentpos, currentpos + width)
				while width < 4 and currentpos + width < stringLen and val.isMultibytePartial()
					width++
					val = s.substring(currentpos, currentpos + width)
		currentpos += width
		return val

	function close()
		destroy this


public class StringLines
	string s
	int currentLine = 0
	int lineCount
	int lastIndex

	construct(string s, int lastIndex, int lineCount)
		this.s = s
		this.lineCount = lineCount
		this.lastIndex = lastIndex

	@deprecated("class deprecated")
	function iterator() returns thistype
		return this

	@deprecated("class deprecated")
	function hasNext() returns boolean
		return currentLine < lineCount

	@deprecated("class deprecated")
	function next() returns string
		let idx = this.lastIndex
		this.lastIndex = this.s.indexOf("\n", idx) + 1
		currentLine++
		return this.s.substring(idx, this.lastIndex)

	@deprecated("class deprecated")
	function close()
		destroy this


/** Returns a StringLines Object of the given string for iteration */
@deprecated("Use string.split(\n) instead")
public function string.toLines() returns StringLines
	return new StringLines(this, 0, this.countOccurences("\n") + 1)


