package ForceTests
import NoWurst
import Execute
import Wurstunit
import Force

@Test
function testForce()
	let f = CreateForce()

	assertTrue(f != null)

	f.addPlayer(Player(0))

	f.containsPlayer(Player(0)).assertTrue()

var testInt = 0

@Test
function testForForce()
	testInt = 0
	execute() ->
		testInt.assertEquals(0)
		testInt = 10

	testInt.assertEquals(10)

@Test
function forceIteratesInPlayerIdOrder()
	let f = CreateForce()
	f.addPlayer(Player(5))
	f.addPlayer(Player(1))
	f.addPlayer(Player(3))
	var visited = ""
	for p in f
		visited += I2S(GetPlayerId(p)) + ","
	visited.assertEquals("1,3,5,")
	f.containsPlayer(Player(1)).assertTrue()
	DestroyForce(f)
