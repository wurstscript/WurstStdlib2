package FileIO
import public ChunkedString
import ErrorHandling
import SafetyChecks
import AbilityObjEditing
import ObjectIds

/* 	FileIO for Patches 1.31 and up with chunked string support for big data.
	Reads and writes using preload files by manipulating default ability tooltips.

	Read a file:
	>	let fileContent = new File("MyFileName.pld").readAsString(localPlayer)

	Write a file:
	>	new File("MyFileName.pld")..write(localPlayer, "MyContent")..close()

	DESYNC WARNING
	==============
	File contents live on one player's disk, so read() and readAsString() only
	return data on that player's machine and return an empty result everywhere
	else. The returned value is therefore *not* synchronised.

	Never branch game state on it directly:

	>	// DESYNCS: only one player takes this branch
	>	if new File("save.pld").readAsString(localPlayer) == "unlocked"
	>		unlockHero()

	Send the value through a sync layer first (see package SyncSimple), and act
	only on the synchronised copy.

	Writing has no such issue as long as every player writes the same content.
*/

@configurable public constant CHUNKS_PER_FILE = 64
@configurable public constant FILE_IO_ABIL_ID = '$wsl'

public var CAN_READ_FILES = true

public constant FILE_IO_ABIL_ID_STR = FILE_IO_ABIL_ID.toRawCode()

public class File
	var filename = ""

	construct(string filename)
		this.filename = filename

	function write(player p, string content)
		let buffer = new ChunkedString()
		buffer.append(content)
		write(p, buffer)
		destroy buffer

	function write(player p, ChunkedString buffer)
		if SAFETY_CHECKS_ENABLED
			for i = 0 to buffer.getChunkCount() - 1
				let str = buffer.getChunk(i)
				if validateInput(str) != null
					error("FileIO(" + filename + ") ERROR: Invalid character |cffffcc00" + validateInput(str) + "|r")

		writePreload(p, buffer)

	function close()
		destroy this

	/** Reads the file's contents. Only the given player actually reads from
		disk; every other client gets an empty ChunkedString, so the result is
		not synchronised - see the desync warning at the top of this package. */
	function read(player p) returns ChunkedString
		let out = new ChunkedString(DEFAULT_CHUNK_SIZE)
		if localPlayer == p
			readPreload(out)
		return out

	/** Reads the file's contents as one string. Not synchronised - see read(). */
	function readAsString(player p) returns string
		let out = read(p)
		let str = out.getUnsafeString()
		destroy out
		return str

	private function writePreload(player p, ChunkedString buffer)
		if localPlayer == p
			PreloadGenClear()
			PreloadGenStart()

			if buffer.getChunkCount() >= CHUNKS_PER_FILE
				error("FileIO(" + filename + ") ERROR: String's chunk count exceeds the limit (" + CHUNKS_PER_FILE + ").|r")

			for i = 0 to buffer.getChunkCount() - 1
				let chunk = buffer.getChunk(i)
				Preload("\" )\ncall BlzSetAbilityTooltip('" + FILE_IO_ABIL_ID_STR + "', \"" + chunk + "\", " + i + ")\n//")

			Preload("\" )\nendfunction\nfunction a takes nothing returns nothing\n //")
			PreloadGenEnd(this.filename)

	private function readPreload(ChunkedString output)
		Preloader(this.filename)

		// Read the output
		for i = 0 to CHUNKS_PER_FILE - 1
			let chunk = BlzGetAbilityTooltip(FILE_IO_ABIL_ID, i)

			if chunk == " "
				break

			BlzSetAbilityTooltip(FILE_IO_ABIL_ID, " ", i)
			output.append(chunk)


	/** Returns the first character that cannot be embedded in a preload line,
		or null if the content is safe.
		Backslash and quote would escape the generated string literal;
		newlines and carriage returns would break out of the line entirely. */
	private static function validateInput(string content) returns string
		for char in content
			if char == "\\" or char == "\"" or char == "\n" or char == "\r"
				return char
		return null

init
	let tester = new File("FileTester.pld")
	tester.write(localPlayer, "test")
	CAN_READ_FILES = tester.readAsString(localPlayer) == "test"
	destroy tester


@compiletime function generateDummy()
	let dummy = new AbilityDefinitionIllidanChannel(FILE_IO_ABIL_ID)
		..setLevels(CHUNKS_PER_FILE)

	for i = 1 to CHUNKS_PER_FILE
		dummy.setTooltipNormal(i, " ")

